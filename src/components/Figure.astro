---
// A figure for Journal diagrams that renders well in both light and dark mode.
// Three modes (pick whichever fits the graphic), all with an optional caption:
//
// 1) Adaptive SVG — one SVG whose strokes/text use `currentColor`, so it inherits
//    the page text color and flips with the theme automatically. Best for line-art
//    physics diagrams. Pass the SVG markup as a raw import:
//      import diagram from '/src/assets/diagrams/diagram.svg?raw';
//      <Figure svg={diagram} caption="..." />
//
// 2) Light/dark image pair — two exports, swapped by theme. Best for richly
//    colored graphics. Use /public paths:
//      <Figure light="/journal/fig-light.png" dark="/journal/fig-dark.png" caption="..." />
//
// 3) Single image on a card — one export with its own neutral panel + border:
//      <Figure src="/journal/fig.png" caption="..." />
//
// `width` (px) optionally caps the figure width; otherwise it fills the column.
//
// `caption` supports inline formatting via src/utils/inlineText.ts:
//   $\phi$   → inline KaTeX      ~~text~~ → strikethrough
// e.g. caption="Displacing the cup by $\boldsymbol{a}$ carries $\phi$ to $\phi'$."
// Inline math only — put display equations in the post body, not a caption.
// A plain double-quoted string is fine in .mdx: backslashes in a JSX string
// attribute are literal, so caption="... $\phi$ ..." reaches KaTeX intact.

import { renderInline } from '../utils/inlineText';
import { url } from '../utils/paths';

interface Props {
  svg?: string;       // raw SVG markup (mode 1)
  light?: string;     // light-mode image path (mode 2)
  dark?: string;      // dark-mode image path (mode 2)
  src?: string;       // single image path (mode 3)
  alt?: string;
  caption?: string;
  width?: number;     // max width in px
}

const { svg, light, dark, src, alt = '', caption, width } = Astro.props;

// Strip an XML prolog if a raw SVG was pasted with one.
const svgMarkup = svg ? svg.replace(/<\?xml[^>]*>\s*/, '') : undefined;
const figureStyle = width ? `max-width:${width}px` : undefined;

// `caption` is a component prop, so it never passes through the Markdown
// pipeline — remark-math never sees it and `$\phi$` would render literally.
// renderInline is the repo's helper for exactly these bypass-the-pipeline
// strings: it KaTeX-renders inline $...$, applies ~~strike~~, and escapes
// everything else (the previous `set:html={caption}` passed the raw string
// through unescaped, so a stray `<` or `&` broke the markup).
// Inline math only — display $$...$$ is intentionally unsupported here.
const captionHtml = caption ? renderInline(caption, { math: true }) : undefined;
---

<figure class="figure" style={figureStyle}>
  {svgMarkup ? (
    <div class="figure__svg" role="img" aria-label={alt} set:html={svgMarkup} />
  ) : light && dark ? (
    <>
      <img class="figure__img figure__img--light" src={url(light)} alt={alt} loading="lazy" decoding="async" />
      <img class="figure__img figure__img--dark" src={url(dark)} alt={alt} loading="lazy" decoding="async" />
    </>
  ) : src ? (
    <img class="figure__img figure__img--card" src={url(src)} alt={alt} loading="lazy" decoding="async" />
  ) : null}

  {captionHtml && <figcaption class="figure__caption" set:html={captionHtml} />}
</figure>

<!-- Styles live in src/styles/global.css (.figure*), not here: the same rules
     serve BOTH this component and the `> [!figure]` callout that
     remark-callout-components compiles from .md posts. One definition, so the
     two renderings cannot drift while both paths coexist. -->
