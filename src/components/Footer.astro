---
const today = new Date();
import { SITE_TAGLINE, SITE_TITLE, SOCIAL_LINKS } from "../consts";
import Search from "./Search.astro";
import ParticleField from "./ParticleField.astro";
import { url } from "../utils/paths";
---

<footer class="site-footer">
  <ParticleField count={30} opacity={0.18} />
  <div class="footer-inner">
    <div class="footer-id">
      <div class="footer-name">{SITE_TITLE}</div>
      <p class="footer-quote">{SITE_TAGLINE}</p>
    </div>
    <div class="footer-side">
      <nav class="footer-nav" aria-label="Footer">
        <a href={url("/")}>Home</a>
        <a href={url("/about")}>About</a>
        <a href={url("/research")}>Research</a>
        <a href={url("/projects")}>Projects</a>
        <a href={url("/journal")}>Journal</a>
        {/* No CV link here — the homepage's "Get in touch" section (and the
            header icon) own that ask; repeating it inches from the section
            blunted it (2026-07 design audit). */}
      </nav>
      <div class="footer-contact">
        {/* Email lives in the icon row (SOCIAL_LINKS includes an email icon) —
            a text address alongside it was redundant. */}
        <div class="social-links">
          {
            SOCIAL_LINKS.map((link) => (
              <a
                href={link.href}
                target={link.href.startsWith("mailto:") ? undefined : "_blank"}
                rel={
                  link.href.startsWith("mailto:")
                    ? undefined
                    : "noopener noreferrer"
                }
                aria-label={link.label}
              >
                {link.icon === "scholar" && (
                  <svg
                    fill="currentColor"
                    viewBox="0 0 32 32"
                    width="24"
                    height="24"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path d="M14.573 2.729c-0.729 0.484-4.292 2.849-7.917 5.255s-6.589 4.396-6.589 4.422c0 0.026 0.182 0.146 0.406 0.266 0.224 0.13 3.797 2.109 7.953 4.411l7.542 4.193 0.193-0.099c0.109-0.052 2.891-1.641 6.188-3.521l5.99-3.427 0.036 10.599h3.557v-12.401l-4.615-3.094c-6.219-4.167-11.188-7.448-11.307-7.474-0.063-0.010-0.703 0.38-1.438 0.87zM7.141 22.177l0.016 2.672 8.828 5.292 8.891-5.339v-2.641c0-1.458-0.016-2.646-0.031-2.646-0.021 0-1.76 1.042-3.87 2.323l-4.406 2.661-0.578 0.339-1.755-1.052c-1.464-0.875-2.927-1.755-4.385-2.641l-2.672-1.615c-0.031-0.010-0.042 1.177-0.036 2.646z" />
                  </svg>
                )}
                {link.icon === "email" && (
                  <svg
                    viewBox="0 0 24 24"
                    width="24"
                    height="24"
                    stroke="currentColor"
                    stroke-width="2"
                    fill="none"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                    <polyline points="22,6 12,13 2,6" />
                  </svg>
                )}
                {link.icon === "website" && (
                  <svg
                    viewBox="0 0 24 24"
                    width="24"
                    height="24"
                    stroke="currentColor"
                    stroke-width="2"
                    fill="none"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <circle cx="12" cy="12" r="10" />
                    <line x1="2" y1="12" x2="22" y2="12" />
                    <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                  </svg>
                )}
                {link.icon === "github" && (
                  <svg
                    viewBox="0 0 24 24"
                    width="24"
                    height="24"
                    stroke="currentColor"
                    stroke-width="2"
                    fill="none"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
                  </svg>
                )}
                {link.icon === "linkedin" && (
                  <svg
                    viewBox="0 0 24 24"
                    width="24"
                    height="24"
                    stroke="currentColor"
                    stroke-width="2"
                    fill="none"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
                    <rect x="2" y="9" width="4" height="12" />
                    <circle cx="4" cy="4" r="2" />
                  </svg>
                )}
                {link.icon === "twitter" && (
                  <svg
                    viewBox="0 0 24 24"
                    width="24"
                    height="24"
                    stroke="currentColor"
                    stroke-width="2"
                    fill="none"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z" />
                  </svg>
                )}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>
  <div class="footer-bottom">
    &copy; {today.getFullYear()}
    {SITE_TITLE}. All rights reserved.
  </div>
</footer>

<Search />

<dialog id="author-modal" class="author-modal">
  <button id="close-modal" class="close-btn" aria-label="Close modal"
    >&times;</button
  >
  <div class="modal-flex">
    <img id="modal-avatar" src="" alt="Avatar" class="modal-avatar" />
    <div>
      <h3 id="modal-name"></h3>
      <span id="modal-title"></span>
      <span id="modal-role"></span>
    </div>
  </div>
  <p id="modal-bio"></p>
  <div id="modal-socials"></div>
</dialog>

<script>
  const avatarPalette = [
    { bg: "#DCEBFF", fg: "#1D4ED8" },
    { bg: "#DFF7E2", fg: "#166534" },
    { bg: "#FDE7D8", fg: "#C2410C" },
    { bg: "#F5E3FF", fg: "#7E22CE" },
    { bg: "#FFE3E3", fg: "#BE123C" },
    { bg: "#E3F7F5", fg: "#0F766E" },
  ];

  type Member = {
    name: string;
    title?: string;
    role?: string;
    bio?: string;
    avatar?: string;
    website?: string;
    github?: string;
    linkedin?: string;
    google_scholar?: string;
    email?: string;
  };

  const getInitials = (name: string) => {
    const parts = (name || "")
      .split(/\s+/)
      .map((part: string) => part.replace(/[^A-Za-z]/g, ""))
      .filter(Boolean);

    if (parts.length === 0) return "NA";
    if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();
    return `${parts[0][0]}${parts[parts.length - 1][0]}`.toUpperCase();
  };

  const generateFallbackAvatar = (name: string) => {
    const safeName = name || "Unknown";
    const initials = getInitials(safeName);
    const seed = Array.from(safeName).reduce(
      (sum: number, char: string) => sum + char.charCodeAt(0),
      0,
    );
    const palette = avatarPalette[seed % avatarPalette.length];
    const svg = `
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" role="img" aria-label="${safeName}">
                <rect width="200" height="200" rx="100" fill="${palette.bg}" />
                <text x="50%" y="50%" dominant-baseline="central" text-anchor="middle" font-family="Atkinson, Arial, sans-serif" font-size="76" font-weight="700" letter-spacing="2" fill="${palette.fg}">${initials}</text>
            </svg>
        `.trim();

    return `data:image/svg+xml;charset=UTF-8,${encodeURIComponent(svg)}`;
  };

  let authorModalAbort: AbortController | undefined;

  const initModals = () => {
    if (authorModalAbort) authorModalAbort.abort();
    authorModalAbort = new AbortController();
    const { signal } = authorModalAbort;
    const modal = document.getElementById(
      "author-modal",
    ) as HTMLDialogElement | null;
    const closeBtn = document.getElementById("close-modal");
    const modalAvatar = document.getElementById(
      "modal-avatar",
    ) as HTMLImageElement | null;
    const modalName = document.getElementById("modal-name");
    const modalTitle = document.getElementById("modal-title");
    const modalRole = document.getElementById("modal-role");
    const modalBio = document.getElementById("modal-bio");
    const modalSocials = document.getElementById("modal-socials");

    if (!modal) return;

    const triggers = document.querySelectorAll(".author-modal-trigger");
    triggers.forEach((card) => {
      card.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();

        const dataRaw = card.getAttribute("data-member");
        if (!dataRaw) return;
        const member = JSON.parse(dataRaw) as Member;

        if (modalName) modalName.textContent = member.name;
        if (modalTitle) modalTitle.textContent = member.title || "";
        if (modalRole) modalRole.textContent = member.role || "";
        if (modalBio)
          modalBio.textContent = member.bio || "No description available.";

        if (modalAvatar) {
          const fallbackAvatar = generateFallbackAvatar(member.name);
          modalAvatar.onerror = () => {
            modalAvatar.onerror = null;
            modalAvatar.src = fallbackAvatar;
          };
          modalAvatar.src = member.avatar || fallbackAvatar;
          modalAvatar.style.display = "block";
        }

        // Build the social links via the DOM API rather than an innerHTML
        // string. member.* values come from authors.json today, but constructing
        // anchors with element.href = value (a) auto-escapes and (b) lets us
        // reject non-http(s)/mailto schemes — so a future/edited entry containing
        // e.g. `javascript:...` or an attribute-breakout string can't inject
        // script. The SVG icon markup is static and trusted, so it stays inline.
        const ICONS: Record<string, string> = {
          website: `<svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>`,
          github: `<svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>`,
          linkedin: `<svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>`,
          google_scholar: `<svg fill="currentColor" viewBox="0 0 32 32" width="20" height="20" xmlns="http://www.w3.org/2000/svg"><path d="M14.573 2.729c-0.729 0.484-4.292 2.849-7.917 5.255s-6.589 4.396-6.589 4.422c0 0.026 0.182 0.146 0.406 0.266 0.224 0.13 3.797 2.109 7.953 4.411l7.542 4.193 0.193-0.099c0.109-0.052 2.891-1.641 6.188-3.521l5.99-3.427 0.036 10.599h3.557v-12.401l-4.615-3.094c-6.219-4.167-11.188-7.448-11.307-7.474-0.063-0.010-0.703 0.38-1.438 0.87zM7.141 22.177l0.016 2.672 8.828 5.292 8.891-5.339v-2.641c0-1.458-0.016-2.646-0.031-2.646-0.021 0-1.76 1.042-3.87 2.323l-4.406 2.661-0.578 0.339-1.755-1.052c-1.464-0.875-2.927-1.755-4.385-2.641l-2.672-1.615c-0.031-0.010-0.042 1.177-0.036 2.646z"></path></svg>`,
          email: `<svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>`,
        };

        // Allow only web + mail links. Returns the normalized href, or null if
        // the value doesn't parse or uses a disallowed scheme.
        const safeHref = (raw: string, kind: "web" | "mail") => {
          try {
            const href = kind === "mail" ? `mailto:${raw}` : raw;
            const proto = new URL(href).protocol;
            const ok =
              kind === "mail" ? proto === "mailto:" : proto === "http:" || proto === "https:";
            return ok ? href : null;
          } catch {
            return null;
          }
        };

        const makeLink = (
          href: string,
          label: string,
          iconKey: string,
        ) => {
          const a = document.createElement("a");
          a.href = href; // property assignment auto-escapes
          a.setAttribute("aria-label", label);
          a.className = "social-icon-btn";
          if (!href.startsWith("mailto:")) {
            a.target = "_blank";
            a.rel = "noopener noreferrer";
          }
          a.innerHTML = ICONS[iconKey]; // static, trusted icon markup only
          return a;
        };

        if (modalSocials) {
          modalSocials.replaceChildren();
          const links: Array<[string | undefined, "web" | "mail", string, string]> = [
            [member.website, "web", "Website", "website"],
            [member.github, "web", "GitHub", "github"],
            [member.linkedin, "web", "LinkedIn", "linkedin"],
            [member.google_scholar, "web", "Google Scholar", "google_scholar"],
            [member.email, "mail", "Email", "email"],
          ];
          for (const [value, kind, label, iconKey] of links) {
            if (!value) continue;
            const href = safeHref(value, kind);
            if (href) modalSocials.appendChild(makeLink(href, label, iconKey));
          }
        }

        document.body.style.overflow = "hidden";
        if (modal) modal.showModal();
      }, { signal });
    });

    modal?.addEventListener("close", () => {
      document.body.style.overflow = "";
    }, { signal });

    closeBtn?.addEventListener("click", () => {
      modal?.close();
    }, { signal });

    modal?.addEventListener("click", (e) => {
      const dialogDimensions = modal.getBoundingClientRect();
      if (
        e.clientX < dialogDimensions.left ||
        e.clientX > dialogDimensions.right ||
        e.clientY < dialogDimensions.top ||
        e.clientY > dialogDimensions.bottom
      ) {
        modal.close();
      }
    }, { signal });
  };

  initModals();
  document.addEventListener("astro:page-load", initModals);
</script>

<style>
  .site-footer {
    position: relative;
    background: var(--color-bg);
    color: var(--color-text-main);
    overflow: hidden;
  }
  /* Soft separator (restored from the pre-redesign footer): an edge-fading
     gradient hairline rather than a solid full-width line. */
  .site-footer::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      var(--color-border) 20%,
      var(--color-border) 80%,
      transparent 100%
    );
    opacity: 0.6;
  }
  /* Two columns, and they stop being two at ONE declared width (see the
     --footer-stack breakpoint below). It used to be `flex-wrap: wrap` deciding
     that implicitly from content width while a `max-width: 640px` query decided
     the accompanying styling — two mechanisms answering the same question, and
     they disagreed: the row actually wrapped at 757px, so from 641-757px the
     footer stood in one column while still wearing its two-column dress (side
     block right-aligned against a left-aligned name, "·" separators kept for a
     nav row that was no longer beside anything). Driving both from the query
     means the layout and its styling cannot drift apart again. */
  .footer-inner {
    position: relative;
    z-index: 1;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 2.5rem 1rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2rem;
  }
  .footer-name {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--color-text-main);
  }
  .footer-quote {
    margin: 0.4rem 0 0;
    max-width: 22rem;
    font-size: 0.85rem;
    font-style: italic;
    color: var(--color-text-muted);
  }
  .footer-side {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.9rem;
  }
  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0;
  }
  .footer-nav a {
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
    transition: color 0.2s;
  }
  .footer-nav a:hover {
    color: var(--color-accent);
  }
  /* Dot separators between nav links (not after the last). The alt-text
     syntax keeps the dot out of the link's accessible name ("About", not
     "·About") in browsers that support it. */
  .footer-nav a + a::before {
    content: "·" / "";
    margin: 0 0.6rem;
    color: var(--color-border);
  }
  .footer-contact {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .footer-bottom {
    position: relative;
    z-index: 1;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 1rem 1.75rem;
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }
  .social-links {
    display: flex;
    gap: 1rem;
  }
  .social-links a {
    color: var(--color-text-muted);
    transition: color 0.2s;
  }
  .social-links a:hover {
    color: var(--color-accent);
  }

  /* 760px, just above the 758px at which the two columns stopped fitting side by
     side. Everything that distinguishes the stacked footer from the side-by-side
     one lives in here, so there is exactly one number to change if the name, the
     quote or the nav ever grow. */
  @media (max-width: 760px) {
    /* Stacked, `gap` stops being the space BETWEEN TWO COLUMNS and becomes the
       space between the identity block and the nav — a different quantity that
       happens to share a property name. 2rem side-by-side is generous; the same
       value stacked put 24px between the quote and the nav, 14px between the nav
       and the icons, and 24px before the copyright, so identity, navigation and
       legal all ran together as one undifferentiated slab while ~100px of empty
       space sat above them. Stacked spacing is set on its own terms here. */
    .footer-inner {
      flex-direction: column;
      gap: 2.75rem;
      /* Centered once stacked. Side by side, the two columns anchor to opposite
         edges and the left one shares the page's text edge, so left alignment is
         what makes them read as a pair. Stacked there is no pair — just four
         short blocks in a column, and hanging them off the left edge left the
         social icons in particular looking dropped rather than placed. Centered,
         the four read as one sign-off. */
      align-items: center;
      text-align: center;
    }
    /* Stacked, the side block sits UNDER the name rather than opposite it, so it
       shares the name's left edge. Right-aligning it here was the tell that the
       footer had gone one-column without noticing. */
    .footer-side {
      align-items: center;
      width: 100%;
      /* Beside the name this gap separated two lines of one right-aligned
         column; stacked it separates the nav row from the social icons, which
         now read as two distinct rows and need more air between them. */
      gap: 1.35rem;
    }
    .footer-nav {
      justify-content: center;
    }
    /* 17rem, down from the 22rem tuned for a left-aligned column. At 22rem the
       quote broke as a full line plus a two-word tail — barely noticeable ragged
       right, but centered that stub is conspicuous. The narrower measure splits
       it into two balanced lines instead. */
    .footer-quote {
      max-width: 17rem;
      margin-inline: auto;
    }
    .footer-bottom {
      text-align: center;
    }
    /* Narrow screens wrap the nav row, and the ::before dot travels WITH the
       link that follows it — a wrapped line then opens with an orphaned "·".
       CSS can't tell which links wrapped, so below the wrap-prone width the
       dots go away entirely and plain gaps separate the links. */
    .footer-nav {
      gap: 0.35rem 1.2rem;
    }
    .footer-nav a + a::before {
      content: none;
    }
    /* .footer-bottom is a sibling of .footer-inner, so the flex `gap` above
       never reaches it — side by side its own padding was enough, stacked it
       left the copyright sitting 24px under the icons as if it belonged to
       them. It's the third group, and it should read as one. */
    .footer-bottom {
      padding-top: 0.5rem;
    }
  }

  .author-modal {
    padding: 2.5rem 2rem;
    border: 1px solid var(--color-border);
    border-radius: 16px;
    background-color: var(--color-bg);
    color: var(--color-text-main);
    max-width: 500px;
    width: 90%;
    box-shadow: var(--shadow-lg);
    margin: auto;
  }
  .author-modal::backdrop {
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }
  .close-btn {
    position: absolute;
    top: 1rem;
    right: 1.25rem;
    background: transparent;
    border: none;
    font-size: 2rem;
    cursor: pointer;
    color: var(--color-text-muted);
    line-height: 1;
    padding: 0;
  }
  .close-btn:hover {
    color: var(--color-accent);
  }
  .modal-flex {
    display: flex;
    gap: 1.5rem;
    align-items: center;
    margin-bottom: 1.5rem;
  }
  .modal-avatar {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    object-fit: cover;
  }
  #modal-name {
    margin: 0 0 0.25rem 0;
    font-size: 1.5rem;
  }
  #modal-title {
    color: var(--color-accent);
    font-size: 1rem;
    font-weight: 500;
    display: block;
  }
  #modal-role {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    display: block;
    margin-top: 0.25rem;
