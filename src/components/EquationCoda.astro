---
// Compact easter-egg coda: the Langevin dynamics the hero particles
// integrate, written in the OVERDAMPED (position) form — the sim's strong
// velocity damping puts it in that regime, so the inertial v̇ term drops and
// the noise amplitude is the bare √(2D). The shorter equation also fits one
// line on phones. Hovering/focusing a term tints it and reveals a small
// same-colored annotation chip. Nothing invites the interaction — discovery
// is the point. On (hover: none) devices the chips render statically so
// touch users get the annotated layout.
import katex from "katex";

const T = (tex: string) =>
  katex.renderToString(tex, { throwOnError: false });

// Each term renders as its own KaTeX fragment so it can carry hover state.
// The leading empty group `{}` before + makes KaTeX treat it as a BINARY
// operator (thin space on both sides); rendered alone, a leading + would
// parse as unary and get no spacing — the terms then read cramped.
// The interactive term is f_you, not f_cursor — on touch screens there is no
// cursor, and "you" matches the caption. The chip then says who "you" is per
// device: "the cursor" under a mouse, "your finger" on touch (the touch span
// is display:none'd per media query, which also keeps it out of the
// aria-describedby accessible name).
const terms = [
  {
    key: "noise",
    tex: "\\sqrt{2D}\\,\\boldsymbol{\\eta}(t)",
    label: "noise",
  },
  {
    key: "you",
    tex: "{}+\\boldsymbol{f}_{\\mathrm{you}}(\\boldsymbol{r})",
    label: "the cursor",
    labelTouch: "your finger",
  },
];
---

<section class="eq-coda" data-reveal>
  {/* Caption FIRST — it introduces the line below and doubles as the
      separator between the contact section and this epilogue. */}
  <p class="eq-caption">
    Every particle in the opening simulation integrates this equation. The last
    term is you.
  </p>
  <p class="eq-line">
    {/* Trailing `{}` keeps `=` binary-spaced despite the missing right side. */}
    <span class="eq-frag" set:html={T("\\dot{\\boldsymbol{r}} = {}")} />
    {
      terms.map((t) => (
        <span
          class={`eq-term eq-term--${t.key}`}
          tabindex="0"
          aria-describedby={`eq-chip-${t.key}`}
        >
          <span class="eq-frag" set:html={T(t.tex)} />
          <span class="eq-chip" id={`eq-chip-${t.key}`}>
            {t.labelTouch ? (
              <>
                <span class="eq-chip-pointer">{t.label}</span>
                <span class="eq-chip-touch">{t.labelTouch}</span>
              </>
            ) : (
              t.label
            )}
          </span>
        </span>
      ))
    }
  </p>
</section>

<style>
  .eq-coda {
    max-width: var(--max-width);
    margin: 0 auto;
    /* Epilogue spacing: air above (after the contact section); the bottom
       padding leaves room for the hover chips, which now open DOWNWARD into
       empty space (the caption sits above the equation). */
    padding: 3.5rem 1rem 2rem;
    text-align: center;
  }
  .eq-line {
    margin: 0;
    font-size: 1.25rem;
    color: var(--color-text-main);
  }
  .eq-frag :global(.katex) {
    font-size: 1em;
  }
  .eq-term {
    --eq-c: var(--color-text-main);
    position: relative;
    display: inline-block;
    cursor: default;
    transition: color 0.2s ease;
    border-radius: 3px;
  }
  .eq-term--noise {
    --eq-c: var(--color-accent);
  }
  .eq-term--you {
    --eq-c: var(--color-hot);
  }
  .eq-term:hover,
  .eq-term:focus-visible {
    color: var(--eq-c);
  }
  .eq-term:focus-visible {
    outline: 2px solid var(--eq-c);
    outline-offset: 3px;
  }
  /* Chip: real DOM (screen readers can always reach it via aria-describedby);
     visually revealed on hover/focus. Kept opacity-based, not display:none. */
  .eq-chip {
    position: absolute;
    left: 50%;
    top: 100%;
    transform: translate(-50%, 0.15rem);
    white-space: nowrap;
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--eq-c);
    opacity: 0;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
    pointer-events: none;
  }
  .eq-term:hover .eq-chip,
  .eq-term:focus-visible .eq-chip {
    opacity: 1;
    transform: translate(-50%, 0.35rem);
  }
  .eq-caption {
    margin: 0 0 1.5rem;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }
  /* Device-appropriate chip wording: "the cursor" under a mouse, "your
     finger" on touch. display:none also removes the hidden span from the
     aria-describedby accessible name. */
  .eq-chip-touch {
    display: none;
  }
  /* Touch / no-hover: annotated statically (the compact fallback layout). */
  @media (hover: none) {
    .eq-line {
      display: inline-flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: baseline;
      gap: 0 0.1em;
    }
    .eq-chip {
      position: static;
      display: block;
      transform: none;
      opacity: 1;
      margin-top: 0.3rem;
    }
    /* Tapping a term focuses it, and the base :focus-visible reveal rule
       (higher specificity) would re-apply its translate to the now-static
       chip — the label visibly jumped on tap. Pin the static layout at
       matching specificity. */
    .eq-term:hover .eq-chip,
    .eq-term:focus-visible .eq-chip {
      transform: none;
    }
    .eq-term {
      color: var(--eq-c);
    }
    .eq-chip-pointer {
      display: none;
    }
    .eq-chip-touch {
      display: inline;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .eq-term,
    .eq-chip {
      transition: none;
    }
  }
</style>
