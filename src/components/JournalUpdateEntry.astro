---
// Journal update entry — one stop on the timeline.
//
// Two sizes, same spine: `compact` is the rail entry on the Journal's front
// page (date + title only); the full size is the dedicated Updates view (serif
// title, description, and the hero photo when the post has one).
//
// Label rule (see JournalEssayRow): an update never shows the word "Updates" —
// its date is the label, and the timeline spine supplies the register.
// Link-less updates (`noLink`) render as plain text with no arrow, so the row
// never advertises a click that goes nowhere. The dot is the same on every
// stop — it marks a point on the spine, not whether the entry is clickable.
import type { CollectionEntry } from "astro:content";
import { Image, getImage } from "astro:assets";
import { renderInline, bindTrailingIcon } from "../utils/inlineText";
import { url } from "../utils/paths";
import { postLink } from "../utils/posts";

interface Props {
  post: CollectionEntry<"journal">;
  compact?: boolean;
}
const { post, compact = false } = Astro.props;
const link = postLink(post);
const hero = post.data.heroImage;

// The expanded (click-to-open) version of the hero.
//
// The thumbnail renders at width={680} densities={[1,2]}, so the build contains
// nothing wider than 1360px — enough for the photo in place, not enough for the
// thing a reader opens one of these FOR. The MIT acceptance letter is a document
// scan whose body text is unreadable in a 340px column and merely soft at 1360.
// So the large variant is generated separately, and only referenced from the
// data attribute: the browser fetches it when someone actually expands the
// photo, never as part of the timeline.
//
// Math.min guards the upscale case — Astro will not enlarge past the source, and
// asking it to would silently hand back the original width anyway.
const LIGHTBOX_WIDTH = 2040;
const heroFull =
  !compact && hero && typeof hero !== "string"
    ? await getImage({
        src: hero,
        width: Math.min(LIGHTBOX_WIDTH, hero.width),
        quality: 82,
      })
    : null;
// A hero given as a plain string lives in public/ and bypasses the image
// pipeline entirely, so the file as committed IS its full size.
const heroFullSrc =
  typeof hero === "string" ? url(hero) : (heroFull?.src ?? null);

const dateLabel = post.data.pubDate.toLocaleDateString("en-US", {
  month: "short",
  day: "numeric",
  timeZone: "UTC",
});

// Straight arrow for a page on this site, diagonal for off-site. Shown at rest
// rather than on hover: Updates is the only register with rows that go nowhere,
// and on touch there is no hover to reveal an affordance with. Bound to the
// title's last word so a wrapped title can't strand it — see bindTrailingIcon.
const ICON_ATTRS =
  'xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"';
const GO_ICON = link.external
  ? `<svg class="j-go" ${ICON_ATTRS}><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>`
  : `<svg class="j-go" ${ICON_ATTRS}><path d="M5 12h13"/><path d="M12 5l7 7-7 7"/></svg>`;
const titleHtml = link.href
  ? bindTrailingIcon(renderInline(post.data.title), GO_ICON)
  : renderInline(post.data.title);
---

<div class:list={["j-stop", { "is-compact": compact, "is-linked": !!link.href }]}>
  <div class="j-stop-date">{dateLabel}</div>
  {
    link.href ? (
      <p class="j-stop-title">
        <a
          href={link.href}
          {...(link.external
            ? { target: "_blank", rel: "noopener noreferrer" }
            : {})}
          data-track-journal
          data-track-title={post.data.title}
          data-track-category={post.data.category}
          data-track-external={link.external ? "true" : "false"}
        >
          <span class="j-t" set:html={titleHtml} />
        </a>
      </p>
    ) : (
      <p class="j-stop-title" set:html={renderInline(post.data.title)} />
    )
  }
  {!compact && post.data.description && (
    <p class="j-stop-desc">{post.data.description}</p>
  )}
  {
    !compact && hero && (
      <div class="j-stop-photo">
        {/* A real <button>, not the <img> with a click handler: the photo is an
            actual control here, and only a button gets keyboard activation, a
            focus ring and a role announced for free. Safe against the Pagefind
            "buttons are dropped from the index" rule because the whole listing
            already carries data-pagefind-ignore.
            alt falls back to the title: description is optional, and an image
            with no alt at all is worse than one described by its entry. */}
        <button
          type="button"
          class="j-stop-photo-btn"
          data-lightbox
          data-lightbox-src={heroFullSrc}
          data-lightbox-alt={post.data.description ?? post.data.title}
          aria-label={`Expand photo: ${post.data.description ?? post.data.title}`}
        >
          {typeof hero === "string" ? (
            <img
              src={url(hero)}
              alt={post.data.description ?? post.data.title}
              loading="lazy"
              decoding="async"
            />
          ) : (
            <Image
              src={hero}
              width={680}
              densities={[1, 2]}
              quality={80}
              alt={post.data.description ?? post.data.title}
              loading="lazy"
            />
          )}
        </button>
      </div>
    )
  }
</div>

<style>
  /* A stop hangs off the timeline spine drawn by .j-timeline (in the page). The
     dot is positioned relative to this box, in the spine's gutter. */
  .j-stop {
    position: relative;
    padding: 1.05rem 0;
  }
  .j-stop::before {
    content: "";
    position: absolute;
    /* Centred ON the spine, not nudged toward it. --j-tl-spine-x is the spine's
       centre measured from the timeline's left edge, and .j-stop starts one
       gutter in, so this puts the dot's own centre exactly there. translateX
       does the halving, which keeps it correct if the dot's size changes.
       (Was `-gutter + 1px`, a hand-tuned offset that landed 0.51px left.) */
    left: calc(var(--j-tl-spine-x) - var(--j-tl-gutter));
    transform: translateX(-50%);
    top: 1.72em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    /* UNIFORM across every stop, and NEUTRAL. It used to be filled for a linked
       entry and hollow for a link-less one, but quantity of ink reads as RANK,
       not kind: two solid dots among three hollow says "these two matter more"
       when it meant "these two go somewhere". The arrow beside the title
       carries linkedness now (see .j-t[data-go]), leaving the dot a pure tick.
       Neutral rather than --cat-updates because the register colour belongs to
       the YEAR marker: a section header must not be quieter than the entries
       under it, and the Notebook view spends its accent the same way — on the
       topic header, not on individual notes. Sits on a ring of page background
       so the spine doesn't show through the middle. */
    /* OPAQUE — mixed toward the page instead of `opacity`, which is the whole
       point. `opacity` fades the element AND its box-shadow ring, so the spine
       showed straight through both: the dot looked like a bead the line was
       drawn over rather than one sitting on it. Mixing keeps the same weight
       while the ring stays solid enough to break the spine cleanly. */
    background: color-mix(in srgb, var(--color-text-muted) 55%, var(--color-bg));
    box-shadow: 0 0 0 2px var(--color-bg);
    border: 2px solid
      color-mix(in srgb, var(--color-text-muted) 55%, var(--color-bg));
    transition:
      background-color 0.3s ease,
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }
  .j-stop.is-compact {
    padding: 0.32rem 0;
  }
  .j-stop.is-compact::before {
    top: 0.78em;
  }

  .j-stop-date {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }
  .j-stop.is-compact .j-stop-date {
    font-size: 0.72rem;
  }

  .j-stop-title {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.25;
    margin: 0.1rem 0 0.3rem;
    color: var(--color-text-main);
  }
  /* The rail entry is a list item, not a headline: sans, small, tight. */
  .j-stop.is-compact .j-stop-title {
    font-family: var(--font-sans);
    font-size: 0.93rem;
    font-weight: 600;
    line-height: 1.35;
    margin: 0;
  }
  .j-stop-title a {
    color: var(--color-text-main);
    text-decoration: none;
  }
  .j-stop-title a:hover {
    opacity: 1;
  }
  /* NO stretched overlay on this row, unlike the Essay and Note rows.
     Those have one link and nothing else to click, so spreading its hit area
     over the whole row is free. An update can carry a photo, and the photo is
     its own control (expand) — one rectangle cannot mean both "open the post"
     and "enlarge the image", and whichever is on top silently wins. Separating
     them also keeps a button out from under a link's hit area, which is
     ambiguous to a pointer user and unpredictable to assistive tech.

     The cost, taken deliberately: the tap target shrinks from the whole entry to
     the title. The title is the conventional target, it carries the arrow that
     already advertises the destination, and the photo now advertises its own
     zoom-in cursor — so both actions are discoverable where they apply. */
  .j-t {
    position: relative;
    display: inline;
  }
  /* Underline on ::before so ::after is free for the arrow glyph below. */
  .j-t::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.12em;
    height: 2px;
    background: var(--cat-updates);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  /* Keyed to the LINK, not the row. When the row owned the hover, moving the
     pointer over the photo drew the title's underline and lit its arrow — the
     row promising a navigation that a click there no longer performs. Now each
     control shows only its own feedback: the title underlines on the title, the
     photo gets its zoom-in cursor and border lift.
     :focus-visible alongside :hover so the keyboard sees the same cue. */
  .j-stop-title a:focus-visible .j-t::before {
    transform: scaleX(1);
  }
  @media (hover: hover) and (pointer: fine) {
    .j-stop-title a:hover .j-t::before {
      transform: scaleX(1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .j-t::before {
      transition: none;
    }
  }
  /* Injected via set:html, so no scope attribute — reached with :global()
     nested inside the scoped .j-t. */
  .j-t :global(.j-tail) {
    white-space: nowrap;
  }
  .j-t :global(.j-go) {
    width: 0.62em;
    height: 0.62em;
    margin-left: 0.28em;
    opacity: 0.5;
    transition: opacity 0.2s ease;
  }
  .j-stop-title a:focus-visible .j-t :global(.j-go) {
    opacity: 1;
  }
  @media (hover: hover) and (pointer: fine) {
    .j-stop-title a:hover .j-t :global(.j-go) {
      opacity: 1;
    }
  }
  /* Underline stops at the last word rather than running under the icon. */
  .j-t:has(.j-go)::before {
    right: 0.9em;
  }
  @media (prefers-reduced-motion: reduce) {
    .j-t :global(.j-go) {
      transition: none;
    }
  }

  .j-stop-desc {
    color: var(--color-text-muted);
    margin: 0;
    max-width: 60ch;
  }
  .j-stop-photo {
    margin-top: 0.85rem;
    max-width: 340px;
  }
  /* The button is a transparent wrapper — it must add no box of its own, or the
     photo would gain a UA border, padding and an inline-block baseline gap. Its
     only visible job is the cursor and the hover/focus cue. */
  .j-stop-photo-btn {
    display: block;
    width: 100%;
    padding: 0;
    border: none;
    background: none;
    cursor: zoom-in;
    border-radius: calc(8px * var(--r-card)); /* matches the image, so the focus ring follows its corners */
  }
  @media (hover: hover) and (pointer: fine) {
    .j-stop-photo-btn:hover :global(img) {
      border-color: var(--color-text-muted);
    }
  }
  .j-stop-photo :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: calc(8px * var(--r-card));
    border: 1px solid var(--color-rule);
    transition: border-color 0.3s ease;
  }
  @media (max-width: 600px) {
    .j-stop-title {
      font-size: 1.2rem;
    }
  }
</style>
