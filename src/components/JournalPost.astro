---
import FormattedDate from './FormattedDate.astro';
import { renderInline } from '../utils/inlineText';
import { url } from '../utils/paths';

interface Props {
	post: any;
	number: number;
	catColor: string;
	catLabel: string;
}
const { post, number, catColor, catLabel } = Astro.props;

function postLink(data: any, id: string): { href: string; external: boolean } {
	if (data.externalUrl) return { href: data.externalUrl, external: true };
	if (data.linkTo) return { href: url(data.linkTo), external: false };
	return { href: url(`/blog/${id}/`), external: false };
}
const link = postLink(post.data, post.id);
const isNote = post.data.category === 'notes';
---
<article
	class:list={['j-post', { 'is-note': isNote }]}
	data-category={post.data.category}
	data-topic={post.data.topic ?? ''}
	style={`--cat-color:${catColor}`}
>
	{!isNote && <div class="j-index">{String(number).padStart(2, '0')}</div>}
	<div class="j-main">
		<div class="j-cat" style={`color:${catColor}`}>● {catLabel}</div>
		{post.data.noLink ? (
			<h2 class="j-post-title j-post-title--static" set:html={renderInline(post.data.title)} />
		) : (
			<h2 class="j-post-title">
				<a
					href={link.href}
					{...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
					data-track-journal
					data-track-title={post.data.title}
					data-track-category={post.data.category}
					data-track-external={link.external ? 'true' : 'false'}
				>
					<span class="j-title-text" set:html={renderInline(post.data.title)} />
					{link.external && (
						<svg class="j-ext-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7"></path><path d="M7 7h10v10"></path></svg>
					)}
				</a>
			</h2>
		)}
		<p class="j-desc">{post.data.description}</p>
		<div class="j-meta">
			<FormattedDate date={post.data.pubDate} />
			{!isNote && post.data.topic && <span class="j-topic-tag">{post.data.topic}</span>}
			{post.data.tags && post.data.tags.length > 0 && (
				<span class="j-tags">
					{post.data.tags.map((t: string) => (
						<a class="j-tag" href={url(`/tags/${t}`)}>#{t}</a>
					))}
				</span>
			)}
		</div>
	</div>
</article>

<style>
	.j-post {
		display: grid; grid-template-columns: 3rem 1fr; gap: 1rem;
		padding: 1.75rem 0; border-bottom: 1px solid var(--color-border);
		transition: border-color 0.2s ease;
		/* Containing block for the title link's stretched ::after overlay, which
		   makes the whole row (index, category, title, desc, meta) clickable. */
		position: relative;
	}
	/* Notebook entries aren't part of the blog's chronological sequence: no
	   running index, and no per-entry separator (the topic header rule groups
	   them instead). */
	.j-post.is-note {
		grid-template-columns: 1fr;
		border-bottom: none;
		padding: 1.25rem 0;
	}
	.j-index { font-variant-numeric: tabular-nums; color: var(--color-text-muted); opacity: 0.5; font-size: 0.9rem; padding-top: 0.3rem; }
	.j-cat { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.4rem; }
	.j-post-title {
		font-family: var(--font-serif);
		font-size: 1.6rem;
		line-height: 1.2;
		margin: 0 0 0.5rem;
		/* No resting underline. (Suppress the global h2 border-bottom; the only
		   underline is the ::after bar that draws on from the left on hover, in the
		   category color.) padding-bottom keeps the bar clear of the descenders
		   without a dead gap at rest. */
		border-bottom: none;
		padding-bottom: 0.15rem;
		display: inline-block;
		/* NOT position:relative — that would make it the offsetParent of the title
		   link, trapping the link's stretched-overlay ::after (see below) inside the
		   title instead of stretching over the whole row. The underline bar is
		   instead hosted on the inner .j-title-text span, which sizes to the text. */
	}
	/* The underline bar. Lives on the inner text span (relative, inline-block) so
	   it sizes to the title text while leaving .j-post-title unpositioned. */
	.j-title-text { position: relative; display: inline-block; }
	.j-title-text::after {
		content: "";
		position: absolute;
		left: 0;
		right: 0;
		bottom: -0.15rem;
		height: 2px;
		background: var(--cat-color);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
	}
	.j-post:hover .j-title-text::after { transform: scaleX(1); }
	.j-post-title a { color: var(--color-text-main); text-decoration: none; transition: color 0.2s ease; }
	/* Cancel the global `a:hover { opacity: 0.8 }` graying — the category-color
	   underline bar is the only intended hover cue. */
	.j-post-title a:hover { opacity: 1; }
	/* Stretched link: overlay the whole post row so a click anywhere in it enters
	   the post. Its offsetParent is .j-post (the only positioned ancestor), so it
	   never reaches the Notebook topics sidebar or group headers, which live
	   outside any .j-post. Trade-off: text under the overlay isn't selectable. */
	.j-post-title a::after {
		content: "";
		position: absolute;
		inset: 0;
	}
	/* Link-less update posts: title is plain text (no .j-title-text span), so it
	   has no underline/hover affordance and no stretched overlay. */
	.j-post-title--static { padding-bottom: 0; cursor: default; }
	@media (prefers-reduced-motion: reduce) {
		.j-title-text::after { transition: none; }
	}
	.j-ext-icon { width: 0.7em; height: 0.7em; margin-left: 0.35rem; vertical-align: baseline; opacity: 0.55; transition: opacity 0.2s ease; }
	.j-post:hover .j-ext-icon { opacity: 1; }
	.j-desc { color: var(--color-text-muted); margin: 0 0 0.75rem; max-width: 680px; }
	.j-meta { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; font-size: 0.82rem; color: var(--color-text-muted); font-style: italic; }
	.j-topic-tag { font-style: normal; padding: 0.1rem 0.6rem; border-radius: 999px; background: var(--color-bg-offset); border: 1px solid var(--color-border); }
	.j-tags { font-style: normal; letter-spacing: 0.02em; display: inline-flex; flex-wrap: wrap; gap: 0.5rem; }
	/* Tags are individually clickable. They must sit ABOVE the row's stretched
	   ::after link overlay (which otherwise captures every click in the row), so
	   give them their own stacking context with position + z-index. Rest muted,
	   lift to the main text color on hover. */
	.j-tag {
		position: relative;
		z-index: 1;
		color: var(--color-text-muted);
		text-decoration: none;
		transition: color 0.15s ease;
	}
	/* Cancel the global `a:hover { opacity: 0.8 }` graying; the color lift is the
	   only intended hover cue. */
	.j-tag:hover { color: var(--color-text-main); opacity: 1; }
	@media (max-width: 600px) {
		.j-post { grid-template-columns: 1fr; }
		.j-index { display: none; }
	}
</style>

<script>
	// Journal-post click analytics, fired MANUALLY on pointerdown rather than via
	// umami's declarative `data-umami-event` attributes.
	//
	// Why: umami's built-in click tracking hooks the `click` event and sends its
	// beacon (POST gateway.umami.is/api/send) before the link's navigation
	// proceeds. In Firefox that send blocks the navigation for a noticeable beat
	// — the "delay before the request is sent" on Journal links (Research/Project
	// links have no data-umami-event, so they never hit this). pointerdown fires
	// ~before the click that triggers navigation, so tracking here puts the beacon
	// in flight early and never delays the load. See the `data-track-*` attrs on
	// the title <a> above (renamed from data-umami-event so umami's own handler
	// doesn't also fire and re-introduce the block/double-count).
	//
	// One delegated listener on `document`, which survives ClientRouter swaps, so
	// it's registered exactly once (guarded) and covers posts rendered on any nav.
	(() => {
		const w = window as any;
		if (w.__journalTrackBound) return;
		w.__journalTrackBound = true;
		document.addEventListener(
			'pointerdown',
			(e) => {
				const a = (e.target as Element)?.closest?.('a[data-track-journal]') as HTMLElement | null;
				if (!a || typeof w.umami?.track !== 'function') return;
				w.umami.track('journal-post', {
					title: a.dataset.trackTitle,
					category: a.dataset.trackCategory,
					external: a.dataset.trackExternal,
				});
			},
			// passive: we never preventDefault; lets the browser proceed immediately.
			{ passive: true, capture: true }
		);
	})();
</script>
