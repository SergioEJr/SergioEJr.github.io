---
import "../styles/global.css";
// Self-hosted KaTeX CSS (fonts ship from the package automatically). Bundled and
// hashed by Astro so it always matches the installed katex renderer — no CDN,
// no SRI concern, no version drift. Global so frontmatter math (renderInline)
// works on any page, not just Journal posts.
import "katex/dist/katex.min.css";
import type { ImageMetadata } from "astro";
import { ClientRouter } from "astro:transitions";
import { SITE_TITLE, UMAMI_SRC, UMAMI_WEBSITE_ID } from "../consts";
import { url } from "../utils/paths";

interface Props {
  title: string;
  // Optional: see the meta tags below — absent means the tags are omitted.
  description?: string;
  image?: string | ImageMetadata;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

let defaultImg = "/og.png";
const basePath = import.meta.env.BASE_URL.replace(/\/$/, "");
let currentPath = Astro.url.pathname;
if (currentPath.startsWith(basePath)) {
  currentPath = currentPath.substring(basePath.length);
}
currentPath = currentPath.replace(/^\/|\/$/g, "");

if (currentPath === "") {
  defaultImg = "/og.png";
} else {
  defaultImg = `/${currentPath}.png`;
}

const { title, description, image = defaultImg } = Astro.props;
const atkinsonRegular = url("/fonts/atkinson-regular.woff");
const atkinsonBold = url("/fonts/atkinson-bold.woff");

const resolveImage = (img: string) => {
  if (img.startsWith("http")) return img;
  const base = import.meta.env.BASE_URL.replace(/\/$/, "") + "/";
  if (img.startsWith(base)) return img;
  return `${base}${img.replace(/^\//, "")}`;
};

const imageUrl =
  typeof image === "string"
    ? new URL(resolveImage(image), Astro.url)
    : new URL(image.src, Astro.url);
---

<meta charset="utf-8" />
<script is:inline data-cfasync="false">
  (() => {
    const root = document.documentElement;
    const resolvePreferredTheme = () => {
      try {
        const stored = localStorage.getItem("theme");
        if (stored === "dark" || stored === "light") return stored;
      } catch {}
      // Site default is DARK regardless of the OS preference — the design is
      // dark-first (the landing sim, the blueprint grid) and light mode is the
      // opt-in variant. An explicit toggle choice (stored above) still wins.
      return "dark";
    };
    const paintTheme = (theme) => {
      const dark = theme === "dark";
      root.setAttribute("data-theme", dark ? "dark" : "light");
      root.style.setProperty("background-color", "var(--color-bg)");
      root.style.colorScheme = dark ? "dark" : "light";
    };
    const applyPreferredTheme = () => paintTheme(resolvePreferredTheme());
    const markThemeReady = () => root.setAttribute("data-theme-ready", "true");
    applyPreferredTheme();
    // During a client-side swap the new <body> can paint for a frame with the
    // default (light) theme colors before the dark theme cascades, so every
    // themed element runs its `transition: background-color/color` from
    // light→dark — a 300ms whole-page white-ish sweep (the "flash" seen after
    // visiting a page that re-applies the theme). Re-engage the transition
    // suppression (html:not([data-theme-ready]) { transition:none }) for the
    // duration of the swap by dropping data-theme-ready before the swap and
    // restoring it only after the new page has painted.
    document.addEventListener("astro:before-swap", () => {
      root.removeAttribute("data-theme-ready");
    });
    document.addEventListener("astro:after-swap", () => {
      applyPreferredTheme();
      // Keep suppression active through the first painted frame, then lift it
      // so subsequent theme toggles still animate smoothly.
      requestAnimationFrame(() => requestAnimationFrame(markThemeReady));
    });
    document.addEventListener("astro:page-load", markThemeReady);
    window.addEventListener("load", markThemeReady, { once: true });
    window.__setPreferredTheme = paintTheme;
  })();
</script>
<style is:inline>
  /* CSS variables inline — available immediately in all modes (dev + prod),
     before any external CSS. The site default is DARK (see the head script), so
     the bare :root carries the DARK palette: any pre-script paint is already
     dark, for every visitor, on every OS. DARK VALUES MUST MATCH the
     [data-theme="dark"] block in global.css and the light values must match its
     :root; if they drift, the first paint flashes the wrong ground before the
     external sheet loads — the exact FOUC this block exists to prevent.

     Flash accounting (Chromium paint-hold on reload): dark-by-default closes
     the old white-flash gap for everyone. The one remaining case is its mirror
     — a returning visitor who explicitly chose LIGHT can catch a single dark
     frame before the head script applies their stored choice. CSS can't read
     localStorage, so that frame is unavoidable; it's brief and only affects
     the explicit-light minority. */
  :root {
    --color-bg: #0f172a;
    --color-bg-offset: #0f172a;
    --color-bg-header: rgba(15, 23, 42, 0.8);
    --color-text-main: #e2e8f0;
    --color-text-muted: #94a3b8;
    --color-accent: #60a5fa;
    --color-border: #334155;
  }
  [data-theme="light"] {
    --color-bg: #f6f8fa;
    --color-bg-offset: #ffffff;
    --color-bg-header: rgba(246, 248, 250, 0.85);
    --color-text-main: #18222e;
    --color-text-muted: #49586a;
    --color-accent: #003366;
    --color-border: #dce3eb;
  }
  html,
  body {
    min-height: 100%;
    background-color: var(--color-bg);
  }
  /* Page scrollbar styling must be INLINE/critical: in global.css it applies only
     after that external sheet loads, so the page first paints with the default
     THICK native scrollbar and then visibly snaps to thin — a glitchy flash on
     load. Declaring it here (before any external CSS) means the thin, theme-matched
     scrollbar is correct from the first frame. Keep in sync with `html` in
     global.css. Standard props only (never ::-webkit-scrollbar — see global.css). */
  html {
    overflow-y: scroll;
    scrollbar-gutter: stable;
    scrollbar-width: thin;
    scrollbar-color: var(--color-border) var(--color-bg);
  }
  html[data-theme="dark"],
  html[data-theme="dark"] body {
    background-color: var(--color-bg);
    color-scheme: dark;
  }
  html[data-theme="light"],
  html[data-theme="light"] body {
    background-color: var(--color-bg);
    color-scheme: light;
  }
  /* Critical header layout — prevents FOUC before component CSS loads */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    padding: 0 1em;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .site-header nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 960px;
    margin: 0 auto;
    height: 4.5rem;
  }
  .site-header {
    background-color: var(--color-bg-header);
  }
  /* Critical card backgrounds — prevents white flash in dark mode */
  .project-card {
    background-color: var(--color-bg-offset);
    border-color: var(--color-border);
  }
  body {
    background-color: var(--color-bg);
    color: var(--color-text-main);
    margin: 0;
  }
  /* Suppress all transitions until page is fully styled */
  html:not([data-theme-ready]) *,
  html:not([data-theme-ready]) *::before,
  html:not([data-theme-ready]) *::after {
    transition: none !important;
    animation: none !important;
  }
</style>
<meta name="viewport" content="width=device-width,initial-scale=1" />
<ClientRouter />
<link rel="icon" type="image/png" href={url("/favicon.png")} />
<link rel="sitemap" href={url("/sitemap-index.xml")} />
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_TITLE}
  href={new URL("rss.xml", Astro.site)}
/>
<meta name="generator" content={Astro.generator} />
{/* dark first: the UA's pre-CSS default rendering should assume the site
    default (dark), matching the :root palette in the critical CSS above. */}
<meta name="color-scheme" content="dark light" />

<style
  is:inline
  set:html={`
		@font-face {
			font-family: "Atkinson";
			src: url("${atkinsonRegular}") format("woff");
			font-weight: 400;
			font-style: normal;
			font-display: swap;
		}

		@font-face {
			font-family: "Atkinson";
			src: url("${atkinsonBold}") format("woff");
			font-weight: 700;
			font-style: normal;
			font-display: swap;
		}
	`}
></style>

<link rel="canonical" href={canonicalURL} />

{/* description is optional (a Journal post may stand on its title alone). When
    it's absent the tags are OMITTED rather than filled with the site blurb:
    many pages sharing one meta description is worse for search than none, and
    with none the engine pulls a snippet from the body instead. */}
<title>{title}</title>
<meta name="title" content={title} />
{description && <meta name="description" content={description} />}

<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:image" content={imageUrl} />

<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
{description && <meta property="twitter:description" content={description} />}
<meta property="twitter:image" content={imageUrl} />

<!-- Umami Analytics -->
{
  UMAMI_WEBSITE_ID && (
    <script
      is:inline
      defer
      src={UMAMI_SRC}
      data-website-id={UMAMI_WEBSITE_ID}
    />
  )
}
