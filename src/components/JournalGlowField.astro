---
interface Props {
  count?: number;
  class?: string;
}
const { count = 46, class: className = "" } = Astro.props;
---

<canvas
  class:list={["journal-glow-field", className]}
  data-count={count}
  aria-hidden="true"></canvas>

<style>
  .journal-glow-field {
    position: absolute;
    /* The drawing band bleeds UP toward the navbar and DOWN past .j-head to the
       bottom of the filter bar. left/top are set here; width/height are measured
       and set in JS (resize) so the canvas reaches the filter bar's bottom edge.
       The sticky filter bar (z-index 30) paints over the bleed. */
    left: 0;
    top: 0;
    pointer-events: none;
    z-index: 0;
    /* Fade driven by the IntersectionObserver. */
    opacity: 1;
    transition: opacity 0.45s ease;
    /* The mask (bottom fade, plus side fades when width-capped) is composed in JS
       — see applyMask() — so it can intersect multiple gradients. */
  }
</style>

<script>
  // Reference header area (≈ content width × header height) used to area-scale
  // the particle count so the field isn't sparse on tall mobile headers.
  const REF_AREA = 760 * 210;
  const MIN_N = 18;
  const MAX_N = 60;

  // Per-nav teardown. Under ClientRouter a fresh canvas is swapped in on each
  // visit to /journal; without cleanup every visit leaked two window listeners
  // (resize, hashchange), an IntersectionObserver, and a MutationObserver — all
  // closing over the detached canvas — plus a rAF loop kept alive only by the IO
  // happening to report the removal. Track everything and release on
  // astro:before-swap.
  let glowAbort: AbortController | null = null;
  const glowObservers = new Set<IntersectionObserver | MutationObserver>();
  const glowRafs = new Set<number>();

  function teardownJournalGlowField() {
    glowAbort?.abort();
    glowAbort = null;
    for (const obs of glowObservers) obs.disconnect();
    glowObservers.clear();
    for (const raf of glowRafs) cancelAnimationFrame(raf);
    glowRafs.clear();
  }

  function initJournalGlowField() {
    const canvases = Array.from(
      document.querySelectorAll<HTMLCanvasElement>(".journal-glow-field"),
    );
    const reduce = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    if (!glowAbort) glowAbort = new AbortController();
    const { signal } = glowAbort;

    for (const canvas of canvases) {
      if ((canvas as any).__glowBound) continue;
      (canvas as any).__glowBound = true;

      const ctx = canvas.getContext("2d");
      if (!ctx) continue;
      const parent = canvas.parentElement!;
      const DPR = Math.min(window.devicePixelRatio || 1, 2);
      const baseCount = parseInt(canvas.dataset.count || "46", 10);

      // Look B (Balanced) tuning, from the approved visual demo.
      // Two stacked pill glows centered on the eyebrow:
      //  - inner: small halo, tight to the text — clearly establishes the source.
      //  - outer: larger, softer halo — extends the light further into the field.
      const LOOK = {
        innerR: 70, // inner pill halo radius (px) — tight to the text
        innerAlpha: 0.05, // inner peak opacity
        outerR: 260, // outer pill halo radius (px) — soft, extends further
        outerAlpha: 0.1, // outer peak opacity
        lightAlpha: 0.55, // proximity brightening weight
        shade: 0.01, // directional highlight/shadow weight
        baseAlpha: 0.42, // ambient particle alpha away from light
        lightReach: 0.55, // particle proximity reach as fraction of canvas diagonal
      };

      // Light source state. The light is pinned to the eyebrow ("<FILTER> · N
      // PIECES") — a stable anchor near the top of the header. It's PILL-shaped:
      // a horizontal capsule matching the eyebrow's footprint, so the glow looks
      // like it emanates from the text itself rather than from a point behind it.
      // hx/hy are the capsule's half-width / half-height. Position barely moves
      // between filters (only the label changes); the COLOR is what animates.
      const light = { x: 0, y: 0, hx: 40, hy: 8 };

      // Measure the eyebrow's center + half-extents, in canvas-local coordinates.
      function measureLight(): {
        x: number;
        y: number;
        hx: number;
        hy: number;
      } {
        const eyebrow = document.querySelector(".j-eyebrow");
        const cr = canvas.getBoundingClientRect();
        if (!eyebrow) return { x: W / 2, y: H * 0.35, hx: 40, hy: 8 };
        const er = (eyebrow as HTMLElement).getBoundingClientRect();
        return {
          x: er.left + er.width / 2 - cr.left,
          y: er.top + er.height / 2 - cr.top,
          hx: er.width / 2,
          hy: er.height / 2,
        };
      }
      function recomputeTarget() {
        const m = measureLight();
        targetX = m.x;
        light.y = m.y;
        light.hx = m.hx;
        light.hy = m.hy;
      }
      let targetX = 0;

      // Resolve --cat-color (may be a hex like #3b82f6 or var(--color-accent))
      // to concrete RGB. `targetRGB` is the active filter's color; the displayed
      // `lightRGB` eases toward it in tick() so color and position arrive together
      // (without this, the color snaps instantly while the light is still gliding).
      let lastColorStr = "";
      let lightRGB: [number, number, number] = [96, 165, 250];
      let targetRGB: [number, number, number] = [96, 165, 250];
      const probe = document.createElement("span");
      probe.style.display = "none";
      function resolveCatColor() {
        const journal = document.getElementById("journal");
        const raw = journal
          ? getComputedStyle(journal).getPropertyValue("--cat-color").trim()
          : "";
        if (raw === lastColorStr) return;
        lastColorStr = raw;
        // Let the browser resolve var()/hex/named to rgb() via computed style.
        if (!probe.isConnected) document.body.appendChild(probe);
        probe.style.color = raw || "var(--color-accent)";
        const rgb = getComputedStyle(probe).color; // "rgb(r, g, b)"
        const m = rgb.match(/(\d+),\s*(\d+),\s*(\d+)/);
        if (m) targetRGB = [+m[1], +m[2], +m[3]];
      }

      let W = 0,
        H = 0;
      const parts: {
        x: number;
        y: number;
        vx: number;
        vy: number;
        r: number;
        ph: number;
      }[] = [];

      // Distance to bleed UP from .j-head's top toward the navbar bottom (4.5rem
      // ≈ 72px). The band fills from just under the navbar down to the TOP of the
      // filter bar (the bar frosts over anything behind it, so drawing under it
      // only creates a seam). A short bottom fade hides the meeting edge.
      const NAVBAR_BOTTOM = 72;
      // Cap the field width on large desktops (matches the home hero's MAX_SIM_W)
      // and center it, so particles don't sprawl edge-to-edge on huge monitors.
      // Side fades dissolve the capped edges. Below this width the field is full
      // bleed (mobile unchanged).
      const MAX_W = 1440;

      function resize() {
        const rect = parent.getBoundingClientRect(); // .j-head box
        const bar = document.querySelector(".j-filters-bar");

        // Geometry must be SCROLL-INDEPENDENT. Measure in layout/offset space,
        // never from a viewport-relative rect that moves as you scroll —
        // otherwise mobile URL-bar show/hide (which fires `resize`) recomputes a
        // different band on every scroll, visibly changing the field's extent
        // and, before reflow() existed, re-rolling every particle.
        //
        // .j-head is statically positioned, so its offsetTop is stable.
        const headTopDoc = parent.offsetTop;
        // Bleed a FIXED distance up toward the navbar (clamped so the band never
        // starts above the top of the page). This was previously derived from
        // .j-head's viewport rect.top, which made it scroll-dependent.
        const bleedUp = Math.min(NAVBAR_BOTTOM, headTopDoc);
        const top = headTopDoc - bleedUp;
        // Band bottom = the filter bar's UNSTUCK (layout) BOTTOM, so the field
        // runs THROUGH the bar rather than stopping at its top edge. The bar is
        // translucent (tint + backdrop blur) and paints above this canvas, so
        // the light reads through the frost and the pills sit in it instead of
        // the glow dying on the bar's leading edge.
        //
        // Nothing here is scroll-aware, and it doesn't need to be: the band is
        // fixed in DOCUMENT space, so once the page is scrolled far enough that
        // the stuck bar has moved past the band, there is simply no glow behind
        // it and it goes back to plain frost on its own.
        //
        // The bar is `position: sticky`, so BOTH its offsetTop and its rect
        // report the CURRENT stuck offset, not the layout position — measured
        // here they jump 270 -> 867 the moment it sticks. That was the main
        // reason the band's extent changed on every scroll.
        //
        // We also can't reconstruct it from .j-head's bottom: #j-subtitle's
        // bottom margin COLLAPSES through .j-head (padding-bottom is 0), so the
        // real gap is ~20px larger than .j-head's offsetHeight reports.
        //
        // Instead, briefly neutralize the stickiness (`position: static`) and
        // read the rect. That forces the browser to report the bar's LAYOUT
        // position regardless of current scroll. The style is restored in the
        // same synchronous block, so it is never painted — and since we only do
        // this inside resize() (which now early-returns when nothing changed),
        // it costs one extra layout on genuine resizes only, not per scroll.
        let bottom: number;
        if (bar instanceof HTMLElement) {
          const prevPos = bar.style.position;
          bar.style.position = "static";
          bottom = bar.getBoundingClientRect().bottom + window.scrollY;
          bar.style.position = prevPos;
        } else {
          bottom = headTopDoc + parent.offsetHeight;
        }

        // Horizontal: bleed full viewport width, capped at MAX_W and centered.
        const vw = document.documentElement.clientWidth;
        const nextW = Math.min(vw, MAX_W);
        const canvasLeftVp = (vw - nextW) / 2; // viewport X of the canvas left edge
        const nextH = Math.max(1, bottom - top);

        // Bail out when the band is unchanged. `resize` fires on every mobile
        // URL-bar show/hide, and reassigning canvas.width/height CLEARS the
        // canvas even when the value is identical — so without this the field
        // blanked for a frame on each scroll. Returning false also tells the
        // caller not to touch the particles at all.
        if (nextW === W && nextH === H) return false;
        W = nextW;
        H = nextH;

        // Canvas is absolutely positioned inside .j-head (rect.left from viewport
        // edge); offset so its left edge lands at canvasLeftVp in the viewport.
        canvas.style.left = `${canvasLeftVp - rect.left}px`;
        canvas.style.top = `${-bleedUp}px`;
        canvas.style.width = `${W}px`;
        canvas.style.height = `${H}px`;
        canvas.width = Math.max(1, Math.floor(W * DPR));
        canvas.height = Math.max(1, Math.floor(H * DPR));
        ctx!.setTransform(DPR, 0, 0, DPR, 0, 0);

        // Side fades only kick in when the field is capped (large desktop). On
        // mobile/narrow (W === vw) there's no side fade — leave the edges as-is.
        applyMask(W < vw);

        // Light is pinned to the eyebrow near the top of the band.
        recomputeTarget();
        if (light.x === 0) light.x = targetX;
        return true;
      }

      // Compose the bottom fade (always) with optional left/right side fades
      // (only when the field is width-capped), mirroring the hero's mask pattern.
      function applyMask(sideFade: boolean) {
        const bottom =
          "linear-gradient(to bottom, #000 calc(100% - 36px), transparent 100%)";
        const layers = [bottom];
        if (sideFade) {
          // Fade the capped left/right edges over ~8% of the width.
          layers.push(
            "linear-gradient(to right, transparent 0, #000 8%, #000 92%, transparent 100%)",
          );
        }
        const style = canvas.style as any;
        style.webkitMaskImage = layers.join(", ");
        style.maskImage = layers.join(", ");
        style.webkitMaskComposite = "source-in";
        style.maskComposite = "intersect";
      }

      function particleCount() {
        const n = Math.round((baseCount * (W * H)) / REF_AREA);
        return Math.max(MIN_N, Math.min(MAX_N, n));
      }

      function newParticle(x: number, y: number) {
        return {
          x,
          y,
          vx: (Math.random() - 0.5) * 0.15,
          vy: (Math.random() - 0.5) * 0.15,
          r: 0.8 + Math.random() * 1.4,
          ph: Math.random() * Math.PI * 2,
        };
      }

      function seed() {
        parts.length = 0;
        const N = particleCount();
        for (let i = 0; i < N; i++) {
          parts.push(newParticle(Math.random() * W, Math.random() * H));
        }
      }

      // Re-fit the EXISTING particles to a new canvas size instead of re-rolling
      // them. `resize` fires on every mobile URL-bar show/hide, i.e. constantly
      // while scrolling; calling seed() there made the whole field visibly
      // re-scatter on each scroll. Positions are remapped proportionally (so the
      // pattern stretches with the band rather than jumping), and the count is
      // only topped up / trimmed at the ends when the area change warrants it.
      // Identity — velocity, radius, twinkle phase — is preserved throughout.
      function reflow(prevW: number, prevH: number) {
        if (!parts.length) {
          seed();
          return;
        }
        if (prevW > 0 && prevH > 0 && (prevW !== W || prevH !== H)) {
          const sx = W / prevW;
          const sy = H / prevH;
          for (const p of parts) {
            p.x *= sx;
            p.y *= sy;
          }
        }
        const N = particleCount();
        while (parts.length > N) parts.pop();
        while (parts.length < N) {
          parts.push(newParticle(Math.random() * W, Math.random() * H));
        }
      }

      function draw(time = 0) {
        resolveCatColor();
        const r = Math.round(lightRGB[0]);
        const g = Math.round(lightRGB[1]);
        const b = Math.round(lightRGB[2]);
        const lx = light.x;
        const ly = light.y;

        // Theme-aware treatment. On DARK the field is additive-ish: a translucent
        // colored glow plus particles that brighten toward white near the light.
        // On LIGHT that reads as gray haze on white, so we boost glow saturation
        // and DARKEN particles toward a deeper accent (so they show on white).
        const dark =
          document.documentElement.getAttribute("data-theme") === "dark";
        // Light mode: a COMPACT tinted pool of the register color bleeding into the
        // paper, not a wide gray haze. A gentle multiplier + a tighter outer radius
        // (see `outerR` below) keep it reading as colored ink around the eyebrow.
        //
        // The multiplier used to be 1.1, i.e. light mode got MORE wash than dark.
        // That is backwards: on #0f172a a translucent colored layer adds light and
        // reads as a nebula, but on #f6f8fa it subtracts and reads as a stain — and
        // the capsule is centered on .j-eyebrow's own measured box, so the densest
        // part sat exactly behind the header's only colored text. Measured, the
        // register color landed at 15.3% alpha there and cost the eyebrow 15-26% of
        // its contrast, taking Updates from 4.85 to 3.96 (AA pass to fail). At 0.6
        // that drops to 4.3% alpha. Dark is untouched — the `dark ? 1` branch is
        // the same value it always was.
        // E-ink light (2026-09): no pool at all. Paper does not glow, and even
        // the 4.3% wash read as a grey stain behind the eyebrow on the warm
        // ground. The particles stay — dark specks on paper read as a
        // dot-matrix field, which is the register's texture, not its light.
        const glowK = dark ? 1 : 0;

        ctx!.clearRect(0, 0, W, H);

        // Two stacked pill glows centered on the eyebrow. A GENUINE capsule: the
        // bright core is the horizontal SEGMENT [lx-hx, lx+hx] at y=ly, and the
        // glow falls off by DISTANCE-TO-THE-SEGMENT (not distance-to-a-point), so
        // the whole line is equally bright — not an ellipse peaking at the center.
        // Built as: a middle band (vertical linear falloff, uniform along X) plus
        // two radial caps at the endpoints. OUTER (soft, far) under INNER (tight).
        const hx = light.hx;
        // Genuine capsule glow built from gradients (robust everywhere — no
        // shadowBlur quirks, no solid core bar). A capsule = points within `gr`
        // of the horizontal segment [lx-hx, lx+hx]. Rendered as:
        //   • a MIDDLE band over x∈[lx-hx, lx+hx], vertical falloff — so the whole
        //     line is equally bright (the uniform "line" source); plus
        //   • two RADIAL CAPS at the endpoints, same falloff profile, rounding the
        //     ends and covering the band's vertical side edges (no hard seam).
        const drawPill = (gr: number, alpha: number) => {
          const gA = alpha * glowK;
          const mid = ctx!.createLinearGradient(0, ly - gr, 0, ly + gr);
          mid.addColorStop(0, `rgba(${r},${g},${b},0)`);
          mid.addColorStop(0.5, `rgba(${r},${g},${b},${gA})`);
          mid.addColorStop(1, `rgba(${r},${g},${b},0)`);
          ctx!.fillStyle = mid;
          ctx!.fillRect(lx - hx, ly - gr, hx * 2, gr * 2);
          // Caps: only the OUTER semicircle beyond each endpoint, so they don't
          // overlap (and double-brighten) the band. Left cap fills [cx-gr, cx];
          // right cap fills [cx, cx+gr].
          const caps: [number, number][] = [
            [lx - hx, lx - hx - gr],
            [lx + hx, lx + hx],
          ];
          for (const [cx, rectX] of caps) {
            const cap = ctx!.createRadialGradient(cx, ly, 0, cx, ly, gr);
            cap.addColorStop(0, `rgba(${r},${g},${b},${gA})`);
            cap.addColorStop(0.5, `rgba(${r},${g},${b},${gA * 0.5})`);
            cap.addColorStop(1, `rgba(${r},${g},${b},0)`);
            ctx!.fillStyle = cap;
            ctx!.fillRect(rectX, ly - gr, gr, gr * 2);
          }
        };
        // Tighter outer halo in light so the pool stays a compact ink bleed rather
        // than a broad wash across the header (dark keeps the wider, softer reach).
        //
        // 200 was still a FIXED radius against a header whose width is not: it
        // reached ~167px past the eyebrow either way, which is ~33% of the .j-head
        // box at 1440px but ~85% of it at 390px — so the narrower the screen, the
        // more of the header the wash owned, which is the opposite of what a
        // decorative field should do. 150 pulls mobile back to ~74%.
        const outerR = dark ? LOOK.outerR : 150;
        if (glowK > 0) {
          drawPill(outerR, LOOK.outerAlpha); // soft, extends further
          drawPill(LOOK.innerR, LOOK.innerAlpha); // tight, anchors the source
        }

        // Particles lit by distance to the capsule SEGMENT (not a point), so the
        // whole text line acts as the source.
        const maxd = Math.hypot(W, H);
        for (const p of parts) {
          // Nearest point on the horizontal segment [lx-hx, lx+hx] at y=ly.
          const nx = Math.max(lx - hx, Math.min(lx + hx, p.x));
          const ny = ly;
          // Vector from that nearest point to the particle → distance + direction.
          const vx = p.x - nx;
          const vy = p.y - ny;
          const dist = Math.hypot(vx, vy) || 1;
          const prox = Math.max(0, 1 - dist / (maxd * LOOK.lightReach)); // brighter near light
          // Directional shading: brighter on the side facing the light segment.
          const facing = (-vx / dist) * 0.6 + (-vy / dist) * 0.4; // -1..1
          const dirLit = 0.5 + 0.5 * facing; // 0..1
          const twinkle = 0.85 + 0.15 * Math.sin(time * 1.5 + p.ph);

          const lit =
            LOOK.baseAlpha +
            LOOK.lightAlpha * prox * prox +
            LOOK.shade * prox * (dirLit - 0.5);
          // Light mode needs a higher alpha floor so particles register on white.
          const a = Math.max(dark ? 0.04 : 0.12, Math.min(1, lit * twinkle));

          const heat = prox * prox;
          let cr: number, cg: number, cb: number;
          if (dark) {
            // Hot core: tint toward white near the light, accent farther out.
            cr = Math.round(r + (255 - r) * heat * 0.7);
            cg = Math.round(g + (255 - g) * heat * 0.7);
            cb = Math.round(b + (255 - b) * heat * 0.7);
          } else {
            // On white, brightening toward white makes particles vanish. Instead
            // DARKEN toward a deeper accent near the core so they read as lit.
            cr = Math.round(r * (1 - heat * 0.45));
            cg = Math.round(g * (1 - heat * 0.45));
            cb = Math.round(b * (1 - heat * 0.45));
          }

          ctx!.globalAlpha = a;
          ctx!.fillStyle = `rgb(${cr},${cg},${cb})`;
          ctx!.beginPath();
          ctx!.arc(p.x, p.y, p.r, 0, Math.PI * 2);
          ctx!.fill();
        }
        ctx!.globalAlpha = 1;
        // Bottom fade is handled by a CSS mask on the canvas element (see <style>),
        // which is layout-independent and consistent across all widths — unlike a
        // per-frame canvas wipe, which drifted on the taller mobile filter bar.
      }

      let t0 = 0;
      function tick(now: number) {
        if (!t0) t0 = now;
        const time = (now - t0) / 1000;
        for (const p of parts) {
          p.x += p.vx;
          p.y += p.vy;
          if (p.x < 0) p.x += W;
          if (p.x > W) p.x -= W;
          if (p.y < 0) p.y += H;
          if (p.y > H) p.y -= H;
        }
        // Position glides slowly (the light visibly travels to the new pill).
        light.x += (targetX - light.x) * 0.12;
        // Color transitions on its OWN, faster ease — decoupled from position so
        // the hue changes smoothly and promptly instead of looking "paused" while
        // the light is still mid-glide.
        const cEase = 0.28;
        lightRGB[0] += (targetRGB[0] - lightRGB[0]) * cEase;
        lightRGB[1] += (targetRGB[1] - lightRGB[1]) * cEase;
        lightRGB[2] += (targetRGB[2] - lightRGB[2]) * cEase;
        draw(time);
        glowRafs.delete(raf);
        raf = requestAnimationFrame(tick);
        glowRafs.add(raf);
      }

      // Set while the field is fully out of view; consumed on its way back in.
      let needsReseed = false;

      let raf = 0;
      resize();
      seed();
      // Seed the displayed color from the active filter so the first paint is the
      // right color (no blue→accent glide on load) and the reduced-motion frame
      // is correct.
      resolveCatColor();
      lightRGB = [targetRGB[0], targetRGB[1], targetRGB[2]];
      if (reduce) {
        recomputeTarget();
        light.x = targetX;
        draw();
      } else {
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              canvas.style.opacity = "1";
              recomputeTarget(); // re-measure in case layout shifted while away
              // Re-scatter ONLY here: the field is completely out of sight, so a
              // fresh arrangement can't be seen popping. While any part of it is
              // on screen, particles persist (resize goes through reflow()).
              if (needsReseed) {
                needsReseed = false;
                seed();
              }
              if (!raf) {
                raf = requestAnimationFrame(tick);
                glowRafs.add(raf);
              }
            } else {
              canvas.style.opacity = "0";
              cancelAnimationFrame(raf);
              glowRafs.delete(raf);
              raf = 0;
              // Out of sight — allow one fresh scatter before it returns.
              needsReseed = true;
            }
          }
        });
        io.observe(parent); // parent is .j-head
        glowObservers.add(io);
      }
      window.addEventListener(
        "resize",
        () => {
          const prevW = W;
          const prevH = H;
          // No-op when the band didn't actually change (the common case on
          // mobile, where scrolling fires resize via the URL bar).
          if (!resize()) return;
          // Keep the existing particles — see reflow(). Re-seeding here is what
          // made the field re-scatter on every mobile scroll.
          reflow(prevW, prevH);
          recomputeTarget();
          if (reduce) {
            light.x = targetX;
            draw();
          }
        },
        { signal },
      );

      // Re-measure the light target whenever the EYEBROW actually changes, rather
      // than guessing a delay after a click. The filter script swaps the eyebrow
      // label on a 160ms timer (fadeApply) and the count odometer rolls for ~1.6s
      // afterward — both shift the eyebrow's width/center. A MutationObserver on
      // the eyebrow fires on every such change (subtree text + the count's
      // data-count attribute), so the light tracks the eyebrow exactly, with no
      // timing assumptions. This is why a click and a refresh now land identically.
      const eyebrow = document.querySelector(".j-eyebrow");
      if (eyebrow) {
        const ebObserver = new MutationObserver(() => recomputeTarget());
        ebObserver.observe(eyebrow, {
          childList: true,
          subtree: true,
          characterData: true,
          attributes: true,
          attributeFilter: ["data-count"],
        });
        glowObservers.add(ebObserver);
      }
      // Hash changes (Back, manual edit) can swap the filter without a DOM-settle
      // we observe above, so re-measure on the next frame too.
      window.addEventListener(
        "hashchange",
        () => requestAnimationFrame(recomputeTarget),
        { signal },
      );
      // Remove the color-probe span from <body> when this canvas is torn down.
      signal.addEventListener("abort", () => probe.remove());
    }
  }

  initJournalGlowField();
  document.addEventListener("astro:page-load", initJournalGlowField);
