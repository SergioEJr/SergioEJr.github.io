---
export interface Props {
  headings: { depth: number; slug: string; text: string }[];
  mobile?: boolean;
  open?: boolean;
  /** Post title — shown in the mobile bar that trades places with the navbar. */
  title?: string;
}

const { headings, mobile = false, open = false, title = '' } = Astro.props;

// Filter headings to only include h2 and h3, and exclude the auto-generated
// GFM footnotes heading (slug "footnote-label") — Footnotes and References
// are both end-of-article reference material, not navigable article
// sections, so neither belongs in the Table of Contents. References has no
// heading element to begin with (see src/utils/numberCitations.ts), so only
// Footnotes needs an explicit exclude here.
const toc = headings.filter(
  (heading) =>
    heading.depth > 1 && heading.depth < 4 && heading.slug !== 'footnote-label',
);
---

{/* ---------------------------------------------------------------------------
   Desktop: a quiet outline in the LEFT gutter.

   Why left: <SideNote> margin notes are anchored prose — they must sit beside
   the sentence they annotate, and the right gutter is where the eye exits a
   line, so notes keep it. The ToC is global navigation with no per-sentence
   anchor, so it is positionally free; left is also the conventional home for a
   document outline. Splitting the two gutters means neither has to yield, and
   side notes no longer have to fade out on collision.

   Why so understated: left-aligned type in the left margin is the first thing
   the eye lands on, so weight that reads as "subtle" on the right reads as
   frontline on the left. At rest this is a column of ticks with faint labels —
   the article's shape, not a menu competing with the <h1>. The whole outline
   comes forward on hover/focus, and the current section stays legible
   throughout so position never depends on hovering.
--------------------------------------------------------------------------- */}
{
  !mobile && toc.length > 0 && (
    <nav class="toc-rail" aria-label="Table of contents">
      <div class="toc-inner">
        <ul class="toc-ticks">
          {toc.map((heading) => (
            <li class={`toc-tick depth-${heading.depth}`}>
              <a href={`#${heading.slug}`}>
                <span class="toc-tick__mark" aria-hidden="true" />
                <span class="toc-tick__label">{heading.text}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>
  )
}

{/* ---------------------------------------------------------------------------
   Mobile / single-column: a bar that trades places with the navbar.

   Scrolling DOWN (reading forward) retracts the navbar and reveals this: the
   article's tick scale plus its title, so the ToC costs no permanent screen
   space. Scrolling UP — the "where am I / take me back" gesture — restores the
   navbar and retracts this. Tapping opens the section list.

   The current heading is deliberately NOT repeated here: it is on screen in the
   prose, and the lit tick already reports position.

   Why `fixed` and not `sticky`: <main> sets `overflow-x: clip` to contain the
   negative-margin side notes. An overflow clip on ANY ancestor of a *sticky*
   element demotes iOS sticky to the main thread and makes it jitter against the
   composited scroll (see AGENTS.md — the 2026-07 hero bug). `fixed` is
   unaffected by that clip, so this sidesteps the trap instead of risking it.
--------------------------------------------------------------------------- */}
{
  mobile && toc.length > 0 && (
    <div class="toc-bar" data-toc-bar>
      <details class="toc-bar__sheet" {...(open ? { open: true } : {})}>
        <summary class="toc-bar__button" aria-label="Table of contents">
          <span class="toc-bar__scale" aria-hidden="true">
            {toc.map((heading) => (
              <span class={`toc-bar__seg depth-${heading.depth}`} />
            ))}
          </span>
          <span class="toc-bar__title">{title}</span>
          <span class="toc-bar__chevron" aria-hidden="true" />
        </summary>
        <nav class="toc-bar__panel">
          <ul class="toc-bar__list">
            {toc.map((heading) => (
              <li class={`toc-bar__item depth-${heading.depth}`}>
                <a href={`#${heading.slug}`}>
                  <span class="toc-bar__bar" aria-hidden="true" />
                  <span>{heading.text}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </details>
    </div>
  )
}

<style>
  /* ======================================================================
     DESKTOP — left-gutter outline
     ====================================================================== */
  .toc-rail {
    display: none;
  }

  @media (min-width: 1200px) {
    .toc-rail {
      display: block;
      position: absolute;
      /* Start the rail at the top of the PAGE, not the top of the prose column.
         A sticky child can never rise above its containing block, so while the
         rail began at the prose wrapper (~120px down) the outline rendered that
         far below its centered resting place and visibly slid up as the reader
         scrolled in. Extending the containing block upward — and adding the same
         amount back to the height so the bottom edge is unchanged — means the
         centered position is already reachable at scroll 0, so the outline is
         simply *there* on load. Measured in JS (--toc-rail-lift): the title
         block's height varies per post. */
      top: calc(-1 * var(--toc-rail-lift, 0px));
      /* Left gutter: sit just outside the prose column. The gutter is
         (100vw - 760px)/2 ≥ 220px at this breakpoint, so a labelled outline
         fits without crowding the text. */
      right: 100%;
      /* Wide enough that a long heading still fits on one line at the BOLD
         (active) weight — bold is ~8% wider than the resting weight. */
      width: min(230px, calc((100vw - 760px) / 2 - 32px));
      height: calc(100% + var(--toc-rail-lift, 0px));
      margin-right: 1.5rem;
      /* The sticky box spans the full viewport height so its contents can be
         centered; without this it would swallow clicks and text selection
         across the entire left margin. Only the links opt back in. */
      pointer-events: none;
    }
    .toc-tick a {
      pointer-events: auto;
    }

    /* Vertically CENTERED in the viewport rather than pinned under the navbar.
       Top-left is where the eye lands first, so an outline parked there competes
       with the <h1> and the opening paragraph; floating it to the middle of the
       margin keeps it findable without claiming that attention.

       Implemented by making the sticky box span the viewport and centering the
       list inside it — `top: 50%` + a translate would fight position:sticky,
       which needs a resolved offset to stick against. Full 100vh (not offset by
       the navbar) so the content lands on the TRUE vertical middle; offsetting
       would push it half the navbar's height low. */
    .toc-inner {
      position: sticky;
      top: 0;
      height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      text-align: right;
      /* No rule/eyebrow at rest — the ticks alone imply the margin. A border
         here reads as a panel edge and pulls focus toward the gutter. */
    }
    .toc-ticks {
      /* A very long outline still scrolls rather than overflowing the viewport. */
      max-height: calc(100vh - 9rem);
      overflow-y: auto;
    }
  }

  .toc-ticks {
    list-style: none;
    /* Both !important: this list lives inside .prose, whose global `ul` rule
       (`margin: 0 0 1.5rem; padding-left: 1.5rem`) otherwise wins. The bottom
       margin would be counted by later layout work, and the left padding inset
       every row 24px from the rail edge, leaving a dead strip beside the links. */
    padding: 0 !important;
    margin: 0 !important;
    display: flex;
    flex-direction: column;
    /* No flex gap: a gap is dead space between rows, so the pointer falls
       through the cracks. The rhythm comes from each link's own padding
       instead, which IS part of the hit area. */
  }

  .toc-tick {
    /* !important beats the global `.prose li { margin: 0.45rem 0 }` — that
       7.2px above and below each row was pure dead space between hit targets. */
    margin: 0 !important;
  }

  /* Full-width row = generous hit target, always present (no hover-to-reveal:
     hidden labels made the small ticks the only target, a precise pointer game
     that lost its own menu when you reached for a title). */
  .toc-tick a {
    display: flex;
    align-items: baseline;
    justify-content: flex-end;
    gap: 0.5rem;
    /* Spans the full rail width so the hit area reaches the rail's left edge. */
    width: 100%;
    /* Tight rhythm as PADDING rather than margins/gaps, so the space between
       labels is hoverable. Rows end up contiguous. */
    padding: 0.28rem 0;
    text-decoration: none;
    /* Quiet at rest: faint enough to read as marginalia rather than a menu. */
    color: color-mix(in srgb, var(--color-text-muted) 55%, transparent);
    transition: color 0.2s ease;
  }

  /* Line breaks are pre-computed at the BOLD width by a script (balanceLabels
     below) and baked in as explicit <br>s.

     The active row renders at weight 600, ~8% wider than the resting 400 —
     enough to tip a heading that just fit onto an extra line, reflowing the
     outline mid-scroll and shifting the other rows under the pointer. Baking
     the breaks in means the visible text occupies the same lines in either
     weight, so the weight can still change freely: the full heading is always
     shown (never truncated), and no line is ever added or removed. */
  .toc-tick__label {
    display: block;
    font-size: 0.78rem;
    line-height: 1.3;
    /* Breaks an over-long unbroken word rather than letting it escape the rail. */
    overflow-wrap: anywhere;
  }

  /* Tick doubles as depth cue and position marker; it is not the hit target. */
  .toc-tick__mark {
    flex: none;
    order: 2; /* after the label in the right-aligned row */
    width: 9px;
    height: 2px;
    border-radius: 1px;
    background: color-mix(in srgb, var(--color-border) 85%, transparent);
    transform: translateY(-0.25em);
    transition:
      background-color 0.2s ease,
      width 0.2s ease;
  }

  .toc-tick.depth-3 .toc-tick__label {
    font-size: 0.72rem;
  }
  .toc-tick.depth-3 .toc-tick__mark {
    width: 5px;
  }

  /* The whole outline comes forward when the reader engages with it. */
  .toc-rail:hover .toc-tick a,
  .toc-rail:focus-within .toc-tick a {
    color: var(--color-text-muted);
  }

  /* Scoped under .toc-rail so this outranks the rule above (0,3,1) — otherwise
     the rail-wide "bring everything forward" colour wins and the row you are
     actually pointing at never goes accent. */
  .toc-rail .toc-tick a:hover,
  .toc-rail .toc-tick a:focus-visible {
    color: var(--color-accent);
  }
  .toc-rail .toc-tick a:hover .toc-tick__mark,
  .toc-rail .toc-tick a:focus-visible .toc-tick__mark {
    background: var(--color-accent);
  }

  /* Reading position: legible at rest without shouting — the tick carries the
     accent, the label steps up to normal muted weight. */
  .toc-tick.active a {
    color: var(--color-text-muted);
    font-weight: 600;
  }
  .toc-rail:hover .toc-tick.active a,
  .toc-rail:focus-within .toc-tick.active a {
    color: var(--color-text-main);
  }
  .toc-tick.active .toc-tick__mark {
    background: var(--color-accent);
    width: 16px;
  }
  .toc-tick.active.depth-3 .toc-tick__mark {
    width: 10px;
  }

  /* ======================================================================
     MOBILE — bar that trades places with the navbar
     ====================================================================== */
  .toc-bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    /* Under the header's z-index (100): when both are mid-transition the navbar
       wins, so the site chrome is never occluded by the article's ToC. */
    z-index: 90;
    background: var(--color-bg-header);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
    /* Hidden by default: the navbar holds the slot until the reader scrolls
       down. translate keeps it off the compositor's critical path. */
    transform: translateY(-100%);
    transition: transform 0.28s ease;
  }

  .toc-bar[data-toc-shown] {
    transform: translateY(0);
  }

  @media (min-width: 1200px) {
    .toc-bar {
      display: none;
    }
  }

  .toc-bar__sheet {
    max-width: var(--max-width, 1200px);
    margin: 0 auto;
  }

  .toc-bar__button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    /* Matches the navbar's own height so the swap reads as one element
       replacing another, not as the page shifting. */
    height: 3.25rem;
    padding: 0 1rem;
    cursor: pointer;
    list-style: none;
  }
  .toc-bar__button::-webkit-details-marker {
    display: none;
  }

  /* The article's shape in miniature; the lit segment is your position. */
  .toc-bar__scale {
    flex: none;
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 13px;
  }
  .toc-bar__seg {
    width: 2px;
    border-radius: 1px;
    background: var(--color-border);
    transition: background-color 0.2s ease;
  }
  .toc-bar__seg.depth-2 {
    height: 13px;
  }
  .toc-bar__seg.depth-3 {
    height: 7px;
  }
  .toc-bar__seg.active {
    background: var(--color-accent);
  }

  .toc-bar__title {
    min-width: 0;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--color-text-main);
    /* One line — the bar must not change height as you scroll. This is the post
       TITLE, not a section heading, and the full section list is one tap away. */
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .toc-bar__chevron {
    flex: none;
    width: 6px;
    height: 6px;
    border-right: 1.5px solid var(--color-text-muted);
    border-bottom: 1.5px solid var(--color-text-muted);
    transform: translateY(-2px) rotate(45deg);
    transition: transform 0.22s ease;
  }
  .toc-bar__sheet[open] .toc-bar__chevron {
    transform: translateY(1px) rotate(-135deg);
  }

  .toc-bar__panel {
    border-top: 1px solid var(--color-border);
    padding: 0.35rem 1rem 0.7rem;
    max-height: min(60vh, 24rem);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  /* Reset margins inherited from the global .prose ul/li rules. */
  .toc-bar__list {
    list-style: none;
    padding: 0 !important;
    margin: 0 !important;
    display: flex;
    flex-direction: column;
  }
  .toc-bar__item {
    margin: 0 !important;
  }

  .toc-bar__item a {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.45rem 0;
    font-size: 0.9rem;
    line-height: 1.35;
    color: var(--color-text-muted);
    text-decoration: none;
  }
  .toc-bar__bar {
    flex: none;
    height: 2px;
    border-radius: 1px;
    background: var(--color-border);
  }
  .toc-bar__item.depth-2 .toc-bar__bar {
    width: 14px;
  }
  .toc-bar__item.depth-3 .toc-bar__bar {
    width: 7px;
  }
  /* Sub-sections step in from the text edge too, so hierarchy reads from more
     than the tick length alone. */
  .toc-bar__item.depth-3 a {
    padding-left: 1.4rem;
    font-size: 0.85rem;
  }

  .toc-bar__item a:hover {
    color: var(--color-accent);
  }
  .toc-bar__item.active a {
    color: var(--color-accent);
    font-weight: 600;
  }
  .toc-bar__item.active .toc-bar__bar {
    background: var(--color-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .toc-bar,
    .toc-bar__chevron,
    .toc-bar__seg,
    .toc-tick__mark,
    .toc-tick a {
      transition: none;
    }
  }
</style>

<script>
  let observer: IntersectionObserver | undefined;
  let cleanup: (() => void) | undefined;

  function initTOC() {
    observer?.disconnect();
    cleanup?.();
    cleanup = undefined;

    // How far the prose column starts below the top of the page. The rail's
    // containing block is extended upward by this much (--toc-rail-lift) so its
    // sticky child can already sit at its centered resting position at scroll 0
    // instead of starting low and sliding up as the reader scrolls in. Measured
    // rather than hardcoded: the title block's height varies per post (title
    // length, category badges, optional hero image).
    const railEl = document.querySelector<HTMLElement>(".toc-rail");
    const measureLift = () => {
      if (!railEl) return;
      const wrapper = railEl.closest<HTMLElement>(".prose-wrapper");
      if (!wrapper) return;
      const lift = wrapper.getBoundingClientRect().top + window.scrollY;
      railEl.style.setProperty("--toc-rail-lift", `${Math.max(0, lift)}px`);
    };
    measureLift();

    // --- Freeze each label's line breaks at the BOLD width ------------------
    // Rather than bold everything (which throws away the active/inactive
    // distinction) or truncate (which hides the section names a ToC exists to
    // show), the wrap points are computed once at weight 600 and baked in as
    // explicit <br>s. The visible text then occupies the same lines in both
    // weights.
    const balanceLabels = () => {
      const labels = document.querySelectorAll<HTMLElement>(".toc-tick__label");

      for (const label of labels) {
        // Cache the pristine string on first sight; every later run re-breaks
        // from it, so repeated passes (resize, client-side nav) are idempotent
        // and can never compound their own inserted breaks. Whitespace is
        // normalised because <br>s round-trip through textContent as none.
        const text = (
          label.dataset.tocText ??
          label.textContent ??
          ""
        ).replace(/\s+/g, " ");
        label.dataset.tocText = text;

        // Budget = the row minus the tick and the flex gap. Measuring the
        // label's own box would be a feedback loop: after the first pass it
        // reports the width of the ALREADY-BROKEN text, so each run would wrap
        // it tighter until every label collapsed to a narrow column.
        const link = label.closest("a");
        const mark = link?.querySelector(".toc-tick__mark");
        if (!link) continue;
        const gap = parseFloat(getComputedStyle(link).columnGap) || 0;
        const width =
          link.getBoundingClientRect().width -
          (mark?.getBoundingClientRect().width ?? 0) -
          gap;
        if (width <= 0) {
          label.textContent = text;
          continue;
        }

        const probe = document.createElement("span");
        const cs = getComputedStyle(label);
        probe.style.cssText = `position:absolute;left:-9999px;top:0;visibility:hidden;white-space:pre;font:${cs.font};font-weight:600;letter-spacing:${cs.letterSpacing}`;
        document.body.appendChild(probe);
        const measure = (s: string) => {
          probe.textContent = s;
          return probe.getBoundingClientRect().width;
        };

        // A single word wider than the rail has no space to break at, and CSS
        // `overflow-wrap` would then break it at a weight-dependent point —
        // reintroducing the reflow. Split such words here so every break is
        // ours and therefore weight-independent. Each token records whether a
        // space precedes it, so a split word rejoins without gaining one.
        const tokens: { text: string; space: boolean }[] = [];
        for (const word of text.split(/\s+/).filter(Boolean)) {
          if (measure(word) <= width) {
            tokens.push({ text: word, space: true });
            continue;
          }
          let chunk = "";
          let first = true;
          for (const ch of word) {
            if (chunk && measure(chunk + ch) > width) {
              tokens.push({ text: chunk, space: first });
              first = false;
              chunk = ch;
            } else {
              chunk += ch;
            }
          }
          if (chunk) tokens.push({ text: chunk, space: first });
        }

        // Greedy line-breaking at the bold width — the same algorithm the
        // browser would apply, but pinned to weight 600 regardless of state.
        const lines: string[] = [];
        let line = "";
        for (const token of tokens) {
          const sep = line && token.space ? " " : "";
          const candidate = line + sep + token.text;
          if (line && measure(candidate) > width) {
            lines.push(line);
            line = token.text;
          } else {
            line = candidate;
          }
        }
        if (line) lines.push(line);
        probe.remove();

        label.textContent = "";
        lines.forEach((l, i) => {
          if (i) label.appendChild(document.createElement("br"));
          label.appendChild(document.createTextNode(l));
        });
      }
    };
    balanceLabels();
    // Exposed so the rail can be re-balanced after anything that changes the
    // available width or the heading text (also used by the visual tests).
    (window as unknown as { __tocBalance?: () => void }).__tocBalance =
      balanceLabels;

    const onResize = () => {
      measureLift();
      balanceLabels();
      // The reading line is a fraction of the viewport height, so it moves.
      syncActive();
    };
    window.addEventListener("resize", onResize, { passive: true });
    cleanup = () => window.removeEventListener("resize", onResize);

    // --- Reading position ---------------------------------------------------
    // The lit tick answers "which section am I in", so it has to be derived
    // from where the headings ARE, not from which one most recently crossed
    // into view. An entry-triggered version (activate on isIntersecting, ignore
    // everything else) is only correct while scrolling forward: on the way back
    // up nothing ever moves the highlight, so it stayed on section N until
    // heading N-1 came back on screen — the reader could already SEE the
    // heading of the section they were reading before the outline agreed.
    //
    // So: one reading line across the viewport, and the active section is the
    // last heading above it. Symmetric by construction, in both directions.

    // 40% down the viewport — a heading is promoted once it has climbed into
    // the upper reading area, which is where the section it opens starts to own
    // the screen. Kept in sync with the observer's bottom rootMargin below.
    const ACTIVE_LINE = 0.4;

    // Only headings the outline actually lists. Filtering by the rendered links
    // (rather than observing every h2/h3) skips the Footnotes heading and any
    // headings outside the article — e.g. the search modal's — so scrolling
    // into the article's tail leaves the last real section lit instead of
    // blanking the outline.
    const listed = new Set(
      Array.from(
        document.querySelectorAll<HTMLAnchorElement>(
          '.toc-tick a[href^="#"], .toc-bar__item a[href^="#"]',
        ),
      ).map((a) => decodeURIComponent(a.getAttribute("href")!.slice(1))),
    );
    const sections = Array.from(
      document.querySelectorAll<HTMLElement>("h2, h3"),
    ).filter((h) => h.id && listed.has(h.id));

    const setActive = (id: string | null) => {
      document
        .querySelectorAll(".toc-tick, .toc-bar__item, .toc-bar__seg")
        .forEach((item) => item.classList.remove("active"));
      if (!id) return;

      const railLink = document.querySelector(
        `.toc-tick a[href="#${CSS.escape(id)}"]`,
      );
      const barLink = document.querySelector(
        `.toc-bar__item a[href="#${CSS.escape(id)}"]`,
      );

      railLink?.parentElement?.classList.add("active");
      const barItem = barLink?.parentElement;
      barItem?.classList.add("active");

      // Light the matching segment on the collapsed bar's mini scale, so the
      // bar reports position even while closed.
      if (barItem?.parentElement) {
        const index = Array.prototype.indexOf.call(
          barItem.parentElement.children,
          barItem,
        );
        document
          .querySelectorAll(".toc-bar__seg")
          [index]?.classList.add("active");
      }
    };

    let activeId: string | null = null;
    const syncActive = () => {
      const line = window.innerHeight * ACTIVE_LINE;
      let current: string | null = null;
      // Document order is vertical order, so the last one above the line wins.
      for (const heading of sections) {
        if (heading.getBoundingClientRect().top > line) break;
        current = heading.id;
      }
      // Above the first heading the reader is in the lede, which is no section:
      // `current` stays null and nothing is lit.
      if (current === activeId) return;
      activeId = current;
      setActive(current);
    };

    // The observer is only a cheap "something crossed, look again" signal — it
    // replaces a scroll listener, it does not hold the state. Its bottom edge
    // IS the reading line, so every crossing of that line wakes it in either
    // direction; the top margin just adds harmless extra wake-ups.
    observer = new IntersectionObserver(syncActive, {
      root: null,
      rootMargin: `-100px 0px -${Math.round((1 - ACTIVE_LINE) * 100)}% 0px`,
      threshold: 0,
    });

    sections.forEach((heading) => observer?.observe(heading));
    syncActive();

    // --- Occupy the slot the navbar vacates ---------------------------------
    // The header owns the scroll-direction logic (setupAutoHide in
    // Header.astro, site-wide on narrow screens). This just mirrors its state,
    // so the two can never disagree about which is on screen — one source of
    // truth, and no second scroll listener.
    const bar = document.querySelector<HTMLElement>("[data-toc-bar]");
    const header = document.querySelector<HTMLElement>("header.site-header");
    if (!bar || !header) return;
    const sheet = bar.querySelector<HTMLDetailsElement>(".toc-bar__sheet");

    const sync = () => {
      const navHidden = header.hasAttribute("data-nav-hidden");
      // When the navbar comes back it reclaims the slot, so an open sheet must
      // close with it — otherwise the panel stays pinned over the article with
      // the navbar sitting on top of it, and nothing dismisses it.
      if (!navHidden && sheet?.open) sheet.open = false;
      bar.toggleAttribute("data-toc-shown", navHidden);
    };

    const attrObserver = new MutationObserver(sync);
    attrObserver.observe(header, {
      attributes: true,
      attributeFilter: ["data-nav-hidden"],
    });

    // Tapping a section should land the reader on the content, not behind an
    // open panel.
    const onPick = (event: Event) => {
      if ((event.target as HTMLElement).closest("a") && sheet) {
        sheet.open = false;
      }
    };

    sync();
    sheet?.addEventListener("click", onPick);
    const disposeRail = cleanup;
    cleanup = () => {
      disposeRail?.();
      attrObserver.disconnect();
      sheet?.removeEventListener("click", onPick);
    };
  }

  initTOC();
  document.addEventListener("astro:after-swap", initTOC);
</script>
