---
export interface Props {
  headings: { depth: number; slug: string; text: string }[];
  mobile?: boolean;
  open?: boolean;
}

const { headings, mobile = false, open = false } = Astro.props;

// Filter headings to only include h2 and h3, and exclude the auto-generated
// GFM footnotes heading (slug "footnote-label") — Footnotes and References
// are both end-of-article reference material, not navigable article
// sections, so neither belongs in the Table of Contents. References has no
// heading element to begin with (see src/utils/numberCitations.ts), so only
// Footnotes needs an explicit exclude here.
const toc = headings.filter(
  (heading) =>
    heading.depth > 1 && heading.depth < 4 && heading.slug !== 'footnote-label',
);
---

{/* ---------------------------------------------------------------------------
   Desktop: a quiet outline in the LEFT gutter.

   Why left: <SideNote> margin notes are anchored prose — they must sit beside
   the sentence they annotate, and the right gutter is where the eye exits a
   line, so notes keep it. The ToC is global navigation with no per-sentence
   anchor, so it is positionally free; left is also the conventional home for a
   document outline. Splitting the two gutters means neither has to yield, and
   side notes no longer have to fade out on collision.

   Why so understated: left-aligned type in the left margin is the first thing
   the eye lands on, so weight that reads as "subtle" on the right reads as
   frontline on the left. At rest this is a column of ticks with faint labels —
   the article's shape, not a menu competing with the <h1>. The whole outline
   comes forward on hover/focus, and the current section stays legible
   throughout so position never depends on hovering.
--------------------------------------------------------------------------- */}
{
  !mobile && toc.length > 0 && (
    <nav class="toc-rail" aria-label="Table of contents">
      <div class="toc-inner">
        <ul class="toc-ticks">
          {toc.map((heading) => (
            <li class={`toc-tick depth-${heading.depth}`}>
              <a href={`#${heading.slug}`}>
                <span class="toc-tick__mark" aria-hidden="true" />
                <span class="toc-tick__label">{heading.text}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>
  )
}

{/* Mobile Inline Details — unchanged for now; replaced in a later stage. */}
{
  mobile && toc.length > 0 && (
    <details class="toc-mobile-details" {...(open ? { open: true } : {})}>
      <summary class="toc-mobile-summary">
        Table of Contents
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="icon icon-tabler icon-tabler-chevron-down"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
          fill="none"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path stroke="none" d="M0 0h24v24H0z" fill="none" />
          <polyline points="6 9 12 15 18 9" />
        </svg>
      </summary>
      <nav class="toc-mobile-content">
        <ul class="toc-list-mobile">
          {toc.map((heading) => (
            <li class={`toc-item-mobile depth-${heading.depth}`}>
              <a href={`#${heading.slug}`}>{heading.text}</a>
            </li>
          ))}
        </ul>
      </nav>
    </details>
  )
}

<style>
  /* ======================================================================
     DESKTOP — left-gutter outline
     ====================================================================== */
  .toc-rail {
    display: none;
  }

  @media (min-width: 1200px) {
    .toc-rail {
      display: block;
      position: absolute;
      /* Start the rail at the top of the PAGE, not the top of the prose column.
         A sticky child can never rise above its containing block, so while the
         rail began at the prose wrapper (~120px down) the outline rendered that
         far below its centered resting place and visibly slid up as the reader
         scrolled in. Extending the containing block upward — and adding the same
         amount back to the height so the bottom edge is unchanged — means the
         centered position is already reachable at scroll 0, so the outline is
         simply *there* on load. Measured in JS (--toc-rail-lift): the title
         block's height varies per post. */
      top: calc(-1 * var(--toc-rail-lift, 0px));
      /* Left gutter: sit just outside the prose column. The gutter is
         (100vw - 760px)/2 ≥ 220px at this breakpoint, so a labelled outline
         fits without crowding the text. */
      right: 100%;
      /* Wide enough that a long heading still fits on one line at the BOLD
         (active) weight — bold is ~8% wider than the resting weight. */
      width: min(230px, calc((100vw - 760px) / 2 - 32px));
      height: calc(100% + var(--toc-rail-lift, 0px));
      margin-right: 1.5rem;
      /* The sticky box spans the full viewport height so its contents can be
         centered; without this it would swallow clicks and text selection
         across the entire left margin. Only the links opt back in. */
      pointer-events: none;
    }
    .toc-tick a {
      pointer-events: auto;
    }

    /* Vertically CENTERED in the viewport rather than pinned under the navbar.
       Top-left is where the eye lands first, so an outline parked there competes
       with the <h1> and the opening paragraph; floating it to the middle of the
       margin keeps it findable without claiming that attention.

       Implemented by making the sticky box span the viewport and centering the
       list inside it — `top: 50%` + a translate would fight position:sticky,
       which needs a resolved offset to stick against. Full 100vh (not offset by
       the navbar) so the content lands on the TRUE vertical middle; offsetting
       would push it half the navbar's height low. */
    .toc-inner {
      position: sticky;
      top: 0;
      height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      text-align: right;
      /* No rule/eyebrow at rest — the ticks alone imply the margin. A border
         here reads as a panel edge and pulls focus toward the gutter. */
    }
    .toc-ticks {
      /* A very long outline still scrolls rather than overflowing the viewport. */
      max-height: calc(100vh - 9rem);
      overflow-y: auto;
    }
  }

  .toc-ticks {
    list-style: none;
    /* Both !important: this list lives inside .prose, whose global `ul` rule
       (`margin: 0 0 1.5rem; padding-left: 1.5rem`) otherwise wins. The bottom
       margin would be counted by later layout work, and the left padding inset
       every row 24px from the rail edge, leaving a dead strip beside the links. */
    padding: 0 !important;
    margin: 0 !important;
    display: flex;
    flex-direction: column;
    /* No flex gap: a gap is dead space between rows, so the pointer falls
       through the cracks. The rhythm comes from each link's own padding
       instead, which IS part of the hit area. */
  }

  .toc-tick {
    /* !important beats the global `.prose li { margin: 0.45rem 0 }` — that
       7.2px above and below each row was pure dead space between hit targets. */
    margin: 0 !important;
  }

  /* Full-width row = generous hit target, always present (no hover-to-reveal:
     hidden labels made the small ticks the only target, a precise pointer game
     that lost its own menu when you reached for a title). */
  .toc-tick a {
    display: flex;
    align-items: baseline;
    justify-content: flex-end;
    gap: 0.5rem;
    /* Spans the full rail width so the hit area reaches the rail's left edge. */
    width: 100%;
    /* Tight rhythm as PADDING rather than margins/gaps, so the space between
       labels is hoverable. Rows end up contiguous. */
    padding: 0.28rem 0;
    text-decoration: none;
    /* Quiet at rest: faint enough to read as marginalia rather than a menu. */
    color: color-mix(in srgb, var(--color-text-muted) 55%, transparent);
    transition: color 0.2s ease;
  }

  /* Line breaks are pre-computed at the BOLD width by a script (balanceLabels
     below) and baked in as explicit <br>s.

     The active row renders at weight 600, ~8% wider than the resting 400 —
     enough to tip a heading that just fit onto an extra line, reflowing the
     outline mid-scroll and shifting the other rows under the pointer. Baking
     the breaks in means the visible text occupies the same lines in either
     weight, so the weight can still change freely: the full heading is always
     shown (never truncated), and no line is ever added or removed. */
  .toc-tick__label {
    display: block;
    font-size: 0.78rem;
    line-height: 1.3;
    /* Breaks an over-long unbroken word rather than letting it escape the rail. */
    overflow-wrap: anywhere;
  }

  /* Tick doubles as depth cue and position marker; it is not the hit target. */
  .toc-tick__mark {
    flex: none;
    order: 2; /* after the label in the right-aligned row */
    width: 9px;
    height: 2px;
    border-radius: 1px;
    background: color-mix(in srgb, var(--color-border) 85%, transparent);
    transform: translateY(-0.25em);
    transition:
      background-color 0.2s ease,
      width 0.2s ease;
  }

  .toc-tick.depth-3 .toc-tick__label {
    font-size: 0.72rem;
  }
  .toc-tick.depth-3 .toc-tick__mark {
    width: 5px;
  }

  /* The whole outline comes forward when the reader engages with it. */
  .toc-rail:hover .toc-tick a,
  .toc-rail:focus-within .toc-tick a {
    color: var(--color-text-muted);
  }

  /* Scoped under .toc-rail so this outranks the rule above (0,3,1) — otherwise
     the rail-wide "bring everything forward" colour wins and the row you are
     actually pointing at never goes accent. */
  .toc-rail .toc-tick a:hover,
  .toc-rail .toc-tick a:focus-visible {
    color: var(--color-accent);
  }
  .toc-rail .toc-tick a:hover .toc-tick__mark,
  .toc-rail .toc-tick a:focus-visible .toc-tick__mark {
    background: var(--color-accent);
  }

  /* Reading position: legible at rest without shouting — the tick carries the
     accent, the label steps up to normal muted weight. */
  .toc-tick.active a {
    color: var(--color-text-muted);
    font-weight: 600;
  }
  .toc-rail:hover .toc-tick.active a,
  .toc-rail:focus-within .toc-tick.active a {
    color: var(--color-text-main);
  }
  .toc-tick.active .toc-tick__mark {
    background: var(--color-accent);
    width: 16px;
  }
  .toc-tick.active.depth-3 .toc-tick__mark {
    width: 10px;
  }

  /* ======================================================================
     MOBILE — inline dropdown (replaced in a later stage)
     ====================================================================== */
  .toc-mobile-details {
    /* Pull up under the title separator, which has ~2em of padding+margin below
       the <hr>; this tightens that gap without touching the global .title block. */
    margin-top: -0.5rem;
    margin-bottom: 1.5rem;
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
    background: var(--color-bg-offset);
  }

  @media (min-width: 1200px) {
    .toc-mobile-details {
      display: none;
    }
  }

  .toc-mobile-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.55rem 0.85rem;
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-main);
    cursor: pointer;
    list-style: none;
  }

  .toc-mobile-summary::-webkit-details-marker {
    display: none;
  }

  .toc-mobile-summary svg {
    transition: transform 0.3s ease;
  }

  .toc-mobile-details[open] .toc-mobile-summary svg {
    transform: rotate(180deg);
  }

  .toc-mobile-content {
    padding: 0.5rem 0.85rem;
    border-top: 1px solid var(--color-border);
  }

  /* Reset margins inherited from the global .prose ul/li rules. */
  .toc-list-mobile {
    display: flex;
    flex-direction: column;
    gap: 0;
    font-size: 0.86rem;
    line-height: 1.3;
    list-style: none;
    padding: 0 !important;
    margin: 0 !important;
  }

  .toc-item-mobile {
    margin: 0 !important;
  }

  .toc-item-mobile a {
    display: block;
    padding: 0.28rem 0 0.28rem 0.85rem;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .toc-item-mobile a:hover {
    color: var(--color-accent);
  }

  .toc-item-mobile.active a {
    color: var(--color-accent);
    font-weight: 500;
  }

  .toc-item-mobile.depth-3 {
    margin-left: 0.85rem !important;
    border-left: 1px solid var(--color-border);
  }
  .toc-item-mobile.depth-3 a {
    padding-left: 1rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .toc-tick__mark,
    .toc-tick a {
      transition: none;
    }
  }
</style>

<script>
  let observer: IntersectionObserver | undefined;
  let cleanup: (() => void) | undefined;

  function initTOC() {
    observer?.disconnect();
    cleanup?.();
    cleanup = undefined;

    // How far the prose column starts below the top of the page. The rail's
    // containing block is extended upward by this much (--toc-rail-lift) so its
    // sticky child can already sit at its centered resting position at scroll 0
    // instead of starting low and sliding up as the reader scrolls in. Measured
    // rather than hardcoded: the title block's height varies per post (title
    // length, category badges, optional hero image).
    const railEl = document.querySelector<HTMLElement>(".toc-rail");
    const measureLift = () => {
      if (!railEl) return;
      const wrapper = railEl.closest<HTMLElement>(".prose-wrapper");
      if (!wrapper) return;
      const lift = wrapper.getBoundingClientRect().top + window.scrollY;
      railEl.style.setProperty("--toc-rail-lift", `${Math.max(0, lift)}px`);
    };
    measureLift();

    // --- Freeze each label's line breaks at the BOLD width ------------------
    // Rather than bold everything (which throws away the active/inactive
    // distinction) or truncate (which hides the section names a ToC exists to
    // show), the wrap points are computed once at weight 600 and baked in as
    // explicit <br>s. The visible text then occupies the same lines in both
    // weights.
    const balanceLabels = () => {
      const labels = document.querySelectorAll<HTMLElement>(".toc-tick__label");

      for (const label of labels) {
        // Cache the pristine string on first sight; every later run re-breaks
        // from it, so repeated passes (resize, client-side nav) are idempotent
        // and can never compound their own inserted breaks. Whitespace is
        // normalised because <br>s round-trip through textContent as none.
        const text = (
          label.dataset.tocText ??
          label.textContent ??
          ""
        ).replace(/\s+/g, " ");
        label.dataset.tocText = text;

        // Budget = the row minus the tick and the flex gap. Measuring the
        // label's own box would be a feedback loop: after the first pass it
        // reports the width of the ALREADY-BROKEN text, so each run would wrap
        // it tighter until every label collapsed to a narrow column.
        const link = label.closest("a");
        const mark = link?.querySelector(".toc-tick__mark");
        if (!link) continue;
        const gap = parseFloat(getComputedStyle(link).columnGap) || 0;
        const width =
          link.getBoundingClientRect().width -
          (mark?.getBoundingClientRect().width ?? 0) -
          gap;
        if (width <= 0) {
          label.textContent = text;
          continue;
        }

        const probe = document.createElement("span");
        const cs = getComputedStyle(label);
        probe.style.cssText = `position:absolute;left:-9999px;top:0;visibility:hidden;white-space:pre;font:${cs.font};font-weight:600;letter-spacing:${cs.letterSpacing}`;
        document.body.appendChild(probe);
        const measure = (s: string) => {
          probe.textContent = s;
          return probe.getBoundingClientRect().width;
        };

        // A single word wider than the rail has no space to break at, and CSS
        // `overflow-wrap` would then break it at a weight-dependent point —
        // reintroducing the reflow. Split such words here so every break is
        // ours and therefore weight-independent. Each token records whether a
        // space precedes it, so a split word rejoins without gaining one.
        const tokens: { text: string; space: boolean }[] = [];
        for (const word of text.split(/\s+/).filter(Boolean)) {
          if (measure(word) <= width) {
            tokens.push({ text: word, space: true });
            continue;
          }
          let chunk = "";
          let first = true;
          for (const ch of word) {
            if (chunk && measure(chunk + ch) > width) {
              tokens.push({ text: chunk, space: first });
              first = false;
              chunk = ch;
            } else {
              chunk += ch;
            }
          }
          if (chunk) tokens.push({ text: chunk, space: first });
        }

        // Greedy line-breaking at the bold width — the same algorithm the
        // browser would apply, but pinned to weight 600 regardless of state.
        const lines: string[] = [];
        let line = "";
        for (const token of tokens) {
          const sep = line && token.space ? " " : "";
          const candidate = line + sep + token.text;
          if (line && measure(candidate) > width) {
            lines.push(line);
            line = token.text;
          } else {
            line = candidate;
          }
        }
        if (line) lines.push(line);
        probe.remove();

        label.textContent = "";
        lines.forEach((l, i) => {
          if (i) label.appendChild(document.createElement("br"));
          label.appendChild(document.createTextNode(l));
        });
      }
    };
    balanceLabels();
    // Exposed so the rail can be re-balanced after anything that changes the
    // available width or the heading text (also used by the visual tests).
    (window as unknown as { __tocBalance?: () => void }).__tocBalance =
      balanceLabels;

    const onResize = () => {
      measureLift();
      balanceLabels();
    };
    window.addEventListener("resize", onResize, { passive: true });
    cleanup = () => window.removeEventListener("resize", onResize);

    const observerCallback = (entries: IntersectionObserverEntry[]) => {
      entries.forEach((entry) => {
        const id = entry.target.getAttribute("id");
        if (!id || !entry.isIntersecting) return;

        const railLink = document.querySelector(`.toc-tick a[href="#${id}"]`);
        const mobileLink = document.querySelector(
          `.toc-item-mobile a[href="#${id}"]`,
        );

        document
          .querySelectorAll(".toc-tick, .toc-item-mobile")
          .forEach((item) => item.classList.remove("active"));

        railLink?.parentElement?.classList.add("active");
        mobileLink?.parentElement?.classList.add("active");
      });
    };

    observer = new IntersectionObserver(observerCallback, {
      root: null,
      rootMargin: "-100px 0px -60% 0px",
      threshold: 0,
    });

    document
      .querySelectorAll("h2, h3")
      .forEach((heading) => observer?.observe(heading));
  }

  initTOC();
  document.addEventListener("astro:after-swap", initTOC);
</script>
