---
// A margin/side note for articles (use in .mdx posts).
//
//   import SideNote from '../../components/SideNote.astro';
//   Some claim in the text.<SideNote>The aside floats in the right margin.</SideNote>
//
// Optional `label` overrides the "Note" heading:
//   <SideNote label="Aside">…</SideNote>
//
// On wide screens it floats into the right gutter, near where it appears in the
// text. On narrow screens it collapses to an indented inline block under the
// paragraph so nothing is lost on mobile.
//
// Optional `inline` forces the in-column (block) rendering at ALL widths — the
// note never floats into the gutter, even on wide screens:
//   <SideNote inline>A framing note that stays in the reading column.</SideNote>
// Use this for notes that are too long or too important to relegate to the
// margin (e.g. a framing paragraph).
//
// Notes own the RIGHT gutter outright: the Table of Contents sits in the LEFT
// gutter, so the two never compete. (This used to require a scroll-driven
// fade-out that dimmed notes whenever they met the ToC.)

interface Props {
  label?: string;
  inline?: boolean;
}

const { label = "Note", inline = false } = Astro.props;
---

<span class:list={["sidenote__body", { "sidenote__body--inline": inline }]} data-sidenote={inline ? "inline" : ""}>
  <span class="sidenote__head">
    <svg
      class="sidenote__icon"
      xmlns="http://www.w3.org/2000/svg"
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M12 20h9"></path>
      <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"></path>
    </svg>
    <span class="sidenote__label">{label}</span>
  </span>
  <span class="sidenote__content">
    <slot />
  </span>
</span>

<style>
  .sidenote__body {
    display: block;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--color-text-muted);
    text-align: left;
    /* Subtle card: faint accent-tinted background + left border so it pops a
       little without being loud. */
    background: color-mix(in srgb, var(--color-accent) 7%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-accent) 18%, transparent);
    border-left: 3px solid var(--color-accent);
    border-radius: 8px;
    padding: 0.65rem 0.8rem;
    /* Narrow screens (default): block aside under the paragraph. */
    margin: 0.7rem 0 0.95rem;
  }

  .sidenote__head {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-bottom: 0.4rem;
    color: var(--color-accent);
  }
  .sidenote__icon {
    flex-shrink: 0;
  }
  .sidenote__label {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
  }
  .sidenote__content {
    display: block;
  }

  /* Wide screens: float into the right gutter beside the 760px prose column.
     Only do this at >=1200px, where the gutter is actually wide enough for the
     negative margin — below that the -margin would push past the viewport edge,
     causing horizontal overflow (which also breaks the sticky navbar). */
  @media (min-width: 1200px) {
    .sidenote__body:not(.sidenote__body--inline) {
      float: right;
      clear: right;
      /* Target width, capped by the real gutter — (100vw - 760px column)/2,
         minus breathing room — so the note narrows near the 1200px breakpoint
         instead of clipping at the viewport edge. */
      --sidenote-width: min(266px, calc((100vw - 760px) / 2 - 34px));
      width: var(--sidenote-width);
      /* -(width + 32px gap) so it sits outside the column */
      margin: 0 calc(-1 * (var(--sidenote-width) + 32px)) 1rem 0;
      transition: opacity 0.2s ease;
    }
    /* `inline` notes keep the base in-column card even on wide screens. They read
       full-width in the prose column, so give them a touch more breathing room. */
    .sidenote__body--inline {
      margin: 1.1rem 0 1.3rem;
    }
  }
</style>

