---
// A margin/side note for articles (use in .mdx posts).
//
//   import SideNote from '../../components/SideNote.astro';
//   Some claim in the text.<SideNote>The aside floats in the right margin.</SideNote>
//
// Optional `label` overrides the "Note" heading:
//   <SideNote label="Aside">…</SideNote>
//
// On wide screens it floats into the right gutter, near where it appears in the
// text. On narrow screens it collapses to an indented inline block under the
// paragraph so nothing is lost on mobile.
//
// Optional `inline` forces the in-column (block) rendering at ALL widths — the
// note never floats into the gutter, even on wide screens:
//   <SideNote inline>A framing note that stays in the reading column.</SideNote>
// Use this for notes that are too long or too important to relegate to the
// margin (e.g. a framing paragraph).
//
// Notes own the RIGHT gutter outright: the Table of Contents sits in the LEFT
// gutter, so the two never compete. (This used to require a scroll-driven
// fade-out that dimmed notes whenever they met the ToC.)

interface Props {
  label?: string;
  inline?: boolean;
}

const { label = "Note", inline = false } = Astro.props;
---

<span class:list={["sidenote__body", { "sidenote__body--inline": inline }]} data-sidenote={inline ? "inline" : ""}>
  <span class="sidenote__head">
    <svg
      class="sidenote__icon"
      xmlns="http://www.w3.org/2000/svg"
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M12 20h9"></path>
      <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"></path>
    </svg>
    <span class="sidenote__label">{label}</span>
  </span>
  <span class="sidenote__content">
    <slot />
  </span>
</span>

<!-- Styles live in src/styles/global.css (.sidenote*), not here: the same rules
     serve BOTH this component and the `> [!aside]` / `> [!note]` callouts that
     remark-callout-components compiles from .md posts. One definition, so the
     two renderings cannot drift while both paths coexist. -->

