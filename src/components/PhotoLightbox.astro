---
// One shared expand-a-photo overlay for the page.
//
// Mounted ONCE per page, not once per photo: N entries would otherwise mean N
// identical overlays in the DOM and N scroll-lock owners fighting each other.
// Photos opt in with markup instead — any `[data-lightbox]` element carrying
// `data-lightbox-src` (and optional `data-lightbox-alt`) is openable, and one
// delegated listener on `document` covers every one of them, including any added
// after this script ran.
//
// Deliberately open/close only: no zoom, no pan, no next/prev. The job is "let
// me actually read the acceptance letter", which a bigger image solves on its
// own; the rest is interaction surface with no content behind it yet.
//
// The trigger markup is the caller's problem (see JournalUpdateEntry): it must
// be a real <button> so the affordance is keyboard-reachable and announced. This
// component owns only the overlay and the open/close behaviour.
---

<div id="photo-lightbox" class="pl-overlay" hidden>
  <div class="pl-backdrop" data-pl-dismiss></div>
  <div
    class="pl-panel"
    role="dialog"
    aria-modal="true"
    aria-label="Expanded photo"
  >
    <button id="pl-close" class="pl-close" type="button" aria-label="Close photo">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M18 6 6 18M6 6l12 12"></path>
      </svg>
    </button>
    {/* src is set at open time; empty until then so the page never fetches the
        large variant for a photo nobody expanded. */}
    <img id="pl-img" class="pl-img" src="" alt="" />
  </div>
</div>

<script>
  // Bound ONCE on document, which outlives #photo-lightbox across ClientRouter
  // swaps. The handlers re-resolve the live elements on every call rather than
  // closing over them, so a stale overlay from a previous page can't be held.
  (() => {
    const w = window as any;
    if (w.__photoLightboxBound) return;
    w.__photoLightboxBound = true;

    let lastFocused: Element | null = null;

    const els = () => ({
      overlay: document.getElementById("photo-lightbox"),
      img: document.getElementById("pl-img") as HTMLImageElement | null,
      close: document.getElementById("pl-close"),
    });

    function open(trigger: HTMLElement) {
      const { overlay, img, close } = els();
      if (!overlay || !img) return;
      const src = trigger.getAttribute("data-lightbox-src");
      if (!src) return;

      lastFocused = document.activeElement;
      img.src = src;
      img.alt = trigger.getAttribute("data-lightbox-alt") || "";
      overlay.hidden = false;
      // Scroll lock. Restored by clearing the inline style, NOT by writing a
      // value back: the stylesheet sets overflow-y: scroll on body to keep the
      // scrollbar gutter reserved, and hardcoding "visible" here would drop it
      // and shift the page by the scrollbar width on close.
      document.body.style.overflow = "hidden";
      close?.focus();
    }

    function dismiss() {
      const { overlay, img } = els();
      if (!overlay || overlay.hidden) return;
      overlay.hidden = true;
      document.body.style.overflow = "";
      // Drop the src so a closed overlay isn't holding a multi-megabyte decode
      // alive, and so reopening always starts from a clean load.
      if (img) {
        img.src = "";
        img.alt = "";
      }
      if (lastFocused instanceof HTMLElement) lastFocused.focus();
      lastFocused = null;
    }

    document.addEventListener("click", (e) => {
      const target = e.target as Element | null;
      const trigger = target?.closest?.("[data-lightbox]") as HTMLElement | null;
      if (trigger) {
        e.preventDefault();
        open(trigger);
        return;
      }
      // Backdrop and close button both dismiss. The panel itself does not, so a
      // click that lands on the photo keeps it open.
      if (target?.closest?.("[data-pl-dismiss], #pl-close")) dismiss();
    });

    document.addEventListener("keydown", (e) => {
      const { overlay, close } = els();
      if (!overlay || overlay.hidden) return;
      if (e.key === "Escape") {
        e.preventDefault();
        dismiss();
        return;
      }
      // Focus trap. The dialog holds exactly one focusable (the close button),
      // so Tab in either direction returns to it rather than escaping to the
      // page behind — no ordered focusables array to maintain.
      if (e.key === "Tab") {
        e.preventDefault();
        (close as HTMLElement | null)?.focus();
      }
    });

    // A client-side nav away from the page must not leave the body scroll-locked
    // by an overlay that is being swapped out from under us.
    document.addEventListener("astro:before-swap", () => {
      document.body.style.overflow = "";
      lastFocused = null;
    });
  })();
</script>

<style>
  .pl-overlay {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    place-items: center;
    padding: clamp(1rem, 4vw, 3rem);
  }
  /* `hidden` on a grid container is overridden by display: grid, so restate it.
     Attribute rather than a class so the element's own hidden state is the
     single source of truth for both CSS and the script. */
  .pl-overlay[hidden] {
    display: none;
  }
  .pl-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(9, 14, 24, 0.82);
    /* No blur: the backdrop covers a photo-heavy page, and backdrop-filter over
       a full-viewport area is the one effect that reliably drops frames on the
       older iPhones this site is otherwise smooth on. */
  }
  .pl-panel {
    position: relative;
    max-width: 100%;
    max-height: 100%;
    display: flex;
  }
  .pl-img {
    display: block;
    max-width: 100%;
    /* Bounded by the viewport minus the overlay padding, so a tall portrait
       photo (emory-cap is square, 3024px) can never overflow off-screen. */
    max-height: calc(100vh - 2 * clamp(1rem, 4vw, 3rem));
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 6px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.5);
  }
  .pl-close {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    padding: 0;
    border: none;
    border-radius: 50%;
    cursor: pointer;
    color: #fff;
    background: rgba(9, 14, 24, 0.62);
    transition: background-color 0.2s ease;
  }
  .pl-close:hover {
    background: rgba(9, 14, 24, 0.85);
  }
  /* The overlay is the same dark slab in both themes, so the ring is spelled
     against IT rather than inheriting --color-accent, which is tuned for the
     page background and goes muddy on this one. */
  .pl-close:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }
</style>
