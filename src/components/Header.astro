---
import HeaderLink from "./HeaderLink.astro";
import { CV_URL, SITE_TITLE } from "../consts";
import { CV_AVAILABLE } from "../utils/cv";
import { url } from "../utils/paths";
import logoSvg from "../../public/logo.svg?raw";

const cvHref = CV_AVAILABLE && CV_URL ? url(CV_URL) : null;

// The logo is a two-tone mark: the integral sign + "e" (the .cls-1 paths, #6cf)
// and the pink "f" glyphs (.cls-2). Each symbol gets its own neon glow, applied
// as a `filter: drop-shadow()`. Safari/WebKit doesn't reliably render `filter`
// on inner SVG nodes (paths/groups), so instead of one SVG with per-path
// filters we split the mark into two stacked <svg> layers — one per color — and
// filter the <svg> ELEMENT, which every browser handles. The two share the same
// viewBox so they overlay pixel-perfectly.
const stripped = logoSvg
  .replace(/<\?xml[^>]*>\s*/, "")
  // The integral/e is recolored via a CSS var so it can follow the theme; the
  // pink glyphs become the theme's "hot mark" so the logo matches the sim's jr
  // spark and the accent language in each theme. Match fill/stroke, with or w/o #.
  .replaceAll("#6cf", "var(--brand-logo-primary)")
  .replaceAll("#00deff", "var(--brand-logo-primary)")
  .replaceAll("#ff49ff", "var(--color-hot)");

// Keep only the <path> elements whose class matches `cls`, leaving <defs> (the
// shared <style>) and the <svg> wrapper intact so each layer renders identically
// to its slice of the original.
const layerFor = (keep: "cls-1" | "cls-2") =>
  stripped.replace(/<path\b[^>]*class="(cls-\d)"[^>]*\/>\s*/g, (m, cls) =>
    cls === keep ? m : "",
  );

const brandLayerPrimary = layerFor("cls-1");
const brandLayerSecondary = layerFor("cls-2");
---

<header class="site-header">
  <nav>
    <div class="brand-heading">
      <a href={url("/")} class="brand" aria-label={`${SITE_TITLE} — home`}>
        <span class="brand-logo" aria-hidden="true">
          <span class="brand-layer brand-layer-primary">
            <Fragment set:html={brandLayerPrimary} />
          </span>
          <span class="brand-layer brand-layer-secondary">
            <Fragment set:html={brandLayerSecondary} />
          </span>
        </span>
      </a>
    </div>

    <div class="internal-links" transition:persist="internal-links">
      <HeaderLink href={url("/")}>Home</HeaderLink>
      <HeaderLink href={url("/journal")}>Journal</HeaderLink>
      <HeaderLink href={url("/projects")}>Projects</HeaderLink>
      <HeaderLink href={url("/research")}>Research</HeaderLink>
      <HeaderLink href={url("/about")}>About</HeaderLink>
      <span class="nav-underline" aria-hidden="true"></span>
    </div>

    <div class="header-actions">
      {
        cvHref && (
          <a
            href={cvHref}
            target="_blank"
            rel="noopener noreferrer"
            class="github-link"
            aria-label="Download CV"
            title="Download CV"
            data-umami-event="cv-download"
            data-umami-event-location="navbar-icon"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <>
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                <polyline points="14 2 14 8 20 8" />
                <line x1="16" y1="13" x2="8" y2="13" />
                <line x1="16" y1="17" x2="8" y2="17" />
                <polyline points="10 9 9 9 8 9" />
              </>
            </svg>
          </a>
        )
      }
      <button
        id="search-toggle-desktop"
        class="search-toggle"
        aria-label="Search site"
        aria-haspopup="dialog"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><circle cx="11" cy="11" r="8"></circle><line
            x1="21"
            y1="21"
            x2="16.65"
            y2="16.65"></line></svg
        >
      </button>
      <button
        id="theme-toggle"
        aria-label="Toggle dark mode"
        aria-pressed="false"
      >
        <svg
          class="sun-icon"
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><circle cx="12" cy="12" r="5"></circle><line
            x1="12"
            y1="1"
            x2="12"
            y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line
            x1="4.22"
            y1="4.22"
            x2="5.64"
            y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"
          ></line><line x1="1" y1="12" x2="3" y2="12"></line><line
            x1="21"
            y1="12"
            x2="23"
            y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"
          ></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg
        >
        <svg
          class="moon-icon"
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
          ></path></svg
        >
      </button>

      <button
        id="menu-toggle"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><line x1="3" y1="12" x2="21" y2="12"></line><line
            x1="3"
            y1="6"
            x2="21"
            y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg
        >
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="mobile-menu hidden">
    <div class="mobile-menu-header">
      <span class="mobile-menu-title">Menu</span>
      <button
        id="search-toggle-mobile"
        class="search-toggle"
        aria-label="Search site"
        aria-haspopup="dialog"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><circle cx="11" cy="11" r="8"></circle><line
            x1="21"
            y1="21"
            x2="16.65"
            y2="16.65"></line></svg
        >
      </button>
    </div>
    <a href={url("/")}>Home</a>
    <a href={url("/journal")}>Journal</a>
    <a href={url("/projects")}>Projects</a>
    <a href={url("/research")}>Research</a>
    <a href={url("/about")}>About</a>
    {
      cvHref && (
        <a
          href={cvHref}
          target="_blank"
          data-umami-event="cv-download"
          data-umami-event-location="navbar-menu"
        >
          Download CV
        </a>
      )
    }
  </div>
</header>

<script>
  let headerControlsAbort: AbortController | null = null;

  function setupHeaderControls() {
    if (headerControlsAbort) headerControlsAbort.abort();
    headerControlsAbort = new AbortController();
    const { signal } = headerControlsAbort;

    const themeToggle = document.getElementById("theme-toggle");
    // Reflect the current theme in aria-pressed ("dark" = pressed) on setup, so
    // it's correct after the FOUC script / system preference resolves it.
    const syncThemePressed = () => {
      const isDark =
        document.documentElement.getAttribute("data-theme") === "dark";
      themeToggle?.setAttribute("aria-pressed", String(isDark));
    };
    syncThemePressed();
    themeToggle?.addEventListener(
      "click",
      () => {
        const isDark =
          document.documentElement.getAttribute("data-theme") === "dark";
        const newTheme = isDark ? "light" : "dark";
        (window as any).__setPreferredTheme?.(newTheme);
        localStorage.setItem("theme", newTheme);
        themeToggle.setAttribute("aria-pressed", String(!isDark));
      },
      { signal },
    );

    const menuToggle = document.getElementById("menu-toggle");
    menuToggle?.addEventListener(
      "click",
      () => {
        const menu = document.getElementById("mobile-menu");
        const nowHidden = menu?.classList.toggle("hidden");
        // aria-expanded is the inverse of hidden.
        menuToggle.setAttribute("aria-expanded", String(!nowHidden));
      },
      { signal },
    );

    document.querySelectorAll(".search-toggle").forEach((btn) => {
      btn.addEventListener(
        "click",
        () => {
          document.dispatchEvent(new CustomEvent("open-search"));
        },
        { signal },
      );
    });

    setupNavUnderline(signal);
    setupAutoHide(signal);
  }

  // Auto-hiding navbar on narrow screens (site-wide). Scrolling DOWN retracts
  // the header; scrolling UP brings it back — the familiar mobile-browser
  // URL-bar behavior. Vertical space is scarce on phones and the nav isn't
  // needed while reading; on wide screens there is room to spare, so the header
  // stays pinned and this does nothing.
  //
  // Journal posts layer their Table of Contents into the vacated slot (see
  // TableOfContents.astro), which listens for the same attribute.
  function setupAutoHide(signal: AbortSignal) {
    const header = document.querySelector<HTMLElement>("header.site-header");
    if (!header) return;
    // Pages with their own sticky bar parked directly under the navbar (the
    // Journal filter bar) opt out: that bar is offset by the navbar's height,
    // so retracting the navbar would leave it floating below a gap. Those pages
    // keep the plain sticky header.
    if (document.querySelector(".j-filters-bar")) return;
    const narrow = window.matchMedia("(max-width: 1199px)");
    // Ignore sub-pixel drift and iOS rubber-banding so it can't flicker.
    const DEADZONE = 6;
    // Above this the header always shows: at the top of a page the nav is the
    // primary affordance, and hiding it there feels broken.
    const ENGAGE_AT = 260;

    let lastY = window.scrollY;
    let ticking = false;

    const apply = (hide: boolean) => {
      // Never retract out from under an open mobile menu — it is anchored to
      // the header, so hiding the header would strand the panel.
      const menuOpen = !document
        .getElementById("mobile-menu")
        ?.classList.contains("hidden");
      header.toggleAttribute("data-nav-hidden", hide && !menuOpen);
    };

    const update = () => {
      ticking = false;
      if (!narrow.matches) return apply(false);
      const y = window.scrollY;
      const delta = y - lastY;
      if (Math.abs(delta) < DEADZONE) return;
      lastY = y;
      if (y < ENGAGE_AT) return apply(false);
      apply(delta > 0);
    };

    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };

    update();
    window.addEventListener("scroll", onScroll, { passive: true, signal });
    narrow.addEventListener("change", update, { signal });
    // Leaving a page mid-retraction would persist the hidden state.
    signal.addEventListener("abort", () =>
      header.removeAttribute("data-nav-hidden"),
    );
  }

  // Sliding underline under the active nav link. The `.internal-links`
  // container persists across client-side navigations (transition:persist), so
  // the same underline element survives the swap and animates from the old
  // link's position to the new one.
  function setupNavUnderline(signal: AbortSignal) {
    const nav = document.querySelector<HTMLElement>(".internal-links");
    const underline = nav?.querySelector<HTMLElement>(".nav-underline");
    if (!nav || !underline) return;

    const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>("a"));

    const normalize = (path: string) => {
      const noBase = path.replace(/\/+$/, "");
      return noBase === "" ? "/" : noBase;
    };
    const here = normalize(location.pathname);

    // Find the link matching the current URL (longest matching prefix wins so
    // e.g. /journal/some-post highlights "Journal").
    let active: HTMLAnchorElement | null = null;
    let bestLen = -1;
    for (const a of links) {
      const target = normalize(new URL(a.href).pathname);
      const matches =
        target === here || (target !== "/" && here.startsWith(target + "/"));
      if (matches && target.length > bestLen) {
        bestLen = target.length;
        active = a;
      }
    }
    // Exact home match only (so "/" doesn't win on every page).
    if (here === "/") {
      active =
        links.find((a) => normalize(new URL(a.href).pathname) === "/") || active;
    }

    links.forEach((a) => a.classList.toggle("active", a === active));

    const moveTo = (el: HTMLElement | null, animate: boolean) => {
      if (!el) {
        underline.classList.remove("is-visible");
        return;
      }
      const navRect = nav.getBoundingClientRect();
      const rect = el.getBoundingClientRect();
      underline.classList.toggle("no-anim", !animate);
      underline.style.setProperty("--underline-x", `${rect.left - navRect.left}px`);
      underline.style.setProperty("--underline-width", `${rect.width}px`);
      underline.classList.add("is-visible");
    };

    // Position the underline under the active link on (re)init. Animate the move
    // only when the underline already carried a position AND it's now landing on
    // a DIFFERENT link than it last rested on — i.e. a real navigation moved the
    // active page (e.g. clicking "View Research" outside the navbar). When the
    // bar is already under the active link (the common navbar-click case, where
    // hover glided it there before the click), there's nothing to animate, so we
    // leave it put and never bounce it. On a true first load it has no prior
    // position, so we snap.
    const prevX = underline.style.getPropertyValue("--underline-x");
    const hadPosition =
      underline.classList.contains("is-visible") &&
      underline.style.getPropertyValue("--underline-width") !== "";
    // Compute where active sits now, to decide animate vs. already-there.
    const navRect0 = nav.getBoundingClientRect();
    const activeX = active
      ? `${active.getBoundingClientRect().left - navRect0.left}px`
      : "";
    const moved = hadPosition && activeX !== "" && activeX !== prevX;

    moveTo(active, moved);
    if (!moved) {
      // Snapped (first load, or already in place): flush with transitions off,
      // then re-enable so hover still animates.
      void underline.offsetWidth;
      underline.classList.remove("no-anim");
    }

    // Follow hover, snap back to active on leave. Skip the leave-snap while a
    // navigation is in flight (pointer leaves the bar as the page swaps), so the
    // bar doesn't bounce to the old active mid-navigation.
    let navigating = false;
    links.forEach((a) => {
      a.addEventListener("mouseenter", () => moveTo(a, true), { signal });
      a.addEventListener(
        "click",
        () => {
          navigating = true;
        },
        { signal },
      );
    });
    nav.addEventListener(
      "mouseleave",
      () => {
        if (!navigating) moveTo(active, true);
      },
      { signal },
    );

    // Reposition on resize (widths change → line would drift).
    window.addEventListener(
      "resize",
      () => moveTo(nav.querySelector<HTMLElement>("a.active"), false),
      { signal },
    );
  }

  setupHeaderControls();
  document.addEventListener("astro:page-load", setupHeaderControls);
</script>

<style>
  header {
    margin: 0;
    padding: 0 1em;
    background-color: var(--color-bg-header);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    position: sticky;
    top: 0;
    z-index: 100;
    transition: background-color 0.3s ease;
    /* During a ClientRouter view-transition swap, the page captures old/new
       snapshots into a top-layer overlay where the normal z-index above is
       meaningless. <main> is named (transition:animate), so its group would
       paint ABOVE the unnamed root group that holds this header — for one frame
       the content snapshot flashes over the navbar (Chrome/Firefox; Safari
       skips this compositing). Giving the header its own named group lets us
       force its paint order above main's via ::view-transition-group below. */
    view-transition-name: site-header;
  }

  /* Auto-hide on narrow screens: retracts on scroll-down, returns on scroll-up
     (set by setupAutoHide above; only ever applied below 1200px). On Journal posts
     the Table of Contents slides into the vacated slot. */
  header[data-nav-hidden] {
    transform: translateY(-100%);
  }
  header {
    transition:
      background-color 0.3s ease,
      transform 0.28s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    header {
      transition: background-color 0.3s ease;
    }
  }

  header::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      var(--color-border) 20%,
      var(--color-border) 80%,
      transparent 100%
    );
    opacity: 0.6;
  }

  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: var(--max-width);
    margin: 0 auto;
    height: 4.5rem;
    /* Anchor for the absolutely-centered nav menu. */
    position: relative;
  }
  /* Site brand — a link, not a document heading (keeps the page heading outline
     starting at the page's own <h1>). Styled to look like the former <h2>. */
  .brand-heading {
    margin: 0;
    font-size: 1.3em;
    font-family: var(--font-sans);
    font-weight: 700;
    letter-spacing: -0.02em;
    border-bottom: none;
    padding-bottom: 0;
    display: flex;
    align-items: center;
  }
  .brand-heading a {
    text-decoration: none;
    color: var(--color-text-main);
    border: none;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    line-height: 1;
  }
  .brand:hover {
    opacity: 1;
    text-decoration: none;
  }
  .brand-logo {
    position: relative;
    display: inline-flex;
    width: 2.7rem;
    height: 2.7rem;
    flex-shrink: 0;
    /* Integral sign + "e" color: black in light mode, theme cyan in dark. */
    --brand-logo-primary: #000;
    /* Neon-glow colors per symbol. The cyan/primary glow follows the theme;
       in light mode the symbol is black, so we glow with the theme cyan
       rather than black so it actually reads as light. */
    --brand-glow-primary: #77a4f5;
    /* Glow for the hot glyphs — tracks the theme's hot mark so it matches the
       recolored glyph (var(--color-hot)) in both light and dark. */
    --brand-glow-secondary: var(--color-hot);
  }
  /* The two color layers stack so they overlay pixel-perfectly (shared viewBox).
     The first is in normal flow to size the box; the second is absolutely
     positioned on top. */
  .brand-layer {
    display: inline-flex;
    width: 100%;
    height: 100%;
  }
  .brand-layer-secondary {
    position: absolute;
    inset: 0;
  }
  .brand-layer :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
    /* An <svg> clips to its viewBox by default, which would chop the
       drop-shadow glow at the artwork's edges. Let it paint outside the
       viewport so the halo can spread. */
    overflow: visible;
  }
  :global(html[data-theme="dark"]) .brand-logo {
    --brand-logo-primary: var(--color-accent);
    --brand-glow-primary: var(--color-accent);
  }

  /* Neon-tube hover glow: each symbol emits its own color via stacked
     drop-shadows (tight bright core + softer outer halo). The filter is applied
     to each layer's <svg> ELEMENT (not its inner paths) because Safari/WebKit
     doesn't reliably render `filter` on inner SVG nodes. Splitting the mark into
     two color layers keeps the two-tone glow while staying Safari-safe. */
  .brand-layer :global(svg) {
    transition: filter 0.3s ease;
  }
  .brand:hover .brand-layer-primary :global(svg) {
    filter: drop-shadow(0 0 6px var(--brand-glow-primary))
      drop-shadow(0 0 16px var(--brand-glow-primary));
  }
  .brand:hover .brand-layer-secondary :global(svg) {
    filter: drop-shadow(0 0 6px var(--brand-glow-secondary))
      drop-shadow(0 0 16px var(--brand-glow-secondary));
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-layer :global(svg) {
      transition: none;
    }
  }

  .internal-links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    /* Centered in the nav independent of the (uneven) brand/action widths on
       either side: taken out of flow and pinned to the nav's true horizontal
       center. The sliding underline positions itself against the live rects of
       these links, so it still tracks correctly. */
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    /* Glow color for nav links + underline. In light mode the accent is a dark
       navy that wouldn't read as a glow, so glow with the brighter accent
       blue; in dark mode the accent itself is bright enough. */
    --nav-glow: #77a4f5;
  }
  :global(html[data-theme="dark"]) .internal-links {
    --nav-glow: var(--color-accent);
  }
  .internal-links :global(a) {
    padding: 0.5em 0.75em;
    color: var(--color-text-main);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    transition:
      color 0.2s ease,
      text-shadow 0.2s ease;
  }
  /* Active link takes the accent color (the sliding underline marks it); no
     glow unless hovered. */
  .internal-links :global(a.active) {
    color: var(--color-accent);
  }
  /* Neon glow only on hover, matching the logo's accent-colored glow. */
  .internal-links :global(a:hover) {
    color: var(--color-accent);
    text-shadow:
      0 0 6px var(--nav-glow),
      0 0 14px var(--nav-glow);
  }

  /* Shared underline that slides between links. JS positions it via custom
     props; the transition makes it glide from the old link to the new one. */
  .nav-underline {
    position: absolute;
    bottom: 0;
    left: 0;
    height: 2px;
    width: var(--underline-width, 0);
    transform: translateX(var(--underline-x, 0));
    background-color: var(--color-accent);
    border-radius: 2px;
    box-shadow:
      0 0 6px var(--nav-glow),
      0 0 12px var(--nav-glow);
    opacity: 0;
    transition:
      transform 0.3s cubic-bezier(0.4, 0, 0.2, 1),
      width 0.3s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.2s ease;
    pointer-events: none;
  }
  .nav-underline.is-visible {
    opacity: 1;
  }
  /* Skip the slide animation on first paint (before any nav happens) so the
     underline appears already in place rather than flying in from the left. */
  .nav-underline.no-anim {
    transition: opacity 0.2s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-underline {
      transition: opacity 0.2s ease;
    }
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    /* Glow color for the action icons, mirroring the nav links. Light-mode
       accent is too dark to read as a glow, so use the brighter blue there. */
    --nav-glow: #77a4f5;
  }
  :global(html[data-theme="dark"]) .header-actions {
    --nav-glow: var(--color-accent);
  }

  .search-toggle,
  #theme-toggle {
    background: transparent;
    border: none;
    cursor: pointer;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
