---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import HeroSim from "../components/HeroSim.astro";
// TABLED (2026-07): the equation coda is not rendered for now — component
// kept intact at src/components/EquationCoda.astro; re-enable by restoring
// this import and the <EquationCoda /> tag before </main>.
// import EquationCoda from "../components/EquationCoda.astro";
import { SITE_TITLE, SITE_DESCRIPTION, CONTACT, CV_URL, SOCIAL_LINKS } from "../consts";
import { url } from "../utils/paths";
import { pageFade } from "../utils/pageTransition";
import {
  getPublishedPosts,
  getPublishedProjects,
  getPublishedResearch,
  postLink,
} from "../utils/posts";
import { CV_AVAILABLE } from "../utils/cv";
import { renderInline } from "../utils/inlineText";
import { ESSAY_SUBJECT_COLORS } from "../utils/categories";

// Subject accent for the "From the Journal" lead rows only — the rail below
// stays entirely monochrome, so the colour marks the curated picks rather than
// becoming a second system on the page.
//
// Essays carry a `subject` (Science/Math/Ideas); a notebook pick shows its
// `topic` instead. The colour must key off the CATEGORY, not the label text:
// "A picture proof of the product rule" is a note with topic "Math", and
// matching that string against the essay subjects painted it in the Math-essay
// purple, so a note read as an essay. Notes take the notebook register colour
// whatever their topic is called. Returns a theme-flipping CSS var, so
// light/dark are handled by global.css.
const subjectLabel = (post: {
  data: { category: string; subject?: string; topic?: string };
}) =>
  post.data.category === "essays"
    ? (post.data.subject ?? null)
    : (post.data.topic ?? null);
const subjectColor = (post: {
  data: { category: string; subject?: string; topic?: string };
}) => {
  const subject = post.data.subject;
  return post.data.category === "essays" &&
    subject &&
    ESSAY_SUBJECT_COLORS[subject]
    ? `var(--subj-${subject})`
    : `var(--cat-${post.data.category})`;
};

const allPosts = (await getPublishedPosts()).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
// Front-page split by Journal register: a hand-curated pair of prose pieces
// (essays or notebook, via `featured` in frontmatter) leads alongside
// Research; notebook notes and short announcements go to the rail as compact
// title-only lists. Falls back to the newest prose posts if nothing is
// flagged, so the section can't go empty.
const prosePool = allPosts.filter((p) => p.data.category !== "updates");
// Numeric `featured` values rank the lead explicitly (1 = first); boolean
// `true` entries follow, newest-first (prosePool is already date-sorted and
// .sort() is stable).
const rank = (p: (typeof prosePool)[number]) =>
  typeof p.data.featured === "number" ? p.data.featured : Infinity;
const featuredProse = prosePool
  .filter((p) => p.data.featured)
  .sort((a, b) => rank(a) - rank(b));
const journalLead = (featuredProse.length > 0 ? featuredProse : prosePool).slice(
  0,
  3,
);
// Rail lists. The Notebook group skips anything already featured in the lead
// so a flagged note never appears twice on the page.
const leadIds = new Set(journalLead.map((p) => p.id));
const notebookPosts = allPosts
  .filter((p) => p.data.category === "notebook" && !leadIds.has(p.id))
  .slice(0, 3);
const updatePosts = allPosts
  .filter((p) => p.data.category === "updates")
  .slice(0, 3);

// Same order convention as /projects (src/pages/projects.astro): manual `order`
// pins entries first (ascending), the rest fall back to reverse-chronological.
// getPublishedProjects() only filters drafts — it does not sort — so this must
// be duplicated here to make the strip a true preview of the Projects page.
const projects = (await getPublishedProjects())
  .sort((a, b) => {
    const ao = a.data.order,
      bo = b.data.order;
    if (ao != null && bo != null) return ao - bo;
    if (ao != null) return -1;
    if (bo != null) return 1;
    return (
      b.data.date.valueOf() - a.data.date.valueOf() ||
      a.id.localeCompare(b.id)
    );
  })
  .slice(0, 3);

const allResearch = (await getPublishedResearch()).sort(
  (a, b) =>
    b.data.date.valueOf() - a.data.date.valueOf() || a.id.localeCompare(b.id),
);
const selectedResearch = (
  allResearch.filter((r) => r.data.selected).length > 0
    ? allResearch.filter((r) => r.data.selected)
    : allResearch
).slice(0, 3);

const contactEmail = CONTACT.emails[0];
const linkedin = SOCIAL_LINKS.find((l) => l.icon === "linkedin");
const cvHref = CV_AVAILABLE && CV_URL ? url(CV_URL) : null;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <script is:inline>
      (() => {
        // Play the intro on a FULL page load (fresh visit, hard refresh, or
        // opening the site in a new tab) — but NOT when the user navigates back
        // to home via client-side routing (ClientRouter swap), since that's not
        // a "real" arrival. This inline script in <head> only executes on a true
        // document parse; ClientRouter swaps re-run scripts via astro:page-load,
        // not by re-parsing <head>, so the window flag below distinguishes them:
        // it's undefined on a fresh document and set once the intro has fired.
        const root = document.documentElement;
        try {
          if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
          if (window.__homeIntroPlayed) return; // already played this session
          window.__homeIntroPlayed = true;
          root.setAttribute("data-home-intro", "pending");
        } catch {}
      })();
    </script>
    <style>
      /* ============================================================
         PINNED-SCRUB HERO
         Two stacked layers (sim + card) inside a sticky stage. A tall spacer
         section gives the scroll distance; JS writes --hero-progress (0..1) onto
         .hero-scroll as you scroll through it, and the layers crossfade. Only
         one is ever visible. --header-h matches the sticky nav height.
         ============================================================ */
      .hero-scroll {
        --header-h: 4.5rem;
        /* Total pinned scroll distance. The first ~80% is the TRANSITION
           (progress 0→1, the choreography below); the last ~20% is a LIVE
           HOLD — the finished card stays pinned but keeps drifting gently
           upward (--hero-hold below), so a fast flick can't blow through the
           card yet every scroll pixel still produces visible motion (a dead
           hold reads as lag). The 80/20 split is HOLD_FRACTION in
           initHeroScroll; keep them in sync. */
        /* --hero-svh = 1% of the small viewport, LOCKED to px by JS at init
           (recomputed only on width change). Safari's svh is already static,
           but iOS Brave/Firefox report svh dynamically as their toolbars
           collapse — every svh-sized hero box then resizes with the URL bar,
           shoving the whole page (the 2026-07 "page jumps on bar resize" bug).
           The 1svh fallback covers SSR/no-JS. */
        --hero-travel: calc(var(--hero-svh, 1svh) * 115);
        --hero-progress: 0;
        /* 0→1 across the hold segment; drives the card's slow drift. */
        --hero-hold: 0;
        /* ---- Choreography bands ----
           Each element of the transition gets its own window on the progress
           timeline (0 → not started, 1 → done), instead of one uniform
           crossfade: the gas evaporates first, the photo condenses in from
           the right, then the copy builds line by line (tick → name → bio →
           links). The blueprint grid is NOT faded at all — the stage stays
           while its contents transform. The stacked fallbacks (mobile,
           reduced-motion) pin every band to its end state. */
        /* Bands OVERLAP so the timeline has no empty trough: the gas lingers
           to p=0.5 while the photo starts at 0.2 — around p≈0.35–0.45
           something is always at meaningful presence (previously the gas died
           at 0.4 before the copy started at 0.48, leaving ~2 near-blank
           tenths of blueprint grid on a slow scroll). */
        --b-gas: clamp(0, calc(1 - var(--hero-progress) / 0.5), 1);
        --b-photo: clamp(0, calc((var(--hero-progress) - 0.2) / 0.38), 1);
        --b-eyebrow: clamp(0, calc((var(--hero-progress) - 0.44) / 0.14), 1);
        --b-tick: clamp(0, calc((var(--hero-progress) - 0.48) / 0.12), 1);
        --b-name: clamp(0, calc((var(--hero-progress) - 0.51) / 0.2), 1);
        --b-bio: clamp(0, calc((var(--hero-progress) - 0.59) / 0.19), 1);
        --b-links: clamp(0, calc((var(--hero-progress) - 0.67) / 0.17), 1);
        position: relative;
        height: calc(var(--hero-svh, 1svh) * 100 - var(--header-h) + var(--hero-travel));
        /* Visible overflow so HeroSim's full-bleed canvas/grid feather past the
           content column (mobile re-clips below). */
        overflow-x: visible;
      }
      :global(html),
      :global(body) {
        overflow-x: clip;
      }
      :global(html[data-home-intro]) {
        /* Lock the vertical axis during the intro but KEEP the scrollbar track
           (overflow-y stays `scroll` from the html rule), so the page width never
           changes when the intro ends. We block actual scrolling by pinning the
           scroll position via JS (see initHomeIntro), not by hiding overflow —
           hiding it would remove the track and shift the layout. Horizontal is
           clipped so the full-bleed hero can't cause a sideways scrollbar. */
        overflow-x: clip;
        /* ---- Intro timeline knobs ----
           Phase 1  navbar fades in       [0 .. NAV_FADE]
           Phase 2  navbar neon flicker    [NAV_FADE .. +GLOW]   (in series w/ P1)
           Phase 3  simulation fades+flicks[SIM_AT .. +SIM]      (INDEPENDENT —
                    may start any time, including mid-Phase-2; see --intro-sim-at)
           The JS removes data-home-intro after the LATEST phase completes. */
        --intro-nav-fade: 1.1s; /* phase 1: nav fade-in (slow + dramatic) */
        --intro-glow-dur: 1.3s; /* phase 2: nav flicker (after fade-in) */
        --intro-sim-dur: 0.7s; /* phase 3: sim grid+canvas flicker-in */
        /* Phase 2 starts shortly BEFORE the fade fully finishes (the nav is
           already mostly visible by then), trimming the dead gap between the
           fade-in and the flicker. Lower the offset to overlap more. */
        --intro-glow-at: calc(var(--intro-nav-fade) - 0.35s);
        /* --intro-sim-at: WHEN the simulation phase begins, as an ABSOLUTE time
           from page load. It no longer has to wait for Phase 2 to finish — set it
           to whatever you like and the sim (gas fade + name flicker) will start
           there, even mid-Phase-2. The gas fade-in (CSS) and the name-activation
           flicker (HeroSim reads this same var) both key off it, so they stay in
           sync. The default below = start right when the nav flicker begins
           (overlapping all of Phase 2); raise it to delay, lower it to overlap
           earlier. Examples:
             var(--intro-glow-at)                         → starts with Phase 2
             calc(var(--intro-glow-at) + 0.65s)           → mid Phase 2
             calc(var(--intro-nav-fade) + var(--intro-glow-dur)) → after Phase 2 */
        --intro-sim-at: calc(var(--intro-glow-at) - 0.2s);
      }

      /* Phase 1 — the whole navbar fades in first (before any glow). */
      :global(html[data-home-intro] .site-header) {
        animation: introNavFadeIn var(--intro-nav-fade, 0.45s) ease-out both;
      }
      @keyframes introNavFadeIn {
        from {
          opacity: 0;
        }
        to {
          opacity: 1;
        }
      }

      /* Phase 2 — neon flicker on the navbar, starting AFTER the fade-in. Most
         elements' resting state has no glow, so their flicker fades to none at
         100%. The flicker portion is stepped; the fade-out tail is linear. */
      /* The logo glow filters live on each color layer's <svg> element (not the
         inner paths) so Safari renders them — see Header.astro. */
      :global(html[data-home-intro] .site-header .brand-layer-primary svg) {
        animation: introLogoPrimaryGlow var(--intro-glow-dur, 1.1s) linear
          var(--intro-glow-at, 0.45s) both;
      }
      :global(html[data-home-intro] .site-header .brand-layer-secondary svg) {
        animation: introLogoSecondaryGlow var(--intro-glow-dur, 1.1s) linear
          var(--intro-glow-at, 0.45s) both;
      }
      /* Nav links flicker in like a row of old neon signs igniting at RANDOM
         times — not in unison. Each link shares the introTextGlow keyframe but
         gets its own start delay AND a slightly different duration, so their
         stutter pulses fall at different moments and desync. All still finish
         within Phase 2 (delays are small, durations ≤ base) so the handoff to the
         resting state stays clean. --gd is the base Phase-2 flicker duration. */
      :global(html[data-home-intro] .internal-links a) {
        --gd: var(--intro-glow-dur, 1.1s);
        animation: introTextGlow var(--gd) linear var(--intro-glow-at, 0.45s)
          both;
      }
      /* Per-link offsets (hand-picked to look scattered, not sequential). The
         delay adds onto --intro-glow-at; the duration tweak shifts the rhythm. */
      :global(html[data-home-intro] .internal-links a:nth-child(1)) {
        animation-delay: calc(var(--intro-glow-at, 0.45s) + 0.12s);
        animation-duration: calc(var(--gd) * 0.86);
      }
      :global(html[data-home-intro] .internal-links a:nth-child(2)) {
        animation-delay: calc(var(--intro-glow-at, 0.45s) + 0.4s);
        animation-duration: calc(var(--gd) * 0.78);
      }
      :global(html[data-home-intro] .internal-links a:nth-child(3)) {
        animation-delay: calc(var(--intro-glow-at, 0.45s) + 0s);
        animation-duration: calc(var(--gd) * 0.92);
      }
      :global(html[data-home-intro] .internal-links a:nth-child(4)) {
        animation-delay: calc(var(--intro-glow-at, 0.45s) + 0.52s);
        animation-duration: calc(var(--gd) * 0.74);
      }
      :global(html[data-home-intro] .internal-links a:nth-child(5)) {
        animation-delay: calc(var(--intro-glow-at, 0.45s) + 0.26s);
        animation-duration: calc(var(--gd) * 0.83);
      }
      /* The magicbar's RESTING state already glows, so its intro flicker must end
         IN the glowing state (not fade to none) for a seamless handoff. */
      :global(html[data-home-intro] .nav-underline) {
        animation: introUnderlineGlow var(--intro-glow-dur, 1.1s) linear
          var(--intro-glow-at, 0.45s) both;
      }
      /* Right-side action icons also ignite at RANDOM times (not in unison),
         like the nav links. Each action item's icon gets its own delay + a
         slightly different duration so their flickers desync. */
      :global(html[data-home-intro] .header-actions svg),
      :global(html[data-home-intro] #menu-toggle svg) {
        --gd: var(--intro-glow-dur, 1.1s);
        animation: introIconGlow var(--gd) linear var(--intro-glow-at, 0.45s)
          both;
      }
      :global(html[data-home-intro] .header-actions > *:nth-child(1) svg) {
        animation-delay: calc(var(--intro-glow-at, 0.45s) + 0.34s);
        animation-duration: calc(var(--gd) * 0.8);
      }
      :global(html[data-home-intro] .header-actions > *:nth-child(2) svg) {
        animation-delay: calc(var(--intro-glow-at, 0.45s) + 0.06s);
        animation-duration: calc(var(--gd) * 0.9);
      }
      :global(html[data-home-intro] .header-actions > *:nth-child(3) svg) {
        animation-delay: calc(var(--intro-glow-at, 0.45s) + 0.48s);
        animation-duration: calc(var(--gd) * 0.72);
      }
      :global(html[data-home-intro] .header-actions > *:nth-child(4) svg) {
        animation-delay: calc(var(--intro-glow-at, 0.45s) + 0.2s);
        animation-duration: calc(var(--gd) * 0.85);
      }

      /* Phase 3 — simulation gas fades in (uniform, no flicker); the NAME
         activation flicker is driven in HeroSim. Starts at --intro-sim-at, which
         is independent of Phase 2 and may overlap it. */
      :global(html[data-home-intro] .hero-sim-grid) {
        animation: introGridFade var(--intro-sim-dur, 0.45s) ease-out
          var(--intro-sim-at, 2.1s) both;
      }
      :global(html[data-home-intro] .hero-sim-canvas) {
        animation: introCanvasFade var(--intro-sim-dur, 0.45s) ease-out
          calc(var(--intro-sim-at, 2.1s) + 0.02s) both;
      }
      /* Header + sim layers fade in on the scripted intro timeline. The card
         layer is NOT here on purpose: it's a scroll-progress crossfade (its own
         opacity clamp is 0 at the top and reveals on scroll), so holding it at
         opacity:0 during the intro would fight that and leave it stuck visible
         when scrolling back up. Letting it follow scroll progress gives the
         correct behavior both during and after the intro. */
      :global(html[data-home-intro] .site-header),
      :global(html[data-home-intro] .hero-sim-grid),
      :global(html[data-home-intro] .hero-sim-canvas) {
        opacity: 0;
      }
      /* True below-the-fold content (no scroll-progress opacity of its own) is
         held hidden during the intro so it doesn't pop in early. (Scrolling
         mid-intro ENDS the intro — onScrollIntent removes data-home-intro —
         so this rule can never hide content from someone scrolling past.) */
      :global(html[data-home-intro] .home-front) {
        opacity: 0;
      }
      /* Final beat of the intro: the "scroll" cue fades in once the name has
         finished igniting (sim start + the activation flicker length), so it
         appears last and concludes the sequence instead of snapping in. */
      /* The scroll cue is the final beat of the intro. It's held hidden during
         the intro and faded in via a CSS TRANSITION (not a delayed keyframe —
         compositor-run keyframe opacity was rendering as a snap on this layer).
         JS adds .cue-in at the right moment to trigger the transition. */
      :global(html[data-home-intro] .hero-scroll-cue) {
        opacity: 0;
        transition: opacity 0.6s ease-out;
      }
      :global(html[data-home-intro] .hero-scroll-cue.cue-in) {
        opacity: 1;
      }
      /* Each glow flickers like a neon tube warming up: four quick stepped
         pulses (tight adjacent-% pairs read as instant on/off even under linear
         timing) through ~40%, then a SHORT sustained "on" (41–62%), then a smooth
         ramp DOWN to none by 100% so the glow fades out instead of snapping off.
         Off frames: 0–8, 12–15, 19–22, 26–30, 35–40. On frames: 9–11, 16–18,
         23–25, 31–34, 41–62. */
      @keyframes introLogoPrimaryGlow {
        0%,
        8%,
        12%,
        15%,
        19%,
        22%,
        26%,
        30%,
        35%,
        40% {
          filter: none;
        }
        9%,
        11%,
        16%,
        18%,
        23%,
        25%,
        31%,
        34%,
        41%,
        62% {
          filter: drop-shadow(0 0 6px var(--brand-glow-primary))
            drop-shadow(0 0 16px var(--brand-glow-primary));
        }
        /* Fade-out tail: drop most of the glow EARLY (by ~78%) so the final
           stretch is already near-zero and trails gently to nothing — avoids the
           abrupt cut you get when it stays bright until the very end. */
        72% {
          filter: drop-shadow(0 0 3px var(--brand-glow-primary))
            drop-shadow(0 0 8px var(--brand-glow-primary));
        }
        82% {
          filter: drop-shadow(0 0 1px var(--brand-glow-primary))
            drop-shadow(0 0 3px var(--brand-glow-primary));
        }
        100% {
          filter: drop-shadow(0 0 0 transparent) drop-shadow(0 0 0 transparent);
        }
      }
      @keyframes introLogoSecondaryGlow {
        0%,
        8%,
        12%,
        15%,
        19%,
        22%,
        26%,
        30%,
        35%,
        40% {
          filter: none;
        }
        9%,
        11%,
        16%,
        18%,
        23%,
        25%,
        31%,
        34%,
        41%,
        62% {
          filter: drop-shadow(0 0 6px var(--brand-glow-secondary))
            drop-shadow(0 0 16px var(--brand-glow-secondary));
        }
        72% {
          filter: drop-shadow(0 0 3px var(--brand-glow-secondary))
            drop-shadow(0 0 8px var(--brand-glow-secondary));
        }
        82% {
          filter: drop-shadow(0 0 1px var(--brand-glow-secondary))
            drop-shadow(0 0 3px var(--brand-glow-secondary));
        }
        100% {
          filter: drop-shadow(0 0 0 transparent) drop-shadow(0 0 0 transparent);
        }
      }
      @keyframes introTextGlow {
        0%,
        8%,
        12%,
        15%,
        19%,
        22%,
        26%,
        30%,
        35%,
        40% {
          text-shadow: none;
        }
        9%,
        11%,
        16%,
        18%,
        23%,
        25%,
        31%,
        34%,
        41%,
        62% {
          text-shadow:
            0 0 6px var(--nav-glow, var(--color-accent)),
            0 0 14px var(--nav-glow, var(--color-accent));
        }
        72% {
          text-shadow:
            0 0 3px var(--nav-glow, var(--color-accent)),
            0 0 7px var(--nav-glow, var(--color-accent));
        }
        82% {
          text-shadow:
            0 0 1px var(--nav-glow, var(--color-accent)),
            0 0 3px var(--nav-glow, var(--color-accent));
        }
        100% {
          text-shadow:
            0 0 0 transparent,
            0 0 0 transparent;
        }
      }
      @keyframes introIconGlow {
        0%,
        8%,
        12%,
        15%,
        19%,
        22%,
        26%,
        30%,
        35%,
        40% {
          filter: none;
        }
        9%,
        11%,
        16%,
        18%,
        23%,
        25%,
        31%,
        34%,
        41%,
        62% {
          filter: drop-shadow(0 0 5px var(--nav-glow, var(--color-accent)))
            drop-shadow(0 0 12px var(--nav-glow, var(--color-accent)));
        }
        72% {
          filter: drop-shadow(0 0 2px var(--nav-glow, var(--color-accent)))
            drop-shadow(0 0 6px var(--nav-glow, var(--color-accent)));
        }
        82% {
          filter: drop-shadow(0 0 1px var(--nav-glow, var(--color-accent)))
            drop-shadow(0 0 2px var(--nav-glow, var(--color-accent)));
        }
        100% {
          filter: drop-shadow(0 0 0 transparent) drop-shadow(0 0 0 transparent);
        }
      }
      @keyframes introUnderlineGlow {
        0%,
        8%,
        12%,
        15%,
        19%,
        22%,
        26%,
        30%,
        35%,
        40% {
          box-shadow: none;
        }
        9%,
        11%,
        16%,
        18%,
        23%,
        25%,
        31%,
        34%,
        41%,
        100% {
          /* Hold the glow all the way to 100% — the magicbar's resting state
             glows, so ending lit makes the handoff seamless (no fade-out). */
          box-shadow:
            0 0 6px var(--nav-glow, var(--color-accent)),
            0 0 12px var(--nav-glow, var(--color-accent));
        }
      }
      @keyframes introGridFade {
        from {
          opacity: 0;
        }
        to {
          opacity: 0.24;
        }
      }
      /* The canvas fades in UNIFORMLY (the whole gas appears at one ambient
         color, name not yet visible). The neon "activation" flicker — the
         inside-name particles igniting their color+glow — is driven inside the
         simulation's render loop (HeroSim.astro: activatedIntroAlpha), NOT here,
         so only the activation flickers, never the gas as a whole. */
      @keyframes introCanvasFade {
        from {
          opacity: 0;
        }
        to {
          opacity: 1;
        }
      }
      .home-main {
        /* Remove the global top padding on the homepage so the pinned hero starts
           immediately below the header and scroll progress begins on first input. */
        padding-top: 0;
        /* Homepage-only wider column: the hero sim and profile card already
           span wide, so the content panels below breathe at 70rem instead of
           the site's 960px reading column. Overriding the VAR (not max-width
           directly) widens main itself AND every panel that sizes itself with
           var(--max-width) — while the footer, outside main, keeps the
           site-wide width. */
        --max-width: 70rem;
      }
      .hero-stage {
        position: sticky;
        top: var(--header-h);
        height: calc(var(--hero-svh, 1svh) * 100 - var(--header-h));
        display: grid; /* stack the two layers in one cell */
      }
      .hero-layer {
        grid-area: 1 / 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }

      /* --- Sim layer: the LAYER stays put (its blueprint grid persists as
         the stage through the whole transition); only the GAS — canvas +
         name — dissolves. It scales up and DEFOCUSES (no positional drift):
         the viewer moves through the gas, and like any medium you pass
         through, it grows and blurs out of the focal plane. --- */
      .hero-layer-sim {
        position: relative;
        align-items: center;
        pointer-events: auto;
      }
      .hero-layer-sim :global(.hero-sim-canvas) {
        opacity: var(--b-gas);
        transform: scale(calc(1 + (1 - var(--b-gas)) * 0.1));
        /* 5px ceiling: reads as defocus at this scale, at roughly half the
           GPU cost of the 8px it replaced (the sim also freezes during the
           scrub — see update() — so this blurs a static frame). */
        filter: blur(calc((1 - var(--b-gas)) * 5px));
      }
      /* The name element is visually transparent (the particles spell it) —
         it only needs to leave the accessibility tree's geometry alone, so
         fade it without the transform/filter cost. */
      .hero-layer-sim :global(.hero-sim-name) {
        opacity: var(--b-gas);
      }
      .hero-layer-sim > :global(.hero-sim) {
        flex: 0 1 auto;
        width: 100%;
        height: min(100%, 44rem);
        min-height: 14rem;
        max-height: 44rem;
      }

      .hero-scroll-cue {
        /* Button reset first, so the type rules below win. Not the `font`
           shorthand: it would take line-height with it. */
        appearance: none;
        -webkit-appearance: none;
        background: none;
        border: 0;
        margin: 0;
        padding: 0;
        font-family: inherit;
        line-height: inherit;
        cursor: pointer;
        position: absolute;
        bottom: 1.5rem;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.25rem;
        font-size: 0.7rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--color-text-muted);
        /* Fades as soon as the user starts scrolling. */
        opacity: clamp(0, calc(1 - var(--hero-progress) / 0.15), 1);
        animation: heroCueBob 1.8s ease-in-out infinite;
        /* Inert until initHeroScroll switches this on (and back off once the
           fade above has taken the cue below visibility) — so it stays a pure
           hint if the script never runs. No `transition` here on purpose: the
           intro rule owns this element's transition while it plays, and a
           second declaration would just be dead weight for 2s. */
        pointer-events: none;
      }
      .hero-scroll-cue:hover,
      .hero-scroll-cue:focus-visible {
        color: var(--color-text-main);
      }
      /* Hold the bob while it's being aimed at — a target that keeps moving
         under the cursor is a worse button than a still one. */
      .hero-scroll-cue:hover {
        animation-play-state: paused;
      }
      @keyframes heroCueBob {
        0%,
        100% {
          translate: 0 0;
        }
        50% {
          translate: 0 4px;
        }
      }

      /* --- Card layer: the layer itself is a fixed frame (per-element bands
         above handle every entrance, so at progress 0 all its elements are
         individually transparent — which also keeps it hidden during the
         intro). Not interactive until substantially visible (JS toggles
         data-hero-active below). --- */
      .hero-layer-card {
        pointer-events: none;
        /* LIVE HOLD: once the transition completes, continued scrolling
           drifts the finished card slowly upward (~17% of scroll rate) —
           sub-linear feedback that reads as "passing slowly by the card",
           never a dead frame. Rate discontinuity at unpin reads as release. */
        /* svh, not vh: Firefox mobile resizes plain vh with the URL bar, which
           moved the whole card as the bar collapsed/expanded. */
        transform: translateY(
          calc(var(--hero-hold, 0) * var(--hero-svh, 1svh) * -4)
        );
      }
      /* Photo condenses in from the right: its soft melt edge travels
         right-to-left as it arrives. */
      .hero-card-photo {
        opacity: var(--b-photo);
        transform: translateX(calc((1 - var(--b-photo)) * 7vw));
      }
      /* Copy builds line by line. */
      .hero-card-eyebrow {
        opacity: var(--b-eyebrow);
        transform: translateY(calc((1 - var(--b-eyebrow)) * 0.5rem));
      }
      .hero-card-tick {
        transform: scaleX(var(--b-tick));
        transform-origin: left center;
      }
      .hero-card-name {
        opacity: var(--b-name);
        transform: translateY(calc((1 - var(--b-name)) * 1.4rem));
      }
      .hero-card-bio {
        opacity: var(--b-bio);
        transform: translateY(calc((1 - var(--b-bio)) * 1.2rem));
      }
      .hero-card-links {
        opacity: var(--b-links);
        transform: translateY(calc((1 - var(--b-links)) * 1rem));
      }
      .hero-scroll[data-hero-active="card"] .hero-layer-card {
        pointer-events: auto;
      }
      .hero-scroll[data-hero-active="card"] .hero-layer-sim {
        pointer-events: none;
      }

      /* ---- "In his element" card ----
         .hero-card breaks out of main's --max-width column to span the full
         viewport (the photo bleeds off the right edge) and re-centers the
         composition once the viewport outgrows its 112rem cap — past that,
         stretching further would open a gulf between copy and photo. */
      .hero-card {
        width: 100vw;
        margin-left: calc(50% - 50vw);
        display: flex;
        justify-content: center;
      }
      .hero-card-inner {
        width: 100%;
        max-width: 112rem;
        display: grid;
        /* minmax(0, …) on the photo track: a bare fr means minmax(auto, fr),
           and the image's intrinsic 1600px width inflates that auto minimum
           on wide screens until the copy column collapses. */
        grid-template-columns: minmax(24rem, 1fr) minmax(0, 1.15fr);
        align-items: center;
      }
      .hero-card-copy {
        /* Centered within its column's whitespace, sized to its measure —
           pinning it to the site content column strands it far left on wide
           screens. */
        justify-self: center;
        width: min(29rem, 100%);
        padding: 0 1rem;
      }
      .hero-card-eyebrow {
        margin: 0 0 0.9rem;
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--color-accent);
        display: flex;
        align-items: center;
        white-space: nowrap;
      }
      .hero-card-tick {
        display: inline-block;
        width: 1.1rem;
        height: 3px;
        background: var(--color-hot);
        margin-right: 0.55rem;
      }
      .hero-card-name {
        margin: 0 0 1.1rem;
        font-family: var(--font-serif);
        font-weight: 700;
        font-size: clamp(2.8rem, 4.5vw, 4rem);
        line-height: 1.03;
        color: var(--color-text-main);
      }
      .hero-card-bio {
        margin: 0 0 1.6rem;
        font-size: 1.02rem;
        line-height: 1.6;
        max-width: 27rem;
      }
      /* Editorial text links: hairline underline that sharpens on hover,
         arrow that leans into the destination. */
      .hero-card-links {
        display: flex;
        gap: 2rem;
      }
      .hero-card-link {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding-bottom: 0.3rem;
        color: var(--color-accent);
        font-weight: 600;
        font-size: 0.95rem;
        text-decoration: none;
        white-space: nowrap;
      }
      .hero-card-link::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: 0;
        width: 100%;
        height: 1px;
        background: currentColor;
        opacity: 0.35;
        transition: opacity 0.2s ease;
      }
      .hero-card-link:hover::after {
        opacity: 1;
      }
      .hero-card-link:focus-visible {
        outline: 2px solid var(--color-accent);
        outline-offset: 3px;
        border-radius: 2px;
      }
      .hero-card-arrow {
        transition: transform 0.2s ease;
      }
      .hero-card-link:hover .hero-card-arrow {
        transform: translateX(4px);
      }
      .hero-card-link-muted {
        color: var(--color-text-muted);
        transition: color 0.2s ease;
      }
      .hero-card-link-muted:hover {
        color: var(--color-accent);
      }
      .hero-card-photo {
        justify-self: end;
        width: 100%;
        /* On ultra-wide screens the photo stops growing and hugs the right
           edge rather than swallowing the whole viewport. */
        max-width: 58rem;
        height: min(calc(var(--hero-svh, 1svh) * 76), 42rem);
        /* Size container so the img can position its crop in cqw/cqh units. */
        container-type: size;
      }
      .hero-card-photo img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: left center;
        filter: grayscale(1) contrast(1.02);
        /* Melt the photo into the page on its left/top/bottom edges (right
           edge runs to the viewport). Two gradients intersected so both axes
           fade. */
        -webkit-mask-image: linear-gradient(to right, transparent 0, #000 26%),
          linear-gradient(
            to bottom,
            transparent 0,
            #000 12%,
            #000 88%,
            transparent 100%
          );
        -webkit-mask-composite: source-in;
        mask-image: linear-gradient(to right, transparent 0, #000 26%),
          linear-gradient(
            to bottom,
            transparent 0,
            #000 12%,
            #000 88%,
            transparent 100%
          );
        mask-composite: intersect;
      }
      /* Keep the FACE centered SMOOTHLY as the photo column narrows. The face
         sits at ~38% of the image's width and the image (aspect 1.5) is
         height-limited under `cover` here, so its rendered width is 150cqh.
         Centering the face means offsetting the image's left edge by
           50cqw − (0.38 × 150cqh) = 50cqw − 57cqh,
         clamped so the crop never slides past the image's left (0px) or right
         (100cqw − 150cqh) edge. Continuous at every width — no stepped jumps.
         (Browsers without cq units keep the `left center` fallback above.)
         Scoped to the split layout; the stacked mobile crop lives in the
         mobile block below. */
      @media (min-width: 769px) {
        .hero-card-photo img {
          object-position: clamp(
              calc(100cqw - 150cqh),
              calc(50cqw - 57cqh),
              0px
            )
            center;
        }
      }
      /* Once the composition is centered (viewport wider than its cap), the
         photo no longer touches the viewport edge — fade its right side too
         so it reads as a soft vignette instead of a hard-cropped panel
         floating mid-page. */
      @media (min-width: 112rem) {
        .hero-card-photo img {
          -webkit-mask-image: linear-gradient(
              to right,
              transparent 0,
              #000 26%,
              #000 90%,
              transparent 100%
            ),
            linear-gradient(
              to bottom,
              transparent 0,
              #000 12%,
              #000 88%,
              transparent 100%
            );
          mask-image: linear-gradient(
              to right,
              transparent 0,
              #000 26%,
              #000 90%,
              transparent 100%
            ),
            linear-gradient(
              to bottom,
              transparent 0,
              #000 12%,
              #000 88%,
              transparent 100%
            );
        }
      }

      /* ---- Below-fold "front page": Research leads in the wide column
         (Journal row language — index-number gutter, serif titles, hairline
         separators); the Journal + Projects sit in a slim rail behind a
         newspaper-style vertical hairline. Deliberate asymmetry — the two
         content types no longer pretend to be equals. ---- */
      .home-front {
        display: grid;
        grid-template-columns: minmax(0, 1.7fr) minmax(15rem, 1fr);
        column-gap: 2.75rem;
        /* Generous bottom margin: the newspaper feed should finish breathing
           before the contact band takes over. */
        margin: 5.5rem 0 7.5rem;
      }
      /* Lead column: two stories stacked (Research, then Journal prose). */
      .home-lead {
        display: flex;
        flex-direction: column;
        gap: 4rem;
      }
      .home-row-desc {
        margin: 0 0 0.4rem;
        /* Cap the measure — at full lead-column width this smallest text ran
           ~90 characters per line, past the ~75 CPL comfort ceiling. */
        max-width: 35rem;
        font-size: 0.9rem;
        line-height: 1.5;
        color: var(--color-text-muted);
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .home-rail {
        border-left: 1px solid var(--color-border);
        padding-left: 2.75rem;
        display: flex;
        flex-direction: column;
        gap: 3.25rem;
      }
      /* Rail quote: a personal epigraph at the top of the rail. Set larger
         than the rail entries but italic and unlabeled — flavor, not a
         section. */
      .home-rail-quote {
        margin: 0;
        padding: 0.35rem 0 0;
      }
      .home-rail-quote-text {
        margin: 0 0 0.55rem;
        font-family: var(--font-serif);
        font-style: italic;
        font-size: 1.4rem;
        line-height: 1.4;
        color: var(--color-text-main);
      }
      .home-rail-quote-attr {
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--color-text-muted);
      }
      .home-rail-quote-attr::before {
        content: "\2014\00a0"; /* em dash */
      }
      /* Rail group labels: the hero card's eyebrow voice (small caps, accent),
         subordinate to the lead's serif h2. */
      .home-rail-label {
        margin: 0 0 0.5rem;
        font-family: var(--font-sans);
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--color-accent);
      }
      /* The label IS the link to its page — no separate CTA row. Hovering
         (or keyboard-focusing) reveals an "All" prefix and a trailing arrow,
         so "Projects" reads as "All Projects →": the two visible items are a
         sample, not the inventory. */
      .home-rail-label-link {
        /* Block-level flex, NOT inline-flex: the hit area spans the full
           rail column and never resizes when the label text morphs on hover.
           With a text-sized hit box, the "Featured Project" → "All Projects"
           swap SHRINKS the link out from under a cursor near its right edge,
           un-hovering it and looping the animation forever. */
        display: flex;
        align-items: center;
        position: relative;
        color: inherit;
        text-decoration: none;
      }
      /* Invisible hit-area extension: the small-caps text alone is a
         ~15px-tall strip — too precise a target. An absolute pseudo grows
         the hover/click box past the text's top and bottom with ZERO layout
         involvement (padding/negative-margin tricks fought the h3's margin
         collapsing and grew the heading box). */
      .home-rail-label-link::before {
        content: "";
        position: absolute;
        inset: -0.55rem 0;
      }
      .rail-label-all,
      .rail-label-s {
        display: inline-block;
        max-width: 0;
        opacity: 0;
        overflow: hidden;
        transition:
          max-width 0.25s ease,
          opacity 0.2s ease;
      }
      /* "Featured " runs the same reveal in reverse — present at rest,
         collapsing on hover as "All " expands. */
      .rail-label-featured {
        display: inline-block;
        max-width: 7em;
        opacity: 1;
        overflow: hidden;
        transition:
          max-width 0.25s ease,
          opacity 0.2s ease;
      }
      .home-rail-label-link:hover .rail-label-featured,
      .home-rail-label-link:focus-visible .rail-label-featured {
        max-width: 0;
        opacity: 0;
      }
      .home-rail-label-link:hover .rail-label-s,
      .home-rail-label-link:focus-visible .rail-label-s {
        max-width: 1em;
        opacity: 1;
      }
      .rail-label-arrow {
        opacity: 0;
        transform: translateX(-4px);
        margin-left: 0.35rem;
        transition:
          opacity 0.2s ease,
          transform 0.2s ease;
      }
      .home-rail-label-link:hover .rail-label-all,
      .home-rail-label-link:focus-visible .rail-label-all {
        max-width: 3em;
        opacity: 1;
      }
      .home-rail-label-link:hover .rail-label-arrow,
      .home-rail-label-link:focus-visible .rail-label-arrow {
        opacity: 1;
        transform: none;
      }
      .home-rail-label-link:focus-visible {
        outline: 2px solid var(--color-accent);
        outline-offset: 3px;
        border-radius: 2px;
      }
      .home-rail-list {
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .home-rail-item {
        padding: 1rem 0;
        border-bottom: 1px solid var(--color-border);
      }
      .home-rail-item:last-child {
        border-bottom: none;
        padding-bottom: 0.4rem;
      }
      /* Rail titles at reading weight, NOT headline weight — bold serif is
         reserved for the lead's stories. Ten equal headlines overwhelm; five
         headlines plus quiet marginalia don't. */
      .home-rail-title {
        display: block;
        font-family: var(--font-serif);
        font-size: 0.95rem;
        font-weight: 400;
        line-height: 1.4;
        color: var(--color-text-main);
        text-decoration: none;
        margin-bottom: 0.25rem;
        transition: color 0.15s ease;
      }
      a.home-rail-title:hover {
        color: var(--color-accent);
      }
      /* Rail projects: ONE featured image card on the wide layout — a
         centerpiece plate, slightly inset and centered — rather than every
         project as a full-width card (two stacked images out-weighed the
         text-only lead even with the columns flush). The label's
         "All Projects →" carries the rest; the stacked mobile layout shows
         every card (it reads well there). Image at this size is fair to the
         photos — postage-stamp thumbs were illegible and dictated the art. */
      .home-rail-proj {
        display: block;
        /* 18.5rem ≈ the ink right edge of the rail's longest text line, so
           the image's right edge sits on the same visual margin as the
           neighboring Updates/Notes text. */
        max-width: 18.5rem;
        text-align: left;
        text-decoration: none;
        color: inherit;
      }
      .home-rail-thumb {
        display: block;
        width: 100%;
        aspect-ratio: 16 / 10;
        object-fit: cover;
        border-radius: 10px;
        border: 1px solid var(--color-border);
        margin-bottom: 0.65rem;
      }
      /* Image cards separate themselves — no hairlines between project
         items, unlike the text-only rail lists. */
      .home-rail-list--proj .home-rail-item {
        border-bottom: none;
        padding: 0.85rem 0;
      }
      /* Only the FIRST project shows, at every width — the label reads
         "Featured Project" accordingly. */
      .home-rail-list--proj .home-rail-item:nth-child(n + 2) {
        display: none;
      }
      .home-rail-list--proj .home-rail-item:last-child {
        padding-bottom: 0;
      }
      /* Pull the following group (Notes) closer: the card's small caption
         next to the uniform 3.25rem rail gap read as a hole. Reset on the
         stacked layout below. */
      .home-rail-list--proj {
        margin-bottom: -1rem;
      }
      .home-rail-proj-title {
        display: block;
        font-family: var(--font-serif);
        font-size: 0.95rem;
        font-weight: 400;
        line-height: 1.4;
        color: var(--color-text-main);
        transition: color 0.15s ease;
      }
      .home-rail-proj:hover .home-rail-proj-title {
        color: var(--color-accent);
      }
      .home-rail-proj:focus-visible {
        outline: 2px solid var(--color-accent);
        outline-offset: 3px;
        border-radius: 4px;
      }
      .home-rail-proj-year {
        display: block;
        font-size: 0.78rem;
        color: var(--color-text-muted);
        margin-top: 0.15rem;
      }
      /* Stacked front page: rail groups flow full-width below the lead; the
         vertical hairline goes away with the column. auto-fit lets the two
         rail groups sit side by side on tablets and stack on phones. */
      @media (max-width: 900px) {
        .home-front {
          grid-template-columns: 1fr;
          row-gap: 3.5rem;
          /* NEGATIVE top: the mobile hero stage keeps ~90px of empty tail
             below the card's links (stage = full viewport, card is shorter),
             so the front page pulls up over that dead zone — the grid has
             already feathered out there. Net visual gap ≈ 70px. */
          margin: -2rem 0 5rem;
        }
        .home-rail {
          border-left: none;
          padding-left: 0;
          display: grid;
          grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
          gap: 2.75rem 3rem;
        }
        /* The epigraph is a wide-layout device — stacked below the lead it
           would just push real content down. */
        .home-rail-quote {
          display: none;
        }
        /* Stacked layout: still ONE project (a second full-width card made
           the phone page feel crowded). */
        .home-rail-list--proj {
          margin-bottom: 0;
        }
        /* Single-column (tablet) view: the rail sits two-up, Updates BESIDE
           the project card — the card pulls in slightly so the pairing
           doesn't lopside. Phones override both below. */
        .home-rail-proj {
          max-width: 18rem;
        }
        /* No Notes group when stacked — it stood between the reader and the
           "Get in touch" CTA on an already-long page. Notes stay reachable
           through the Journal. */
        .home-rail-group--notes {
          display: none;
        }
      }
      /* True mobile: the rail is a single column again (auto-fit collapses
         below ~600px), so the side-by-side balance concerns vanish and the
         road-to-CTA ones return. */
      @media (max-width: 600px) {
        .home-rail-proj {
          max-width: none;
        }
        /* Two updates instead of three — shorter road to the CTA. The full
           list lives at /journal#updates. */
        .home-rail-group--updates .home-rail-item:nth-child(n + 3) {
          display: none;
        }
      }
      .home-rows {
        list-style: none;
        margin: 0;
        padding: 0;
      }
      .home-row {
        display: grid;
        grid-template-columns: 2.2rem 1fr;
        padding: 1.3rem 0;
        border-bottom: 1px solid var(--color-border);
      }
      .home-row:first-child {
        padding-top: 0.4rem;
      }
      .home-row:last-child {
        border-bottom: none;
      }
      .home-row-num {
        font-variant-numeric: tabular-nums;
        color: var(--color-text-muted);
        opacity: 0.5;
        font-size: 0.9rem;
        padding-top: 0.25rem;
      }
      .home-row-title {
        display: block;
        font-family: var(--font-serif);
        font-size: 1.1rem;
        font-weight: 600;
        line-height: 1.35;
        color: var(--color-text-main);
        text-decoration: none;
        margin-bottom: 0.3rem;
        transition: color 0.15s ease;
      }
      a.home-row-title:hover {
        color: var(--color-accent);
      }
      .home-row-meta {
        font-size: 0.85rem;
        color: var(--color-text-muted);
      }
      .home-row-venue {
        font-style: italic;
        color: var(--color-accent);
      }
      .home-row-date {
        text-transform: uppercase;
        font-size: 0.78rem;
        letter-spacing: 0.04em;
      }
      /* Subject/topic accent in the meta line. Colour is the only thing that
         distinguishes it — same size, tracking and case as the date beside it,
         so it reads as part of the metadata rather than as a badge.
         Held back to 75%: at full strength three saturated words down the
         column pulled harder than the titles they belong to. The hue still
         identifies the register/subject; it just stops shouting. */
      .home-row-subject {
        font-weight: 700;
        opacity: 0.75;
      }
      .home-row-sep {
        margin: 0 0.45rem;
        opacity: 0.45;
      }
      /* Section more-links: same editorial treatment as the hero card's. */
      .home-more {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        margin-top: 1.4rem;
        padding-bottom: 0.3rem;
        color: var(--color-accent);
        font-weight: 600;
        font-size: 0.95rem;
        text-decoration: none;
        white-space: nowrap;
      }
      .home-more::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: 0;
        width: 100%;
        height: 1px;
        background: currentColor;
        opacity: 0.35;
        transition: opacity 0.2s ease;
      }
      .home-more:hover::after {
        opacity: 1;
      }
      .home-more:focus-visible {
        outline: 2px solid var(--color-accent);
        outline-offset: 3px;
        border-radius: 2px;
      }
      .home-more-arrow {
        transition: transform 0.2s ease;
      }
      .home-more:hover .home-more-arrow {
        transform: translateX(4px);
      }

      /* ---- Get in touch: the ask, in the same editorial grammar as the
         sections above it (serif h2 + hot rule, left-aligned, in the reading
         column). Its predecessor was a centered full-bleed band on
         --color-bg-offset, which vanished entirely in dark mode (offset ==
         body there) and read as a template CTA strip. A first-class section
         needs no surface to exist. ---- */
      .home-contact {
        margin: 0 0 5.5rem;
      }
      .home-contact-line {
        margin: 0 0 1.6rem;
        max-width: 36rem;
        font-size: 1.1rem;
        line-height: 1.65;
        color: var(--color-text-main);
      }
      .home-contact-links {
        display: flex;
        gap: 2.25rem;
        flex-wrap: wrap;
      }
      .home-contact-links .home-more {
        margin-top: 0;
      }

      /* --- Mobile: drop the pinned scrub. Sticky pinning + the sim's
         overflow-x clipping fight each other on touch, and a scrub feels worse
         than a simple stack on a phone. Show the sim (one screen) then the card
         stacked below; both always visible, no crossfade. --- */
      @media (max-width: 768px) {
        /* The pinned scrub RUNS on mobile (scrollytelling on touch too) —
           no stacked fallback here anymore; only the card's composition
           changes: single column, photo on top, compact type, sized so the
           whole card fits inside the pinned stage. */
        .hero-scroll {
          /* Do NOT re-clip overflow-x here: an overflow clip on an ANCESTOR
             of the sticky stage makes iOS WebKit reposition the sticky on the
             main thread (compositing demotion) — the hero card then jitters
             against the composited scroll, worst while the URL bar animates.
             Root-cause of the 2026-07 mobile jitter bug; html/body's clip
             already contains any sideways overflow. */
          /* Much shorter travel than desktop's 115svh: one energetic thumb
             flick should carry through the whole transition + hold. The JS
             metrics() reads geometry, so the scrub/hold split follows. */
          --hero-travel: calc(var(--hero-svh, 1svh) * 70);
        }
        .hero-card-inner {
          grid-template-columns: 1fr;
          gap: 1.25rem;
        }
        .hero-card-photo {
          grid-row: 1;
          max-width: none;
          /* Explicit height (not 1fr) so the same rule works in the pinned
             stage AND the reduced-motion static stack: whatever vertical
             space the stage has left after ~27rem of copy, clamped so the
             photo never collapses nor dominates. */
          height: clamp(
            10rem,
            calc(var(--hero-svh, 1svh) * 100 - 27rem),
            calc(var(--hero-svh, 1svh) * 46)
          );
        }
        /* Stacked layout: the photo is a full-width band on TOP of the copy,
           not an arrival from a right-hand column — so the desktop's 7vw
           right-to-left slide has no geometry to justify it here (and its
           travel just sweeps the soft mask edge across dead space). Cancel it
           and CONDENSE the photo into place instead: it scales down and comes
           into focus, the exact inverse of the sim layer's gas dissolving
           (scale UP + blur OUT, see .hero-layer-sim .hero-sim-canvas). The gas
           leaving and the person resolving become one physical event, and the
           entrance needs no direction to make sense.
           Transform/filter go on the IMG, not the wrapper: the wrapper is a
           `container-type: size` query container (the crop math reads cqw/cqh
           off it), and the img is what carries the mask — blurring it keeps
           the feathered edges coherent. */
        .hero-card-photo {
          transform: none;
        }
        .hero-card-photo img {
          transform: scale(calc(1 + (1 - var(--b-photo)) * 0.06));
          /* 6px ≈ the sim canvas's 5px ceiling, scaled for the smaller box.
             The photo is static during the scrub, so this blurs a still
             frame — same cost profile as the gas dissolve it mirrors.
             Re-declare grayscale/contrast: `filter` is one property, so
             adding blur() alone would drop the desaturation and flash the
             photo in color. */
          filter: grayscale(1) contrast(1.02)
            blur(calc((1 - var(--b-photo)) * 6px));
        }
        .hero-card-copy {
          grid-row: 2;
          padding: 0 1.25rem;
        }
        .hero-card-name {
          font-size: 2.25rem;
        }
        .hero-card-bio {
          font-size: 0.95rem;
        }
        .hero-card-photo img {
          /* Fixed crop bias (the cq formula assumes the height-limited split
             layout): 20% keeps the face near center; vertical 45% sits the
             window above center so the head keeps clearance while the MIT
             podium sign stays in frame. Melt BOTH horizontal edges: the top
             fade (10%) softens the hard line that otherwise scrolls under the
             sticky header; the bottom fade stays short (ends 86%, ~14%) so it
             doesn't swallow the sign. Both only touch wall/frames, never the
             face. */
          object-position: 20% 45%;
          /* --edge: horizontal fade width, open ONLY while the photo is
             condensing (7% at b-photo=0 → 0% at rest). The band's left/right
             edges run flush to the viewport at rest, so a permanent side fade
             would be wrong — but during the entrance the img is scaled past
             both edges AND blurred, and `filter: blur` bleeds beyond the mask
             boundary, so an unmasked side edge reads as a hard-edged grey slab
             sliding inward. Collapsing to 0 keeps the flush end state
             pixel-identical to the vertical-only mask this replaced. */
          --edge: calc((1 - var(--b-photo)) * 7%);
          -webkit-mask-image: linear-gradient(
              to bottom,
              transparent 0,
              #000 10%,
              #000 86%,
              transparent 100%
            ),
            linear-gradient(
              to right,
              transparent 0,
              #000 var(--edge),
              #000 calc(100% - var(--edge)),
              transparent 100%
            );
          -webkit-mask-composite: source-in;
          mask-image: linear-gradient(
              to bottom,
              transparent 0,
              #000 10%,
              #000 86%,
              transparent 100%
            ),
            linear-gradient(
              to right,
              transparent 0,
              #000 var(--edge),
              #000 calc(100% - var(--edge)),
              transparent 100%
            );
          mask-composite: intersect;
        }
      }

      /* --- Scroll reveal: the below-hero content (Selected Research, Latest
         Posts) starts slightly down + transparent and eases in when scrolled into
         view (JS adds .is-revealed via IntersectionObserver). --reveal-delay
         staggers the two columns. --- */
      /* The section container itself doesn't move — its heading fades first,
         then the rows cascade (each row's --i sets its slot; --reveal-delay
         staggers the two columns). */
      [data-reveal] h2,
      [data-reveal] .home-rail-quote-text,
      [data-reveal] .home-rail-quote-attr,
      [data-reveal] .home-rail-label,
      [data-reveal] .home-row,
      [data-reveal] .home-rail-item,
      [data-reveal] .home-more,
      [data-reveal] .home-contact-line,
      [data-reveal] .home-contact-links {
        opacity: 0;
        transform: translateY(14px);
        transition:
          opacity 0.55s ease-out
            calc(var(--reveal-delay, 0s) + var(--i, 0) * 80ms),
          transform 0.55s cubic-bezier(0.16, 1, 0.3, 1)
            calc(var(--reveal-delay, 0s) + var(--i, 0) * 80ms);
      }
      [data-reveal].is-revealed h2,
      [data-reveal].is-revealed .home-rail-quote-text,
      [data-reveal].is-revealed .home-rail-quote-attr,
      [data-reveal].is-revealed .home-rail-label,
      [data-reveal].is-revealed .home-row,
      [data-reveal].is-revealed .home-rail-item,
      [data-reveal].is-revealed .home-more,
      [data-reveal].is-revealed .home-contact-line,
      [data-reveal].is-revealed .home-contact-links {
        opacity: 1;
        transform: none;
      }

      /* --- Reduced motion: no pin, no crossfade — just stack the two views, and
         no reveal animation (content is shown immediately). --- */
      @media (prefers-reduced-motion: reduce) {
        .hero-scroll {
          height: auto;
          /* Stacked, no scrub: pin the choreography to its end state. */
          --b-gas: 1;
          --b-photo: 1;
          --b-eyebrow: 1;
          --b-tick: 1;
          --b-name: 1;
          --b-bio: 1;
          --b-links: 1;
        }
        .hero-stage {
          position: static;
          height: auto;
          display: flex;
          flex-direction: column;
          gap: 2rem;
        }
        .hero-layer {
          opacity: 1 !important;
          transform: none !important;
          pointer-events: auto !important;
        }
        .hero-layer-sim {
          /* Fill the first screen so the headshot stays below the fold even when
             the scripted intro is skipped (reduced-motion sets no data-home-intro,
             so the intro card-hide never runs — this layout must stand alone).
             `lvh` for the same iOS toolbar reason as the mobile block above. */
          height: calc(100lvh - var(--header-h));
          min-height: calc(100lvh - var(--header-h));
        }
        .hero-scroll-cue {
          display: none;
        }
        [data-reveal] h2,
        [data-reveal] .home-rail-quote-text,
        [data-reveal] .home-rail-quote-attr,
        [data-reveal] .home-rail-label,
        [data-reveal] .home-row,
        [data-reveal] .home-rail-item,
        [data-reveal] .home-more,
        [data-reveal] .home-contact-line,
        [data-reveal] .home-contact-links {
          opacity: 1;
          transform: none;
          transition: none;
        }
        .hero-card-arrow,
        .home-more-arrow,
        .rail-label-all,
        .rail-label-s,
        .rail-label-featured,
        .rail-label-arrow {
          transition: none;
        }
        .home-more:hover .home-more-arrow {
          transform: none;
        }
        .hero-card-link:hover .hero-card-arrow {
          transform: none;
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main class="home-main" transition:animate={pageFade}>
      {
        /* Pinned-scrub hero: on landing the visitor sees ONLY the full-screen
          simulation. Scrolling through the tall .hero-scroll spacer keeps the
          .hero-stage pinned (sticky) and crossfades the sim out as the
          two-column "card" (portrait + name + bio + CTAs) fades in — only one
          view is visible at a time. JS sets --hero-progress (0→1) from scroll;
          CSS maps it to the two layers' opacity/transform. Reduced-motion and
          mobile fall back to a simple stacked layout (see <style>). */
      }
      <section class="hero-scroll" data-hero-scroll>
        <div class="hero-stage">
          <div class="hero-layer hero-layer-sim" data-hero-sim-layer>
            <HeroSim />
            {
              /* The cue is a CONTROL as well as a hint: clicking it runs the
                same glide the idle settle uses, straight to the card view (see
                onCueClick). It's a real <button> rather than a click handler on
                a div so it's keyboard-reachable — which is also why it's no
                longer aria-hidden. Hit-testing is off in CSS and switched on by
                JS only while the sim view is showing, so the faded-out cue
                never eats clicks mid-scrub. */
            }
            <button
              type="button"
              class="hero-scroll-cue"
              data-hero-cue
              aria-label="Scroll to the introduction"
            >
              <span>scroll</span>
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                ><path d="M12 5v14M19 12l-7 7-7-7"></path></svg
              >
            </button>
          </div>

          <div class="hero-layer hero-layer-card" data-hero-card>
            {
              /* "In his element" card: copy on the left, the podium photo
                bleeding off the right viewport edge. The photo loads eagerly
                (no loading=lazy) — it appears one small scroll after landing,
                mid-crossfade, and must not pop in half-faded. */
            }
            <div class="hero-card">
              <div class="hero-card-inner">
                <div class="hero-card-copy">
                  <p class="hero-card-eyebrow">
                    <span class="hero-card-tick" aria-hidden="true"></span>PhD
                    Candidate in Physics · MIT
                  </p>
                  {/* Not an <h1>: the page's single <h1> is the crawlable name
                      in HeroSim (shown in the default sim view). This
                      card-layer name is the same text revealed by the scroll
                      crossfade, styled to look like a heading. */}
                  <p class="hero-card-name">Sergio Eraso</p>
                  <p class="hero-card-bio">
                    I work on nonequilibrium statistical physics and biophysics
                    — finding the simple local rules that add up to complex
                    collective behavior, and building the models, simulations,
                    and tools to actually run them.
                  </p>
                  <div class="hero-card-links">
                    <a href={url("/research")} class="hero-card-link">
                      View research<span class="hero-card-arrow" aria-hidden="true"
                        >&rarr;</span
                      >
                    </a>
                    <a
                      href={url("/about")}
                      class="hero-card-link hero-card-link-muted"
                    >
                      About<span class="hero-card-arrow" aria-hidden="true"
                        >&rarr;</span
                      >
                    </a>
                  </div>
                </div>
                <div class="hero-card-photo">
                  <img
                    src={url("/about/about.jpeg")}
                    width={1600}
                    height={1066}
                    alt="Sergio Eraso presenting at the MIT Department of Physics"
                    decoding="async"
                  />
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      {
        /* Below-fold "front page": Research is the wide lead column in the
           Journal's row language (index-number gutter, serif titles, hairline
           separators); a slim right rail carries the Journal and Projects as
           compact eyebrow-labeled lists behind a newspaper-style vertical
           hairline. Rows cascade in when scrolled into view (initReveal + --i). */
      }
      <div class="home-front">
        <div class="home-lead">
        <section data-reveal>
          <h2 style="margin-top: 0;">Research</h2>
          {
            selectedResearch.length > 0 ? (
              <ol class="home-rows" data-pagefind-ignore>
                {selectedResearch.map((entry, i) => (
                  <li class="home-row" style={`--i: ${i}`}>
                    <span class="home-row-num" aria-hidden="true">
                      {String(i + 1).padStart(2, "0")}
                    </span>
                    <div class="home-row-main">
                      <a
                        class="home-row-title"
                        href={url(`/research/${entry.id}/`)}
                      >
                        {entry.data.title}
                      </a>
                      <div class="home-row-meta">
                        <span class="home-row-venue">{entry.data.venue || "In preparation"}</span>,{" "}
                        {entry.data.date.getUTCFullYear()}
                      </div>
                    </div>
                  </li>
                ))}
              </ol>
            ) : (
              <p>No research entries yet.</p>
            )
          }
          <a href={url("/research")} class="home-more" style="--i: 3">
            View all research<span class="home-more-arrow" aria-hidden="true"
              >&rarr;</span
            >
          </a>
        </section>

        {
          journalLead.length > 0 && (
            <section data-reveal>
              <h2 style="margin-top: 0;">From the Journal</h2>
              <ol class="home-rows" data-pagefind-ignore>
                {journalLead.map((post, i) => {
                  const link = postLink(post);
                  return (
                    <li class="home-row" style={`--i: ${i}`}>
                      <span class="home-row-num" aria-hidden="true">
                        {String(i + 1).padStart(2, "0")}
                      </span>
                      <div class="home-row-main">
                        {/* renderInline: titles may carry ~~strike~~ markup
                            (e.g. the grades op-ed), same as the Journal page. */}
                        {link.href ? (
                          <a
                            class="home-row-title"
                            href={link.href}
                            {...(link.external
                              ? { target: "_blank", rel: "noopener noreferrer" }
                              : {})}
                            set:html={renderInline(post.data.title)}
                          />
                        ) : (
                          <span
                            class="home-row-title"
                            set:html={renderInline(post.data.title)}
                          />
                        )}
                        <p class="home-row-desc">{post.data.description}</p>
                        <div class="home-row-meta home-row-date">
                          {/* Subject in its own color, ahead of the date —
                              the same signal the Journal's Essays view leads
                              with, kept quiet here: one word, no uppercase
                              weight beyond the meta line's own. */}
                          {subjectLabel(post) && (
                            <>
                              <span
                                class="home-row-subject"
                                style={`color:${subjectColor(post)}`}
                              >
                                {subjectLabel(post)}
                              </span>
                              <span class="home-row-sep" aria-hidden="true">
                                ·
                              </span>
                            </>
                          )}
                          {post.data.pubDate.toLocaleDateString("en-us", {
                            year: "numeric",
                            month: "short",
                            day: "numeric",
                            timeZone: "UTC",
                          })}
                        </div>
                      </div>
                    </li>
                  );
                })}
              </ol>
              <a href={url("/journal")} class="home-more" style="--i: 3">
                View journal<span class="home-more-arrow" aria-hidden="true"
                  >&rarr;</span
                >
              </a>
            </section>
          )
        }
        </div>

        <aside class="home-rail">
          {
            /* Wide-screens-only personal touch atop the rail (hidden when the
               rail stacks below the lead — there it would just delay content). */
          }
          <blockquote class="home-rail-quote" data-reveal>
            <p class="home-rail-quote-text">&ldquo;More is different.&rdquo;</p>
            <footer class="home-rail-quote-attr" style="--i: 1">
              P.&thinsp;W. Anderson
            </footer>
          </blockquote>
          {
            updatePosts.length > 0 && (
              <section
                class="home-rail-group home-rail-group--updates"
                data-reveal
                style="--reveal-delay: 0.08s;"
              >
                <h3 class="home-rail-label">
                  <a
                    class="home-rail-label-link"
                    href={url("/journal") + "#updates"}
                  >
                    <span class="rail-label-all">All&nbsp;</span>Updates<span
                      class="rail-label-arrow"
                      aria-hidden="true">&rarr;</span
                    >
                  </a>
                </h3>
                <ol data-pagefind-ignore class="home-rail-list">
                  {updatePosts.map((post, i) => {
                    const link = postLink(post);
                    return (
                      <li class="home-rail-item" style={`--i: ${i}`}>
                        {link.href ? (
                          <a
                            class="home-rail-title"
                            href={link.href}
                            {...(link.external
                              ? { target: "_blank", rel: "noopener noreferrer" }
                              : {})}
                            set:html={renderInline(post.data.title)}
                          />
                        ) : (
                          /* noLink update post — no destination, render as text */
                          <span
                            class="home-rail-title"
                            set:html={renderInline(post.data.title)}
                          />
                        )}
                        <div class="home-row-meta home-row-date">
                          {post.data.pubDate.toLocaleDateString("en-us", {
                            year: "numeric",
                            month: "short",
                            day: "numeric",
                            timeZone: "UTC",
                          })}
                        </div>
                      </li>
                    );
                  })}
                </ol>
                {/* No CTA here — the lead's "View journal" already covers it,
                    and the rail stays quieter than its labels without one. */}
              </section>
            )
          }

          {
            /* Projects outrank the notebook — different row anatomy
               (thumbnails), but rail position = importance. */
            projects.length > 0 && (
              <section
                class="home-rail-group"
                data-reveal
                style="--reveal-delay: 0.16s;"
              >
                <h3 class="home-rail-label">
                  {/* Rest: "Featured Project" (one card shows). Hover/focus
                      morphs it into "All Projects →": the "All " prefix and
                      plural "s" expand while "Featured " collapses.
                      aria-label pins the accessible name to the destination
                      instead of the mid-morph text soup. */}
                  <a
                    class="home-rail-label-link"
                    href={url("/projects")}
                    aria-label="All Projects"
                  >
                    <span class="rail-label-all">All&nbsp;</span><span
                      class="rail-label-featured">Featured&nbsp;</span
                    >Project<span class="rail-label-s">s</span><span
                      class="rail-label-arrow"
                      aria-hidden="true">&rarr;</span
                    >
                  </a>
                </h3>
                <ol data-pagefind-ignore class="home-rail-list home-rail-list--proj">
                  {projects.map((project, i) => (
                    <li class="home-rail-item" style={`--i: ${i}`}>
                      <a
                        class="home-rail-proj"
                        href={url(`/projects/${project.id}/`)}
                      >
                        {project.data.image && (
                          <img
                            class="home-rail-thumb"
                            src={url(project.data.image)}
                            alt=""
                            loading="lazy"
                            decoding="async"
                          />
                        )}
                        <span class="home-rail-proj-main">
                          <span class="home-rail-proj-title">
                            {project.data.title}
                          </span>
                          <span class="home-rail-proj-year">
                            {project.data.date.getUTCFullYear()}
                          </span>
                        </span>
                      </a>
                    </li>
                  ))}
                </ol>
              </section>
            )
          }

          {
            notebookPosts.length > 0 && (
              <section
                class="home-rail-group home-rail-group--notes"
                data-reveal
                style="--reveal-delay: 0.24s;"
              >
                <h3 class="home-rail-label">
                  <a
                    class="home-rail-label-link"
                    href={url("/journal") + "#notebook"}
                  >
                    <span class="rail-label-all">All&nbsp;</span>Notes<span
                      class="rail-label-arrow"
                      aria-hidden="true">&rarr;</span
                    >
                  </a>
                </h3>
                <ol data-pagefind-ignore class="home-rail-list">
                  {notebookPosts.map((post, i) => {
                    const link = postLink(post);
                    return (
                      <li class="home-rail-item" style={`--i: ${i}`}>
                        {link.href ? (
                          <a
                            class="home-rail-title"
                            href={link.href}
                            {...(link.external
                              ? { target: "_blank", rel: "noopener noreferrer" }
                              : {})}
                            set:html={renderInline(post.data.title)}
                          />
                        ) : (
                          <span
                            class="home-rail-title"
                            set:html={renderInline(post.data.title)}
                          />
                        )}
                        <div class="home-row-meta home-row-date">
                          {/* Notes are evergreen — their topic says more than
                              a date would. Deliberately NOT coloured: the rail
                              is the quiet column, and the subject accent is
                              reserved for the "From the Journal" lead rows. */}
                          {post.data.topic ??
                            post.data.pubDate.toLocaleDateString("en-us", {
                              year: "numeric",
                              month: "short",
                              day: "numeric",
                              timeZone: "UTC",
                            })}
                        </div>
                      </li>
                    );
                  })}
                </ol>
              </section>
            )
          }
        </aside>
      </div>

      {
        /* Get in touch: an editorial section in the page's own grammar
           (serif h2 + hot rule, left-aligned, in the reading column) rather
           than a centered full-bleed CTA strip. No surface needed, so it
           reads identically in both themes. */
      }
      <section class="home-contact" data-reveal>
        <h2 style="margin-top: 0;">Get in touch</h2>
        <p class="home-contact-line">
          I'm midway through my PhD and thinking about what comes next, in
          research or in industry. If you work on problems where modeling and
          simulation matter, I'd like to hear from you.
        </p>
          <div class="home-contact-links">
            <a href={`mailto:${contactEmail}`} class="home-more" style="--i: 0">
              Email<span class="home-more-arrow" aria-hidden="true">&rarr;</span>
            </a>
            {
              cvHref && (
                <a
                  href={cvHref}
                  target="_blank"
                  class="home-more"
                  style="--i: 1"
                  data-umami-event="cv-download"
                  data-umami-event-location="home-contact"
                >
                  CV<span class="home-more-arrow" aria-hidden="true">&rarr;</span>
                </a>
              )
            }
            {
              linkedin && (
                <a
                  href={linkedin.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="home-more"
                  style="--i: 2"
                >
                  LinkedIn<span class="home-more-arrow" aria-hidden="true">&rarr;</span>
                </a>
              )
            }
          </div>
      </section>

      {
        /* Quiet epilogue, the very last thing before the footer: the equation
           the opening simulation integrates. Easter egg, not a headline.
           TABLED for now — to re-enable, restore the import at the top of
           this file and render <EquationCoda /> right here. */
      }
    </main>
    <Footer />

    <script is:inline>
      // Pinned-scrub progress. The .hero-scroll section is taller than the
      // viewport; while its top is above the header and its bottom is still
      // below, the .hero-stage is pinned. We map how far we've scrolled THROUGH
      // that extra distance to 0..1 and write it as --hero-progress, which the
      // CSS turns into the sim→card crossfade. data-hero-active flips to "card"
      // past the midpoint so only the active layer captures the pointer.
      function initHeroScroll() {
        const section = document.querySelector("[data-hero-scroll]");
        if (!section) return;
        // Tear down any prior instance — either this section's own handle, or a
        // window-scoped one left by a previous home visit whose section node was
        // swapped away (its DOM handle went with it).
        if (section._heroScrollCleanup) section._heroScrollCleanup();
        else window.__heroScrollCleanup?.();

        const stage = section.querySelector(".hero-stage");
        const cue = section.querySelector("[data-hero-cue]");
        const docEl = document.documentElement;
        const mqReduce = window.matchMedia("(prefers-reduced-motion: reduce)");

        let raf = null;

        // The scrub runs on ALL viewport sizes (mobile included — the card
        // just recomposes to a single column there). Only reduced-motion gets
        // the static stacked fallback.
        function isFallback() {
          return mqReduce.matches;
        }

        // SNAP MODEL — JS settle on scroll-idle (NOT CSS scroll-snap).
        //
        // The crossfade is a free scrub: --hero-progress follows scrollY, so the
        // sim↔card swap scrubs smoothly in BOTH directions. To stop the page
        // resting half-faded we add the settle in JAVASCRIPT instead of CSS
        // scroll-snap. CSS snap was tried (mandatory, then proximity) and its
        // per-frame pull always fought the scrub: with a snap point at the very top
        // (sim) and one at the card it trapped you at the card scrolling up and at
        // the top scrolling down, and on Chrome the top-edge re-snap compounded with
        // the rubber-band into a runaway "scroll up forever" (the sticky header
        // drifting into mid-viewport). Firefox showed the pull as an abrupt teleport
        // past the fade. The JS settle below only fires AFTER scrolling stops, so it
        // never fights an in-progress gesture — no trap, no runaway.
        //
        // We ALSO keep `overscroll-behavior-y: none` while the hero is in view: it
        // contains the rubber-band at the document's top edge so a hard flick up
        // can't overscroll past scrollY 0 (belt-and-suspenders for the runaway).
        // Scoped to <html> only while you're at/near the hero; cleared once you've
        // scrolled to the content below (and in cleanup) so other pages — and
        // pull-to-refresh — behave normally.
        const GUARD_OFF_BELOW = 0.985; // scrolled past the hero → drop the guard
        let armed = false;

        function enableGuard(on) {
          if (on === armed) return;
          armed = on;
          docEl.style.overscrollBehaviorY = on ? "none" : "";
        }
        function setGuardForProgress(p) {
          if (isFallback()) {
            enableGuard(false);
            return;
          }
          enableGuard(p < GUARD_OFF_BELOW);
        }
        function applyGuard() {
          enableGuard(false);
          setGuardForProgress(progress());
        }

        // --- JS idle-settle ---------------------------------------------------
        // After scrolling stops inside the transition band, glide to the sim or
        // the card. The target is biased by the LAST scroll direction so a small
        // flick commits the way you were heading (instead of a hard 0.5 midpoint):
        //   scrolling DOWN → commit to the card, unless still right at the top
        //                    (p < FLICK) where a tiny nudge settles back to the sim
        //   scrolling UP   → commit to the sim, unless still right at the bottom
        //                    (p > 1-FLICK) where a tiny nudge settles back to the card
        // dir 0 (e.g. resize) falls back to the nearest endpoint by the midpoint.
        const SETTLE_IDLE_MS = 110; // quiet time after last scroll before settling
        const FLICK = 0.12; // dead-zone near an endpoint that resists the flick
        // Pointer class picks the settle MECHANISM (see doSettle): fine
        // pointers get a smooth scroll glide; touch devices get an instant
        // scroll jump + visual tween, because a programmatic glide re-expands
        // the collapsed mobile URL bar (Brave/Firefox iOS) → viewport resize
        // → jarring page shift.
        const mqFinePointer = window.matchMedia(
          "(hover: hover) and (pointer: fine)",
        );
        let settleTimer = null;
        let settling = false; // true while OUR programmatic glide is running
        let lastY = window.scrollY;
        let dir = 0; // +1 down, -1 up, 0 none
        // Touch settle is TWO-PHASE. Phase 1 (on release + idle): tween the
        // VISUALS to the endpoint, no scrolling — a programmatic scroll with
        // no finger down makes iOS Brave/Firefox re-expand the URL bar
        // (viewport resize + page shift). Phase 2 (next touchstart): commit
        // scrollY invisibly — inside the pinned band scroll position has no
        // visual expression, and a scroll during an active touch doesn't
        // toggle browser chrome.
        let touchDown = false;
        let pendingSnapY = null; // scrollY to commit at the next touchstart
        let snapRestY = 0; // where scrollY actually rests while deferred

        function settleTarget(p) {
          if (dir > 0) return p < FLICK ? 0 : 1; // heading down → card
          if (dir < 0) return p > 1 - FLICK ? 1 : 0; // heading up → sim
          return p < 0.5 ? 0 : 1; // no direction → nearest
        }
        // Glide from progress pFrom to an ENDPOINT pTo (0 = sim, 1 = card).
        // Shared by the idle settle and the scroll-cue click.
        //
        // `realScroll` forces the scrolling mechanism even on touch. The idle
        // settle defers its scroll commit (see below) because it fires after
        // EVERY gesture, and the deferral is short — a few hundred px of
        // half-finished transition. The cue click is neither: it jumps the
        // whole scrub at once, so a deferred commit leaves scrollY a full
        // viewport away from what's on screen, and the next swipe on mobile
        // scrubs the crossfade again from the sim instead of moving on past
        // the card. The URL-bar reason for deferring doesn't apply here
        // either — the cue is only clickable at the top of the page, where
        // the bar is expanded already.
        function settleTo(pFrom, pTo, realScroll) {
          const m = metrics();
          // The card endpoint is the START of the hold (transition just
          // finished), not the end of the section — settling to the section
          // end would silently spend the hold distance.
          const targetY = pTo === 0 ? m.start : m.start + m.scrub;
          if (Math.abs(targetY - window.scrollY) < 1) return;
          settling = true;
          if (realScroll || mqFinePointer.matches) {
            // Desktop: smooth glide. Fine here — no dynamic URL bar to poke.
            window.scrollTo({ top: targetY, behavior: "smooth" });
            // Clear the settling flag once we've effectively arrived (smooth
            // scroll has no completion event). Poll briefly; bail out if the
            // user grabs the scroll again (onScroll cancels on real input).
            const startedAt = performance.now();
            const check = () => {
              if (!settling) return;
              if (
                Math.abs(window.scrollY - targetY) < 2 ||
                performance.now() - startedAt > 700
              ) {
                settling = false;
                return;
              }
              requestAnimationFrame(check);
            };
            requestAnimationFrame(check);
            return;
          }
          // Touch: phase 1 — tween visuals only; scrollY stays put until the
          // next gesture (see onTouchStart). See the pendingSnapY comment.
          pendingSnapY = targetY;
          snapRestY = window.scrollY;
          const DUR = 300;
          const t0 = performance.now();
          const step = () => {
            if (tweenRaf == null) return; // cancelled by real input
            const k = Math.min(1, (performance.now() - t0) / DUR);
            const e = k < 0.5 ? 4 * k * k * k : 1 - Math.pow(-2 * k + 2, 3) / 2;
            applyProgress(pFrom + (pTo - pFrom) * e, 0);
            if (k < 1) {
              tweenRaf = requestAnimationFrame(step);
            } else {
              tweenRaf = null;
              settling = false;
            }
          };
          tweenRaf = requestAnimationFrame(step);
        }
        function doSettle() {
          settleTimer = null;
          if (isFallback() || settling) return;
          const p = progress();
          if (p <= 0.001 || p >= 0.999) return; // endpoint or inside the hold
          settleTo(p, settleTarget(p));
        }
        function scheduleSettle() {
          // Never settle under a held finger: a stationary touch produces the
          // same scroll-event silence as a released one, but the user still
          // owns the scrub. Re-armed by onTouchEnd when the finger lifts.
          if (touchDown) return;
          if (settleTimer != null) clearTimeout(settleTimer);
          settleTimer = window.setTimeout(doSettle, SETTLE_IDLE_MS);
        }

        // The pinned distance splits into TRANSITION (progress 0→1 over the
        // first 1−HOLD_FRACTION of the travel) and HOLD (progress stays 1
        // while the finished card remains pinned) — so a single fast gesture
        // can't blow through the transition AND past the card. Must match the
        // --hero-travel comment in the CSS above.
        const HOLD_FRACTION = 0.2;

        function metrics() {
          const headerH =
            (stage && parseFloat(getComputedStyle(stage).top)) || 4.5 * 16;
          // Pinned height comes from the STAGE, not window.innerHeight: the
          // stage is sized in svh/lvh (stable units), while innerHeight
          // tracks the mobile URL bar and oscillates DURING a scroll gesture.
          // Deriving the scrub length from innerHeight remapped scrollY →
          // progress on every bar frame — the hero-card jitter on iOS.
          const pinned = stage
            ? stage.offsetHeight
            : window.innerHeight - headerH;
          const travel = Math.max(1, section.offsetHeight - pinned);
          const scrub = Math.max(1, travel * (1 - HOLD_FRACTION));
          const sectionTop =
            section.getBoundingClientRect().top + window.scrollY;
          const start = sectionTop - headerH;
          return { start, end: start + travel, travel, scrub };
        }
        function progress() {
          const m = metrics();
          return Math.min(
            1,
            Math.max(0, (window.scrollY - m.start) / m.scrub),
          );
        }

        // The cue is clickable only while it's actually visible. Its CSS fade
        // ends at progress 0.15, and a transparent element still hit-tests —
        // without this, an invisible cue would keep swallowing clicks at the
        // bottom of the viewport for the rest of the transition.
        const CUE_HIT_BELOW = 0.15;
        let cueHittable = null;
        function setCueHittable(on) {
          if (!cue || on === cueHittable) return;
          cueHittable = on;
          cue.style.pointerEvents = on ? "auto" : "none";
        }

        // Write one visual frame. Shared by the scroll path (update) and the
        // touch-settle tween (doSettle), so both drive the same choreography.
        function applyProgress(p, hp) {
          section.style.setProperty("--hero-progress", p.toFixed(4));
          section.style.setProperty("--hero-hold", hp.toFixed(4));
          section.setAttribute("data-hero-active", p > 0.5 ? "card" : "sim");
          // PERF: freeze the sim the moment the gas starts fading — the
          // canvas holds its last frame (preserveDrawingBuffer), so the
          // scrub blurs a static image instead of re-blurring a live 60fps
          // animation, and nothing renders behind the invisible canvas in
          // the card/hold states. Resumes when scrolled back to the top.
          window.__heroSimSetGasActive?.(p < 0.03);
          setGuardForProgress(p);
          setCueHittable(p < CUE_HIT_BELOW);
        }
        // Non-null while the touch settle is tweening the visuals; update()
        // must not stomp the tween's frames with scroll-derived ones.
        let tweenRaf = null;
        function cancelTween() {
          if (tweenRaf != null) {
            cancelAnimationFrame(tweenRaf);
            tweenRaf = null;
          }
        }
        function update() {
          raf = null;
          // In the reduced-motion fallback there's no scrub.
          if (isFallback()) {
            section.style.setProperty("--hero-progress", "0");
            section.style.setProperty("--hero-hold", "0");
            section.removeAttribute("data-hero-active");
            window.__heroSimSetGasActive?.(true);
            return;
          }
          const m = metrics();
          const y = window.scrollY;
          const p = Math.min(1, Math.max(0, (y - m.start) / m.scrub));
          // Hold progress: 0→1 across the pinned distance AFTER the
          // transition; drives the card's slow drift (CSS --hero-hold).
          const hp = Math.min(
            1,
            Math.max(0, (y - m.start - m.scrub) / (m.travel - m.scrub)),
          );
          if (tweenRaf != null) return; // settle tween owns the visuals
          // While a snap commit is deferred, hold the endpoint visuals —
          // bar-induced scroll/resize noise must not un-commit the crossfade.
          if (pendingSnapY != null) return;
          applyProgress(p, hp);
        }
        function onScroll() {
          const y = window.scrollY;
          // Deferred-snap dormancy: ignore small (URL-bar-induced) drift, but
          // anything that moves scrollY far from its rest position is a real
          // scroll — release the deferral and resume normal mapping.
          if (
            pendingSnapY != null &&
            (touchDown || Math.abs(y - snapRestY) > 60)
          ) {
            pendingSnapY = null;
          }
          // Only REAL user scrolling cancels an in-flight settle and re-arms the
          // idle timer. Our own programmatic glide (settling) must not cancel
          // itself or it would never reach the endpoint.
          if (!settling) {
            if (y !== lastY) dir = y > lastY ? 1 : -1;
            if (!isFallback()) scheduleSettle();
          }
          lastY = y;
          if (raf == null) raf = requestAnimationFrame(update);
        }
        // Lock 1svh to a pixel value, measured while the URL bar is expanded
        // (page load / width change). Safari's svh is already static, but iOS
        // Brave/Firefox report svh DYNAMICALLY as their toolbars collapse —
        // every svh-sized hero box then resized with the bar, shoving the
        // whole page (the "site jumps when the bar grows" bug). A hidden
        // 100svh probe reads whatever the browser's svh means right now.
        function lockSvh() {
          const probe = document.createElement("div");
          probe.style.cssText =
            "position:absolute;height:100svh;width:0;visibility:hidden;pointer-events:none";
          document.body.appendChild(probe);
          const h = probe.offsetHeight || window.innerHeight;
          probe.remove();
          docEl.style.setProperty("--hero-svh", (h / 100).toFixed(2) + "px");
        }
        let lockedW = window.innerWidth;
        lockSvh();
        // Resize only re-renders — it must NEVER schedule a settle. On mobile
        // the URL bar firing resize at gesture end otherwise queued a
        // programmatic scroll, which re-shows the bar → another resize → the
        // sudden page shift reported on Brave/Firefox iOS. The svh lock is
        // re-measured only when WIDTH changes (rotation / desktop resize);
        // height-only resizes are the bar itself and must not re-measure.
        function onResize() {
          if (window.innerWidth !== lockedW) {
            lockedW = window.innerWidth;
            lockSvh();
          }
          if (raf == null) raf = requestAnimationFrame(update);
        }

        // Real input intent (wheel/touch/keyboard) ALWAYS interrupts an in-flight
        // settle so the user can grab the scroll back mid-glide — without this the
        // `settling` guard in onScroll would swallow their input until arrival.
        const cancelSettle = () => {
          if (settleTimer != null) {
            clearTimeout(settleTimer);
            settleTimer = null;
          }
          cancelTween(); // real input takes the visuals back from the tween
          settling = false;
          // ...then re-arm. Cancelling alone left NOTHING scheduled, and the
          // timer is otherwise only armed from onScroll — so a wheel event that
          // moves scrollY by less than a pixel fires no scroll event, and the
          // hero rests half-faded with no snap. That is the tail of every
          // trackpad gesture: momentum decays into sub-pixel deltas that still
          // dispatch `wheel` but no longer move the page. (Invisible to
          // synthetic testing, where wheel input always scrolls.)
          //
          // Free when a scroll does follow: onScroll just resets this timer.
          // Safe from the cue click too — that calls cancelSettle() and then
          // immediately sets `settling`, which doSettle bails on.
          if (!isFallback()) scheduleSettle();
        };
        const onTouchStart = () => {
          touchDown = true;
          cancelSettle();
          // Phase 2 of the touch settle: commit the deferred snap invisibly
          // under the fresh gesture (see the pendingSnapY comment above).
          if (pendingSnapY != null) {
            const yTo = pendingSnapY;
            pendingSnapY = null;
            window.scrollTo({ top: yTo, behavior: "instant" });
            lastY = yTo;
          }
        };
        const onTouchEnd = (e) => {
          if (e.touches && e.touches.length > 0) return; // fingers remain
          touchDown = false;
          if (!isFallback()) scheduleSettle();
        };
        // Clicking the cue commits to the card in one gesture, using the same
        // settle glide a flick would get — so it lands exactly where the scrub
        // rests (the start of the hold) and inherits the touch path's deferred
        // scroll commit instead of poking the mobile URL bar.
        const onCueClick = () => {
          // Early in the intro the cue is still transparent (it fades in on
          // .cue-in) — don't let a target nobody can see skip the intro.
          if (
            docEl.hasAttribute("data-home-intro") &&
            !cue.classList.contains("cue-in")
          ) {
            return;
          }
          // A click is scroll intent, so it must END a running intro rather
          // than just release its lock (same reasoning as onScrollIntent):
          // while data-home-intro is set, the lock would pin us back to 0 and
          // the intro's canvas animation would override the crossfade.
          window.__homeIntroEnd?.();
          cancelSettle(); // don't let a queued idle settle fight the glide
          // Reduced motion has no scrub to glide through (the cue is
          // display:none there, so this is belt-and-braces).
          if (isFallback()) return;
          settleTo(progress(), 1, true);
        };
        cue?.addEventListener("click", onCueClick);
        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", onResize);
        window.addEventListener("wheel", cancelSettle, { passive: true });
        window.addEventListener("touchstart", onTouchStart, { passive: true });
        window.addEventListener("touchend", onTouchEnd, { passive: true });
        window.addEventListener("touchcancel", onTouchEnd, { passive: true });
        window.addEventListener("keydown", cancelSettle);
        const onMqChange = () => {
          applyGuard();
          update();
        };
        mqReduce.addEventListener("change", onMqChange);
        applyGuard();
        update();

        const cleanup = () => {
          cue?.removeEventListener("click", onCueClick);
          window.removeEventListener("scroll", onScroll);
          window.removeEventListener("resize", onResize);
          window.removeEventListener("wheel", cancelSettle);
          window.removeEventListener("touchstart", onTouchStart);
          window.removeEventListener("touchend", onTouchEnd);
          window.removeEventListener("touchcancel", onTouchEnd);
          window.removeEventListener("keydown", cancelSettle);
          mqReduce.removeEventListener("change", onMqChange);
          if (raf != null) cancelAnimationFrame(raf);
          if (settleTimer != null) clearTimeout(settleTimer);
          cancelTween();
          settling = false;
          pendingSnapY = null;
          docEl.style.removeProperty("--hero-svh");
          // Drop the page-scoped overscroll guard so other pages overscroll /
          // pull-to-refresh normally.
          enableGuard(false);
          delete section._heroScrollCleanup;
          window.__heroScrollCleanup = null;
        };
        section._heroScrollCleanup = cleanup;
        // Also expose on window so astro:before-swap can tear this down when
        // navigating AWAY from home — the section node (and its
        // _heroScrollCleanup) is discarded on swap, so a DOM-stored handle alone
        // would leak all the window listeners above (whose onScroll then keeps
        // running layout reads on every subsequent page). Mirrors HeroSim.
        window.__heroScrollCleanup = cleanup;
      }

      initHeroScroll();
      document.addEventListener("astro:page-load", initHeroScroll);

      function initHomeIntro() {
        const root = document.documentElement;
        if (!root.hasAttribute("data-home-intro")) return;
        // This runs TWICE on a fresh load — the direct call below, then the
        // astro:page-load that fires on first paint — and the attribute is
        // still set both times. Let only the first instance own the scroll
        // lock: a second set of lockScroll listeners survives the first's
        // release and pins the page back to 0 (it ate the scroll-cue click's
        // glide). The handle is nulled on release, so a genuine later visit
        // still initializes.
        if (window.__homeIntroReleaseScroll) return;

        // Reveal the scroll cue (idempotent — re-adding the class is a no-op).
        const showCue = () =>
          root.querySelector(".hero-scroll-cue")?.classList.add("cue-in");

        // Block scrolling during the intro WITHOUT hiding overflow (which would
        // remove the scrollbar track and shift the layout when the intro ends).
        // We just pin the window to the top until the intro completes; the
        // scrollbar track stays visible the whole time (html { overflow-y:
        // scroll }), so there's no width change.
        const lockScroll = (e) => {
          if (window.scrollY !== 0) window.scrollTo(0, 0);
          if (e && e.cancelable) e.preventDefault();
        };
        window.scrollTo(0, 0);
        window.addEventListener("scroll", lockScroll, { passive: true });
        window.addEventListener("wheel", lockScroll, { passive: false });
        window.addEventListener("touchmove", lockScroll, { passive: false });
        let released = false;
        const releaseScrollLock = () => {
          if (released) return;
          released = true;
          window.removeEventListener("scroll", lockScroll);
          window.removeEventListener("wheel", lockScroll);
          window.removeEventListener("touchmove", lockScroll);
          window.removeEventListener("wheel", onScrollIntent);
          window.removeEventListener("touchstart", onScrollIntent);
          window.removeEventListener("keydown", onScrollIntent);
          window.__homeIntroReleaseScroll = null;
          window.__homeIntroEnd = null;
          // If they broke the lock before the cue appeared, show it now so the
          // page reads as intentionally scrollable.
          showCue();
        };
        // RESPONSIVENESS: the lock only exists to play the intro "from the top".
        // The moment the user actually tries to scroll we END the intro
        // entirely (remove data-home-intro), not just release the lock.
        // Cutting it short matters for the scrub: while the attribute is
        // present, the introCanvasFade ANIMATION (fill: both) owns the
        // canvas's opacity and overrides the choreography's
        // `opacity: var(--b-gas)` — so a mid-intro scroller would carry a
        // frozen, full-opacity sim snapshot into the card view until the
        // intro timer expired. Removing the attribute unapplies all intro
        // animations: nav and grid snap to their resting states (visually
        // identical to the intro's end state) and the canvas immediately
        // follows the scroll choreography. The sim's own name-activation
        // flare runs off its persistent introStart clock, so it finishes
        // smoothly regardless. A short floor stops a stray load-time event
        // from skipping the intro. Without interaction, the timed removal
        // at the end still fires (below).
        const INTRO_SCROLL_FLOOR = 350; // ms before user intent can break the lock
        const introStart = performance.now();
        const SCROLL_KEYS = new Set([
          "ArrowDown",
          "ArrowUp",
          "PageDown",
          "PageUp",
          "End",
          "Home",
          " ",
        ]);
        const onScrollIntent = (e) => {
          // Ignore zoom/modifier gestures; only genuine scroll intent releases.
          if (e.type === "keydown" && !SCROLL_KEYS.has(e.key)) return;
          if (performance.now() - introStart < INTRO_SCROLL_FLOOR) return;
          // End the intro: unapplies every intro animation (see the note
          // above) and lets the below-the-fold content show normally.
          root.removeAttribute("data-home-intro");
          releaseScrollLock();
        };
        window.addEventListener("wheel", onScrollIntent, { passive: true });
        window.addEventListener("touchstart", onScrollIntent, {
          passive: true,
        });
        window.addEventListener("keydown", onScrollIntent);
        // If the user navigates AWAY mid-intro, release the lock so its window
        // listeners don't linger onto other pages.
        window.__homeIntroReleaseScroll = releaseScrollLock;
        // Clicking the scroll cue is scroll intent too, but it happens outside
        // this closure (initHeroScroll owns the cue) — so hand out the same
        // cut-the-intro-short path onScrollIntent takes. No INTRO_SCROLL_FLOOR
        // here: a click on the cue can't be a stray load-time event.
        window.__homeIntroEnd = () => {
          root.removeAttribute("data-home-intro");
          releaseScrollLock();
        };

        // Hold the intro state until everything finishes. The phases can OVERLAP
        // now (the sim may start mid-flicker), so the end is the latest of:
        //   - Phase 2 nav flicker end   (nav-fade + glow)
        //   - sim CSS fade end          (--intro-sim-at + --intro-sim-dur)
        //   - sim activation flicker end(--intro-sim-at + ~1300ms)
        //   - scroll-cue fade-in end    (--intro-sim-at + 1.3s + 0.6s)
        const cs = getComputedStyle(root);
        const ms = (name, fallback) => {
          const raw = cs.getPropertyValue(name).trim();
          if (!raw) return fallback;
          const v = raw.endsWith("ms")
            ? parseFloat(raw)
            : parseFloat(raw) * 1000;
          return isFinite(v) ? v : fallback;
        };
        // Resolve --intro-sim-at (a calc()) the same way HeroSim does: read it
        // back as a browser-resolved animation-delay from a throwaway probe.
        const resolveSimAt = () => {
          try {
            const probe = document.createElement("div");
            probe.style.position = "absolute";
            probe.style.animationName = "introCanvasFade";
            probe.style.animationDuration = "1s";
            probe.style.animationDelay = "var(--intro-sim-at)";
            root.appendChild(probe);
            const r = getComputedStyle(probe).animationDelay;
            probe.remove();
            const v = r.endsWith("ms") ? parseFloat(r) : parseFloat(r) * 1000;
            return isFinite(v) ? v : 1750;
          } catch {
            return 1750;
          }
        };
        const navFlickerEnd =
          ms("--intro-nav-fade", 1100) + ms("--intro-glow-dur", 1300);
        const simAt = resolveSimAt();
        const cssEnd = Math.max(
          navFlickerEnd,
          simAt + ms("--intro-sim-dur", 700),
        );
        const activationEnd = simAt + 1300; // matches HeroSim activatedIntroAlpha end

        // Final beat: trigger the scroll-cue fade-in (CSS transition) once the
        // name has finished igniting.
        const CUE_AT = simAt + 600; // start of the cue fade (earlier: as the name ignites)
        const CUE_DUR = 600; // must match the CSS transition duration
        const cueEnd = CUE_AT + CUE_DUR;
        window.setTimeout(showCue, CUE_AT);

        window.setTimeout(
          () => {
            root.removeAttribute("data-home-intro");
            releaseScrollLock();
          },
          Math.max(cssEnd, activationEnd, cueEnd) + 120,
        );
      }

      initHomeIntro();
      document.addEventListener("astro:page-load", initHomeIntro);
      document.addEventListener("astro:before-swap", () => {
        window.__homeIntroReleaseScroll?.();
        // Tear down the hero-scroll controller before its section is swapped
        // away, so its window listeners (scroll/resize/wheel/…) don't leak onto
        // the next page.
        window.__heroScrollCleanup?.();
      });

      // Scroll reveal for below-hero content. Reveal once when each [data-reveal]
      // scrolls into view; no un-reveal (so it doesn't flicker on scroll-up).
      function initReveal() {
        const items = document.querySelectorAll("[data-reveal]");
        if (!items.length) return;
        if (
          window.matchMedia("(prefers-reduced-motion: reduce)").matches ||
          !("IntersectionObserver" in window)
        ) {
          items.forEach((el) => el.classList.add("is-revealed"));
          return;
        }
        const io = new IntersectionObserver(
          (entries, obs) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("is-revealed");
                obs.unobserve(e.target);
              }
            }
          },
          // Trigger a bit before fully in view so it feels responsive.
          { rootMargin: "0px 0px -12% 0px", threshold: 0.05 },
        );
        items.forEach((el) => {
          el.classList.remove("is-revealed");
          io.observe(el);
        });
      }

      initReveal();
      document.addEventListener("astro:page-load", initReveal);
    </script>
  </body>
</html>
