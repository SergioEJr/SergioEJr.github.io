---
import { type CollectionEntry, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { getPublishedResearch } from '../../utils/posts';

export async function getStaticPaths() {
	const research = await getPublishedResearch();
	return research.map((entry) => ({
		params: { slug: entry.id },
		props: entry,
	}));
}
type Props = CollectionEntry<'research'>;

const entry = Astro.props;
const { Content, headings } = await render(entry);
const { title, abstract, date, paper, poster, code, bibtex } = entry.data;
import { url } from '../../utils/paths';
import ResourceBar from '../../components/ResourceBar.astro';

// Same set the Publications index offers, so an entry exposes the same
// resources whether you meet it in the list or on its own page (code and
// bibtex were previously dropped here).
const resources = [
	{ label: 'Paper', href: paper, external: true, event: 'paper-click' },
	{ label: 'Poster', href: poster ? url(poster) : undefined, external: true, event: 'poster-click' },
	{ label: 'Code', href: code, external: true, event: 'code-click' },
].flatMap((item) => (item.href ? [{ ...item, href: item.href }] : []));

// Meta/SEO description: use the abstract if present, else the title.
const metaDescription = abstract ?? title;
---

<BlogPost
	title={title}
	description={metaDescription}
	pubDate={date}
	id={entry.id}
	headings={headings}
	toc={headings.length > 1}
	noHero={true}
>
	<ResourceBar items={resources} bibtex={bibtex} title={title} />
	<Content />
</BlogPost>

