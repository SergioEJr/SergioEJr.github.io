---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import JournalPost from '../../components/JournalPost.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { url } from '../../utils/paths';
import { pageFade } from '../../utils/pageTransition';
import { getPublishedPosts } from '../../utils/posts';
import { BLOG_CATEGORY_COLORS, BLOG_CATEGORY_LABELS } from '../../utils/categories';

export async function getStaticPaths() {
	const posts = await getPublishedPosts();
	const tags = [...new Set(posts.flatMap((post) => post.data.tags || []))];

	return tags.map((tag) => ({
		params: { tag },
		props: {
			posts: posts
				.filter((post) => post.data.tags?.includes(tag))
				.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
		},
	}));
}

const { tag } = Astro.params;
const { posts } = Astro.props;

const catColor = (c: string) => BLOG_CATEGORY_COLORS[c] ?? 'var(--color-accent)';
const catLabel = (c: string) => BLOG_CATEGORY_LABELS[c] ?? c;

// Running index numbers the rows, matching the Journal's reverse-chronological
// numbering (newest = highest). Notebook entries render un-numbered inside
// JournalPost, so they simply skip a number.
const postNumber = new Map<string, number>();
posts.forEach((p, i) => postNumber.set(p.id, posts.length - i));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Posts tagged "${tag}" | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main transition:animate={pageFade}>
			<div class="tag-page">
				<div class="tag-head">
					<div class="tag-eyebrow">Tag</div>
					<h1 class="tag-title">#{tag}</h1>
					<p class="tag-sub">
						{posts.length} {posts.length === 1 ? 'entry' : 'entries'} ·{' '}
						<a href={url('/blog')} class="tag-back">Back to the Journal</a>
					</p>
				</div>

				<div class="j-list">
					{
						posts.map((post) => (
							<JournalPost
								post={post}
								number={postNumber.get(post.id) ?? 0}
								catColor={catColor(post.data.category)}
								catLabel={catLabel(post.data.category)}
							/>
						))
					}
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.tag-page {
		max-width: var(--max-width);
		margin: 0 auto;
	}
	.tag-head {
		margin: 1rem 0 0.5rem;
	}
	.tag-eyebrow {
		font-size: 0.72rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: var(--color-text-muted);
		margin-bottom: 0.4rem;
	}
	.tag-title {
		font-family: var(--font-serif);
		font-size: 2.4rem;
		line-height: 1.1;
		margin: 0 0 0.5rem;
		border-bottom: none;
	}
	.tag-sub {
		color: var(--color-text-muted);
		font-size: 0.95rem;
		margin: 0;
	}
	.tag-back {
		color: var(--color-accent);
		text-decoration: none;
	}
	.tag-back:hover {
		text-decoration: underline;
	}
	/* JournalPost rows separate themselves with their own bottom borders. */
	.j-list {
		margin-top: 1.5rem;
	}
</style>
