---
import { type CollectionEntry, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { PROJECT_CATEGORY_VARS } from '../../utils/categories';
import { url } from '../../utils/paths';
import { getPublishedProjects } from '../../utils/posts';
import ResourceBar from '../../components/ResourceBar.astro';

export async function getStaticPaths() {
	const projects = await getPublishedProjects();
	return projects.map((project) => ({
		params: { slug: project.id },
		props: project,
	}));
}
type Props = CollectionEntry<'projects'>;

const project = Astro.props;
const { Content, headings } = await render(project);
const { title, description, date, repo, link, categories, articleImage } = project.data;

const resources = [
	{ label: 'Visit', href: link, external: true, event: 'project-link', kind: 'visit' },
	{ label: 'Code', href: repo, external: true, event: 'project-link', kind: 'code' },
].flatMap((item) => (item.href ? [{ ...item, href: item.href }] : []));

const categoryBadges = categories.map((c) => ({
	label: c,
	color: PROJECT_CATEGORY_VARS[c] ?? 'var(--color-accent)',
}));
---

<BlogPost
	title={title}
	description={description}
	pubDate={date}
	id={project.id}
	headings={headings}
	toc={headings.length > 1}
	noHero={true}
	categoryBadges={categoryBadges}
>
	{articleImage && (
		<div class="project-article-image" slot="hero">
			<img src={url(articleImage)} alt={title} loading="eager" fetchpriority="high" decoding="async" />
		</div>
	)}
	<ResourceBar items={resources} title={title} label="Links" />
	<Content />
</BlogPost>

<style>
	.project-article-image {
		width: 100%;
		max-width: 1020px;
		margin: 0 auto;
		overflow: hidden;
		border-radius: 12px;
		box-shadow: var(--shadow-md);
	}
	.project-article-image img {
		display: block;
		width: 100%;
		height: auto;
	}
</style>
