---
import { type CollectionEntry, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { BLOG_CATEGORY_LABELS } from '../../utils/categories';
import { getPublishedPosts, postHasDetailPage } from '../../utils/posts';

export async function getStaticPaths() {
	const posts = await getPublishedPosts();
	// Pointer posts (externalUrl / linkTo) link straight to a target, and
	// link-less update posts (noLink) have no destination at all — neither
	// renders its own detail page. postHasDetailPage centralizes that rule.
	return posts
		.filter(postHasDetailPage)
		.map((post) => ({
			params: { slug: post.id },
			props: post,
		}));
}
type Props = CollectionEntry<'journal'>;

const post = Astro.props;
const { Content, headings } = await render(post);

// Header badge. Essays posts show their SUBJECT (Science / Math / Ideas) in the
// subject color, mirroring the Journal row eyebrow; other registers show the
// register label + register color. Colors are global --cat-* / --subj-* vars.
const isEssayWithSubject =
	post.data.category === 'essays' && !!post.data.subject;
const categoryBadges = [{
	label: isEssayWithSubject
		? post.data.subject!
		: (BLOG_CATEGORY_LABELS[post.data.category] ?? post.data.category),
	color: isEssayWithSubject
		? `var(--subj-${post.data.subject}, var(--color-accent))`
		: `var(--cat-${post.data.category}, var(--color-accent))`,
}];
---

<BlogPost {...post.data} id={post.id} headings={headings} categoryBadges={categoryBadges}>
	<Content />
</BlogPost>
