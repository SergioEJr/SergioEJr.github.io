---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { SITE_TITLE, TOPIC_REQUEST_MAILTO } from "../../consts";
import { pageFade } from "../../utils/pageTransition";
import { getPublishedPosts } from "../../utils/posts";
import JournalEssayRow from "../../components/JournalEssayRow.astro";
import JournalNoteRow from "../../components/JournalNoteRow.astro";
import JournalUpdateEntry from "../../components/JournalUpdateEntry.astro";
import JournalGlowField from "../../components/JournalGlowField.astro";
import { BLOG_CATEGORY_LABELS } from "../../utils/categories";

type Cat = "all" | "updates" | "essays" | "notebook";

// Registers (organize by reader intent, not subject). `color` is a theme-flipping
// CSS var (defined in global.css) so the header/pill color adapts to light/dark.
const CATS: Record<
  Cat,
  { label: string; color: string; title: string; subtitle: string }
> = {
  updates: {
    label: BLOG_CATEGORY_LABELS.updates,
    color: "var(--cat-updates)",
    title: "The story so far",
    subtitle: "Announcements, milestones, and what I’m up to.",
  },
  essays: {
    label: BLOG_CATEGORY_LABELS.essays,
    color: "var(--cat-essays)",
    title: "Ideas worth sharing",
    subtitle:
      "Big-picture ideas in life, science, and math to be read by anyone.",
  },
  notebook: {
    label: BLOG_CATEGORY_LABELS.notebook,
    color: "var(--cat-notebook)",
    title: "Things I’m learning",
    subtitle:
      "A growing notebook of guides and notes spanning from technical to plain.",
  },
  // "All" is not a register — give it a neutral ink color (not the accent blue,
  // which collides with the Updates blue in dark mode) since it renders as the
  // text-style filter, and a title that isn't a repeat of a filter label.
  all: {
    label: "All",
    color: "var(--color-text-main)",
    title: "The Journal",
    subtitle: "Updates, essays, and a living notebook.",
  },
};
// Pills run in front-page order (Essays → Notebook → Updates), matching the
// weight each register gets in the "All" view. "All" renders separately as the
// text-style button on the right — it's the unfiltered view, not a register.
const FILTER_ORDER: Cat[] = ["essays", "notebook", "updates"];

// How much of each register the front page shows before deferring to that
// register's own view. Everything currently fits; this is what keeps "All" a
// front page rather than a dump as the Journal grows.
const FRONT_ESSAYS = 5;
const FRONT_NOTES = 5;
const FRONT_UPDATES = 6;

// Newest first everywhere, with a stable id tiebreak so posts sharing a pubDate
// keep a consistent order between builds.
const posts = (await getPublishedPosts()).sort(
  (a, b) =>
    b.data.pubDate.valueOf() - a.data.pubDate.valueOf() ||
    a.id.localeCompare(b.id),
);

const essays = posts.filter((p) => p.data.category === "essays");
const notes = posts.filter((p) => p.data.category === "notebook");
const updates = posts.filter((p) => p.data.category === "updates");

const counts: Record<Cat, number> = {
  all: posts.length,
  essays: essays.length,
  notebook: notes.length,
  updates: updates.length,
};

// Topics for the Notebook sidebar, alphabetical.
const topicCounts = new Map<string, number>();
for (const p of notes) {
  const t = p.data.topic;
  if (t) topicCounts.set(t, (topicCounts.get(t) || 0) + 1);
}
const topics = [...topicCounts.entries()].sort((a, b) =>
  a[0].localeCompare(b[0]),
);

// Notebook posts grouped by topic. `notes` is newest-first, so the first time a
// topic appears is its newest post — that order is also the group order
// (newest-group-first). Posts within a group stay newest-first.
const noteGroupMap = new Map<string, typeof notes>();
for (const p of notes) {
  const t = p.data.topic ?? "Other";
  if (!noteGroupMap.has(t)) noteGroupMap.set(t, []);
  noteGroupMap.get(t)!.push(p);
}
const noteGroups = [...noteGroupMap.entries()].map(([topic, ps]) => ({
  topic,
  count: ps.length,
  posts: ps,
}));

// Updates grouped by year for the timeline spine. The list is newest-first, so
// the years come out newest-first too. UTC to match FormattedDate — frontmatter
// dates parse as UTC midnight, and a build machine behind UTC would otherwise
// file a Jan 1 post under the previous year.
function groupByYear(list: typeof updates) {
  const m = new Map<number, typeof updates>();
  for (const p of list) {
    const y = p.data.pubDate.getUTCFullYear();
    if (!m.has(y)) m.set(y, []);
    m.get(y)!.push(p);
  }
  return [...m.entries()].map(([year, ps]) => ({ year, posts: ps }));
}
const updateYears = groupByYear(updates);
const railYears = groupByYear(updates.slice(0, FRONT_UPDATES));
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Journal | ${SITE_TITLE}`}
      description="Updates, essays, and a notebook of things I'm learning."
    />
  </head>
  <body>
    <Header />
    <main
      id="journal"
      data-view="all"
      style="--cat-color: var(--color-accent);"
      transition:animate={pageFade}
    >
      <!-- Header (updated client-side per filter). The glow field is mounted
           here but draws a band that bleeds DOWN past .j-head to the bottom of
           the filter bar — it must stay a sibling of (not wrap) .j-filters-bar
           so the bar's position:sticky keeps #journal as its containing block. -->
      <header class="j-head">
        <JournalGlowField />
        <!-- First view per full page load: the glow field turns on like a
             light — ramp up with one flicker dip, then steady. Same pattern
             as the Research tick: synchronous pre-paint class, window flag so
             client-side nav within the session doesn't replay it. -->
        <script is:inline data-astro-rerun>
          if (!window.__journalGlowShown) {
            window.__journalGlowShown = true;
            document.querySelector(".j-head")?.classList.add("glow-intro");
          }
        </script>
        <div class="j-eyebrow">
          <span id="j-eyebrow-label">All</span> · <span
            id="j-eyebrow-count"
            data-count={counts.all}>{counts.all}</span
          > pieces
        </div>
        <h1 id="j-title">{CATS.all.title}</h1>
        <p id="j-subtitle" class="j-subtitle">{CATS.all.subtitle}</p>
      </header>

      <div class="j-filters-bar">
        <div class="j-filters">
          {
            FILTER_ORDER.map((c) => (
              <button
                class="j-filter"
                data-filter={c}
                style={`--f-color:${CATS[c].color}`}
                aria-pressed="false"
              >
                {CATS[c].label}
              </button>
            ))
          }
          <span class="j-filter-divider" aria-hidden="true"></span>
          <button
            class="j-filter j-filter--text active"
            data-filter="all"
            style={`--f-color:${CATS.all.color}`}
            aria-pressed="true"
          >
            {CATS.all.label}
          </button>
        </div>
      </div>

      {
        /* Four structurally different views, each rendered once and toggled with
           `hidden`. They are NOT one list reflowed by CSS: a timeline entry, a
           feature row, and a reference row want different markup, and morphing
           one into the others is what made the old single-list version fight
           itself (the CSS `order` hack, notes pretending to be timeline rows). */
      }
      {
        /* data-pagefind-ignore: this is a LISTING, and every row here also
           exists as its own indexed page. Without it a search for "calculus"
           returns the note, plus this page twice (Pagefind sub-results split it
           across the Notebook and All views), plus the home page's Journal
           picks — four hits, one piece of content. Listings shouldn't compete
           with what they list. The page still indexes its own heading/intro. */
      }
      <div class="j-views" data-pagefind-ignore>
        {/* ---------- ALL: the Journal's front page ---------- */}
        <section class="j-view j-front" data-view="all">
          <div class="j-front-main">
            {
              essays.length > 0 && (
                <section class="j-shelf">
                  <div class="j-shelf-head">
                    <h2 class="j-shelf-name">
                      Essays<span class="j-shelf-count">{counts.essays}</span>
                    </h2>
                    <a class="j-shelf-link" href="#essays" data-goto="essays">
                      Read all <span aria-hidden="true">&rarr;</span>
                    </a>
                  </div>
                  {essays.slice(0, FRONT_ESSAYS).map((post) => (
                    <JournalEssayRow post={post} />
                  ))}
                </section>
              )
            }

            {
              notes.length > 0 && (
                <section class="j-shelf">
                  <div class="j-shelf-head">
                    <h2 class="j-shelf-name">
                      From the notebook
                      <span class="j-shelf-count">{counts.notebook}</span>
                    </h2>
                    <a class="j-shelf-link" href="#notebook" data-goto="notebook">
                      Browse by topic <span aria-hidden="true">&rarr;</span>
                    </a>
                  </div>
                  {notes.slice(0, FRONT_NOTES).map((post) => (
                    <JournalNoteRow post={post} showTopic />
                  ))}
                </section>
              )
            }
          </div>

          {
            updates.length > 0 && (
              <aside class="j-rail">
                <div class="j-shelf-head j-rail-head">
                  <h2 class="j-shelf-name">
                    The story so far
                    <span class="j-shelf-count">{counts.updates}</span>
                  </h2>
                </div>
                <div class="j-timeline">
                  {railYears.map((y) => (
                    <Fragment>
                      <div class="j-tl-year">{y.year}</div>
                      {y.posts.map((post) => (
                        <JournalUpdateEntry post={post} compact />
                      ))}
                    </Fragment>
                  ))}
                </div>
                <p class="j-rail-more">
                  <a class="j-shelf-link" href="#updates" data-goto="updates">
                    Full timeline <span aria-hidden="true">&rarr;</span>
                  </a>
                </p>
              </aside>
            )
          }
        </section>

        {/* ---------- ESSAYS ---------- */}
        <section class="j-view j-essays" data-view="essays" hidden>
          {essays.map((post) => <JournalEssayRow post={post} />)}
        </section>

        {/* ---------- NOTEBOOK ---------- */}
        <section
          class="j-view j-nb"
          data-view="notebook"
          data-marker="rule"
          hidden
        >
          {
            /* Topics are a STRIP, not a sidebar. The group headers below are
               already a vertical index of the same topic names with the same
               counts, so a vertical rail beside them read as a duplicate index
               rather than a control. As a row it reads as what it is, and it's
               the same pill idiom as the register filters above — deliberately
               subordinate to them (sentence case and lighter, where those are
               uppercase and bold).
               role="group" + aria-label rather than leaning on .j-side-label:
               that label is display:none below 600px, which would leave the
               group unnamed on exactly the screens where it matters most. */
            topics.length > 0 && (
              <div
                class="j-nb-side"
                role="group"
                aria-label="Filter notes by topic"
              >
                <div class="j-side-label" aria-hidden="true">
                  Topics
                </div>
                <button
                  class="j-topic active"
                  data-topic="all"
                  aria-pressed="true"
                >
                  All <span>{counts.notebook}</span>
                </button>
                {topics.map(([t, n]) => (
                  <button class="j-topic" data-topic={t} aria-pressed="false">
                    {t} <span>{n}</span>
                  </button>
                ))}
                {/* The topic that doesn't exist yet. An <a>, not a button — it
                    navigates (mailto). Dashed border carries that meaning
                    literally rather than decoratively; no count, because there
                    is nothing to count and a "0" would be a loud number. */}
                <a class="j-topic j-topic--ask" href={TOPIC_REQUEST_MAILTO}>
                  <span class="j-ask-plus" aria-hidden="true">
                    +
                  </span>
                  Suggest a topic
                </a>
              </div>
            )
          }
          <div class="j-nb-main">
            {
              noteGroups.map((g) => (
                <section
                  class="j-nb-group"
                  data-topic={g.topic}
                  data-count={g.count}
                >
                  <div class="j-nb-group-head">
                    <span class="j-nb-group-name">{g.topic}</span>
                    <span class="j-nb-group-count">{g.count}</span>
                  </div>
                  {g.posts.map((post) => (
                    <JournalNoteRow post={post} />
                  ))}
                </section>
              ))
            }
          </div>
        </section>

        {/* ---------- UPDATES ---------- */}
        <section class="j-view j-updates" data-view="updates" hidden>
          <div class="j-timeline j-timeline--big">
            {
              updateYears.map((y) => (
                <Fragment>
                  <div class="j-tl-year">{y.year}</div>
                  {y.posts.map((post) => (
                    <JournalUpdateEntry post={post} />
                  ))}
                </Fragment>
              ))
            }
          </div>
        </section>
      </div>
    </main>
    <Footer />

    <script is:inline define:vars={{ cats: CATS, counts }}>
      function initJournalFilters() {
        const root = document.getElementById("journal");
        if (!root || root.dataset.filtersInitialized === "true") return;
        root.dataset.filtersInitialized = "true";

        const titleEl = document.getElementById("j-title");
        const subEl = document.getElementById("j-subtitle");
        const eyeLabel = document.getElementById("j-eyebrow-label");
        const eyeCount = document.getElementById("j-eyebrow-count");
        const box = document.querySelector(".j-views");
        const views = Array.from(document.querySelectorAll(".j-view"));
        const groups = Array.from(document.querySelectorAll(".j-nb-group"));
        const filters = Array.from(document.querySelectorAll(".j-filter"));
        const topicBtns = Array.from(document.querySelectorAll(".j-topic"));
        const bar = document.querySelector(".j-filters-bar");

        const validCats = filters.map((b) => b.getAttribute("data-filter"));
        const validTopics = topicBtns.map((b) => b.getAttribute("data-topic"));

        // Toggle a filter pill's visual + a11y active state together, so
        // aria-pressed never drifts from the .active class.
        const setActive = (btn, on) => {
          btn.classList.toggle("active", on);
          btn.setAttribute("aria-pressed", String(on));
        };

        let activeCat = "all";
        let activeTopic = "all";

        // The active filter lives in the URL hash so it survives navigation
        // (Back from a post returns to the chosen filter) and is shareable.
        //   #notebook     → Notebook, all topics
        //   #notebook:Git → Notebook, Git topic
        //   (no hash)     → All (default)
        function readHash() {
          const raw = decodeURIComponent(
            (location.hash || "").replace(/^#/, ""),
          );
          const [cat, topic] = raw.split(":");
          activeCat = validCats.includes(cat) ? cat : "all";
          activeTopic =
            activeCat === "notebook" && topic && validTopics.includes(topic)
              ? topic
              : "all";
          // Reflect the parsed state on the controls (class + aria-pressed).
          filters.forEach((b) =>
            setActive(b, b.getAttribute("data-filter") === activeCat),
          );
          topicBtns.forEach((b) =>
            setActive(b, b.getAttribute("data-topic") === activeTopic),
          );
        }

        // replaceState (not pushState): clicking through filters rewrites the
        // current entry instead of stacking Back steps, so one Back from a post
        // returns to the active filter rather than undoing filter clicks.
        //
        // PRESERVE the existing history.state. Astro's ClientRouter stores
        // {index, scrollX, scrollY} there and reads state.index on popstate to
        // track history position. Passing null (the old bug) wiped it, so a later
        // Back TO this filtered entry misfired the router — it skipped the document
        // swap entirely (only popstate fired, no astro:after-swap), leaving the
        // previous page's content (e.g. an article) stuck under the /journal/#filter
        // URL. Spreading history.state keeps the router's bookkeeping intact.
        function writeHash() {
          let hash = "";
          if (activeCat !== "all") {
            hash = "#" + activeCat;
            if (activeCat === "notebook" && activeTopic !== "all")
              hash += ":" + encodeURIComponent(activeTopic);
          }
          history.replaceState(
            history.state,
            "",
            hash || location.pathname + location.search,
          );
        }

        function apply() {
          const meta = cats[activeCat];
          root.style.setProperty("--cat-color", meta.color);
          titleEl.textContent = meta.title;
          subEl.textContent = meta.subtitle;
          eyeLabel.textContent = meta.label;
          root.setAttribute("data-view", activeCat);

          views.forEach((v) => {
            v.hidden = v.getAttribute("data-view") !== activeCat;
          });

          // Topic filter inside the Notebook view. The eyebrow count follows the
          // selection, so "Notebook · 2 pieces" matches what's on screen.
          let visible = counts[activeCat];
          if (activeCat === "notebook" && activeTopic !== "all") {
            visible = 0;
            groups.forEach((g) => {
              const show = g.getAttribute("data-topic") === activeTopic;
              g.style.display = show ? "" : "none";
              if (show) visible += Number(g.getAttribute("data-count")) || 0;
            });
          } else {
            groups.forEach((g) => {
              g.style.display = "";
            });
          }

          // Publish the count via data-count; the count-up module script
          // observes this attribute and rolls the odometer to the new value.
          // (It owns the element's contents, so we don't write textContent here.)
          eyeCount.setAttribute("data-count", String(visible));
        }

        // ---- Frost vs. glow ----
        // The bar's frost would otherwise cut the glow field down to whatever
        // its tint lets through, producing a hard horizontal step in the light
        // exactly at the bar's top edge. But while the glow band still reaches
        // the bar there is nothing behind the bar to frost — only the glow — so
        // the frost is simply not needed yet.
        //
        // The trigger is CONTENT, not the glow band: the frost comes off only
        // while nothing has reached the back of the bar yet, and goes on the
        // instant the first row would pass behind it. Keying it to the band
        // instead left a ~19px window where the list was already sliding under
        // an unfrosted bar and you could read it through the pills.
        //
        // A plain box comparison in VIEWPORT space — no scroll arithmetic, no
        // stick-point bookkeeping, and still correct when the header changes
        // height between views or the pills wrap on mobile.
        //
        // It's a switch, not a dimmer. Anything in between both dims the light
        // (the step this exists to remove) and leaves the bar a backdrop root,
        // which is what painted the rectangle across it. The switch lands where
        // the content edge is flush with the bar's bottom, so at that moment the
        // bar covers nothing but flat page background — and frosting flat
        // background is a no-op, since --color-bg-header IS --color-bg at 0.8
        // alpha and blurring one flat color returns it unchanged.
        let lastLit = null;
        function updateFrost() {
          const b = document.querySelector(".j-filters-bar");
          const content = document.querySelector(".j-views");
          if (!b || !content) return;
          const br = b.getBoundingClientRect();
          if (br.height === 0) return;
          // Small lead so the frost is already on before the first row reaches
          // the bar: this runs rAF-coalesced, and without it a fast scroll can
          // show a frame of content under a bare bar. The lead is spent on empty
          // margin, where frosting is invisible anyway.
          const lit = content.getBoundingClientRect().top >= br.bottom + 10;
          if (lit === lastLit) return;
          lastLit = lit;
          // Instant, not eased. The bar carries a 0.3s background-color
          // transition so the frost keeps pace with the theme toggle — but
          // easing it HERE would leave content sliding under a half-strength
          // tint for 300ms, which is exactly the "I can almost read it" state
          // this switch exists to prevent. Suppress the transition across the
          // toggle, commit it, then hand the stylesheet's transition back.
          b.style.transition = "none";
          b.toggleAttribute("data-lit", lit);
          // Mirrored onto #journal so CSS can put the glow field away with it.
          root.toggleAttribute("data-lit", lit);
          void b.offsetHeight;
          b.style.transition = "";
        }

        // rAF-coalesced: scroll fires far more often than we need to repaint.
        let frostQueued = false;
        function queueFrost() {
          if (frostQueued) return;
          frostQueued = true;
          requestAnimationFrame(() => {
            frostQueued = false;
            updateFrost();
          });
        }
        if (!window.__journalFrostBound) {
          window.__journalFrostBound = true;
          // Bound once on window (which outlives #journal across client-side
          // navigations); the handler re-resolves the live elements each call,
          // so it can't hold a detached bar from a previous visit.
          const onFrost = () => {
            const r = document.getElementById("journal");
            if (r && r.__queueFrost) r.__queueFrost();
          };
          window.addEventListener("scroll", onFrost, { passive: true });
          window.addEventListener("resize", onFrost, { passive: true });
        }
        root.__queueFrost = queueFrost;

        // Re-check whenever the boxes the trigger depends on change size — the
        // header is taller in some views, and the pill row wraps on mobile.
        // Owned by #journal so it's collected with the page on a client-side nav
        // rather than leaking a detached element.
        if (typeof ResizeObserver === "function") {
          if (root.__frostRO) root.__frostRO.disconnect();
          const ro = new ResizeObserver(queueFrost);
          if (bar) ro.observe(bar);
          const content = document.querySelector(".j-views");
          if (content) ro.observe(content);
          root.__frostRO = ro;
        }

        // Views differ a lot in height, so a reader deep in the timeline who
        // switches to Essays would otherwise land past the end of the new view.
        // This only ever pulls UP to the filter bar; it never pushes down.
        function keepFiltersInView() {
          if (!box || !bar) return;
          const target =
            box.getBoundingClientRect().top +
            window.scrollY -
            bar.offsetHeight -
            72; /* navbar height */
          if (window.scrollY > target) {
            window.scrollTo({ top: Math.max(0, target), behavior: "instant" });
          }
        }

        // `fadeBox` is WHAT FADES, and it is not always the whole view box.
        // A register switch replaces everything, so it fades .j-views. A topic
        // switch only re-filters the note list, so it fades .j-nb-main alone —
        // the topic strip is the control doing the filtering and must not blink
        // when you press it. It has to be excluded by CHOOSING A NARROWER
        // TARGET rather than by exempting the strip: opacity applies to the
        // whole subtree, so a descendant cannot opt out of an ancestor's fade.
        function fadeApply(fadeBox) {
          const el = fadeBox || box;
          if (!el) {
            apply();
            return;
          }
          el.style.opacity = "0";
          setTimeout(() => {
            apply();
            keepFiltersInView();
            queueFrost(); // header height changes per view, so re-measure
            // iOS WebKit (Safari — and Chrome/Firefox on iOS, which are also
            // WebKit) can leave a now-hidden row's title painted as a ghost over
            // the new content when `display` is toggled mid opacity-transition.
            // Tear down and rebuild the box's own paint. Opacity is 0 here, so
            // the toggle isn't visible; the reflow reads commit each step and
            // let the fade-in animate from 0.
            el.style.display = "none";
            void el.offsetHeight;
            el.style.display = "";
            void el.offsetHeight;
            el.style.opacity = "";
          }, 160);
        }

        function goTo(cat) {
          activeCat = cat;
          filters.forEach((b) =>
            setActive(b, b.getAttribute("data-filter") === activeCat),
          );
          activeTopic = "all";
          topicBtns.forEach((b) =>
            setActive(b, b.getAttribute("data-topic") === "all"),
          );
          writeHash();
          fadeApply();
        }

        filters.forEach((btn) => {
          btn.addEventListener("click", () => {
            const clicked = btn.getAttribute("data-filter");
            // Clicking the already-active register pill deselects it back to All.
            // (This is the only way back to All on mobile, where the All button is
            // hidden; on desktop it's a harmless second path alongside the button.)
            goTo(clicked !== "all" && clicked === activeCat ? "all" : clicked);
          });
        });

        // The front page's section links ("Read all", "Browse by topic", "Full
        // timeline") are the same navigation as the pills. They're real anchors
        // to the view's hash so ⌘/middle-click opens the filtered Journal in a
        // new tab; handled here we preventDefault and switch in place, keeping
        // the replaceState rule (a plain click must not stack a Back step).
        document.querySelectorAll("[data-goto]").forEach((el) => {
          el.addEventListener("click", (e) => {
            if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
            e.preventDefault();
            goTo(el.getAttribute("data-goto"));
          });
        });

        const nbMain = document.querySelector(".j-nb-main");
        topicBtns.forEach((btn) => {
          btn.addEventListener("click", () => {
            topicBtns.forEach((b) => setActive(b, b === btn));
            activeTopic = btn.getAttribute("data-topic");
            writeHash();
            // Fade the note list only — never the strip you just clicked.
            fadeApply(nbMain);
          });
        });

        // Re-apply when the hash changes without a re-init (manual edit, or a
        // Back step that only moves the hash within this same page). The
        // listener is on window (which outlives the #journal element across
        // client-side navigations), so register it once and have it re-resolve
        // the live controls each time.
        if (!window.__journalHashBound) {
          window.__journalHashBound = true;
          window.addEventListener("hashchange", () => {
            const r = document.getElementById("journal");
            if (r && r.__applyHash) r.__applyHash();
          });
        }
        root.__applyHash = () => {
          readHash();
          apply();
        };

        readHash();
        apply();
        // Two passes: now, and after the glow field has sized its canvas on the
        // next frame (until then there's no band to measure against).
        updateFrost();
        queueFrost();
      }

      initJournalFilters();
      document.addEventListener("astro:page-load", initJournalFilters);
    </script>

    <script>
      // Count-up odometer on the "N pieces" eyebrow count. Decoupled from the
      // inline filter script above: that script publishes the intended number on
      // #j-eyebrow-count's data-count attribute; we observe it and roll to it.
      import { createOdometer } from "../../utils/odometer";

      function initCountUp() {
        const countEl = document.getElementById("j-eyebrow-count");
        if (!countEl || (countEl as any).__odoBound) return;
        (countEl as any).__odoBound = true;

        const initial =
          parseInt(
            countEl.getAttribute("data-count") || countEl.textContent || "0",
            10,
          ) || 0;
        const odo = createOdometer(countEl);
        let last = initial;
        odo.to(initial); // roll 0 -> initial on first paint

        const obs = new MutationObserver(() => {
          const v =
            parseInt(countEl.getAttribute("data-count") || "0", 10) || 0;
          if (v === last) return; // skip no-op re-sets (e.g. apply() on init)
          last = v;
          odo.to(v);
        });
        obs.observe(countEl, {
          attributes: true,
          attributeFilter: ["data-count"],
        });
      }

      initCountUp();
      document.addEventListener("astro:page-load", initCountUp);
    </script>

    <script>
      // Journal-post click analytics, fired MANUALLY on pointerdown rather than
      // via umami's declarative `data-umami-event` attributes.
      //
      // Why: umami's built-in click tracking hooks the `click` event and sends
      // its beacon (POST gateway.umami.is/api/send) before the link's navigation
      // proceeds. In Firefox that send blocks the navigation for a noticeable
      // beat. pointerdown fires ~before the click that triggers navigation, so
      // tracking here puts the beacon in flight early and never delays the load.
      // See the `data-track-*` attrs on the row links (renamed from
      // data-umami-event so umami's own handler doesn't also fire and
      // re-introduce the block/double-count).
      //
      // One delegated listener on `document`, which survives ClientRouter swaps,
      // so it's registered exactly once (guarded) and covers every row type.
      (() => {
        const w = window as any;
        if (w.__journalTrackBound) return;
        w.__journalTrackBound = true;
        document.addEventListener(
          "pointerdown",
          (e) => {
            const a = (e.target as Element)?.closest?.(
              "a[data-track-journal]",
            ) as HTMLElement | null;
            if (!a || typeof w.umami?.track !== "function") return;
            w.umami.track("journal-post", {
              title: a.dataset.trackTitle,
              category: a.dataset.trackCategory,
              external: a.dataset.trackExternal,
            });
          },
          // passive: we never preventDefault; lets the browser proceed immediately.
          { passive: true, capture: true },
        );
      })();
    </script>

    <style>
      #journal {
        max-width: var(--max-width);
        background: inherit;
        /* Drop the view-transition-name that transition:animate puts on <main>.
           It makes <main> a BACKDROP ROOT, and a backdrop-filter can only sample
           within its root — so the filter bar's blur ran out of backdrop at
           <main>'s edges and composited the void as a dark fringe: the seam down
           the left of the bar, and a matching one on the right. Measured on real
           Brave at 1280px: a 0.76 luminance step exactly at the root's edge,
           which flattens to a smooth ramp once the name is gone.
           Safe to drop here: pageFade is already configured as an INSTANT
           transition (duration 0, animation none) and global.css force-disables
           ::view-transition-* animations, so the name was only ever naming
           something that doesn't move. The swap itself is the router's job and
           is unaffected.
           !important because the router re-asserts its own
           [data-astro-transition-scope] rule after a client-side swap, which
           otherwise wins and brings the seam back on every nav INTO the Journal
           (it stays gone on a hard load, which is what makes it easy to miss). */
        view-transition-name: none !important;
      }
      .j-head {
        padding: 1rem 0 0rem;
        position: relative;
        z-index: 1;
      }
      /* First view per full load (class set by the inline script in the
         header): the glow field turns ON — a smooth lamp-warm-up ramp, slow
         to start then easing to full. NO flicker dip: the glow's internal
         alphas are 0.05–0.1, so any mid-animation opacity dip multiplies
         down to invisible and reads as the light blinking OFF, not
         flickering. While the animation runs it outranks the canvas's
         IO-driven inline opacity; afterwards that resumes untouched. */
      .j-head.glow-intro :global(.journal-glow-field) {
        animation: journal-glow-on 1.4s 0.15s cubic-bezier(0.4, 0, 0.3, 1)
          backwards;
      }
      @keyframes journal-glow-on {
        from {
          opacity: 0;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        .j-head.glow-intro :global(.journal-glow-field) {
          animation: none;
        }
      }
      .j-filters-bar {
        position: sticky;
        top: 4.5rem; /* height of the navbar */
        z-index: 30; /* above the page content/title, below navbar (100) and mobile menu (200) */
        padding: 0.85rem 0;
        margin-bottom: 2.25rem;
        /* The bar's own box is unchanged: it spans the content column. Both the
           frost and the separator are drawn by pseudo-elements that bleed wider
           than it (see ::before and ::after). */
      }
      /* The frost, on its own layer so it can bleed to the viewport edges while
         the bar keeps its column geometry. It has to bleed: a backdrop-filter
         that stops mid-page draws a visible edge down the content. Out here its
         edges land on empty page, where a tint over flat background is a no-op.
         Values are exactly the navbar's; this is only ever fully on or fully off
         (see [data-lit]). z-index: -1 puts it behind the pills but inside the
         bar's own stacking context (sticky + z-index: 30), so it cannot slip
         behind the page. */
      .j-filters-bar::before {
        content: "";
        position: absolute;
        top: 0;
        bottom: 0;
        /* Percentages resolve against the bar's padding box (the content
           column), so this lands exactly on the viewport edges. */
        left: calc(50% - 50vw);
        right: calc(50% - 50vw);
        z-index: -1;
        pointer-events: none;
        background-color: var(--color-bg-header);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        /* Match the navbar/body theme transition so the frosted bg eases in sync. */
        transition: background-color 0.3s ease;
      }
      /* Separator: the navbar's own recipe (header::after) — a hairline that
         runs the full bleed and fades out at both ends rather than stopping on
         a hard edge. Bleeds with the frost, so the solid stretch is as long as
         the bar looks; confining it to the content column made it noticeably
         stubby. Lighter than the navbar's (0.35 vs 0.6) so this reads as a
         sub-bar rather than a second navbar. */
      .j-filters-bar::after {
        content: "";
        position: absolute;
        bottom: 0;
        left: calc(50% - 50vw);
        right: calc(50% - 50vw);
        height: 1px;
        pointer-events: none;
        background: linear-gradient(
          90deg,
          transparent 0%,
          var(--color-border) 20%,
          var(--color-border) 80%,
          transparent 100%
        );
        opacity: 0.35;
      }
      /* 50vw counts the scrollbar, so the bleed overshoots a few px. `clip`, NOT
         hidden/auto — those create a scroll container and break the sticky
         navbar — and on html/body ONLY, since a clip on any other ancestor of a
         sticky element demotes iOS sticky positioning to the main thread. */
      :global(html),
      :global(body) {
        overflow-x: clip;
      }
      /* Once the bar is frosted, the glow field is put away. By then the band is
         entirely behind the navbar and the bar (the frost only comes on when
         content is within 10px of the bar's bottom, and the bar's bottom margin
         is larger than that at every width), so hiding it costs nothing on
         screen — but it stops the frost from dimming the tail of the glow, which
         is what drew a seam down the frost's edge: light at full strength
         outside the bar, cut to a fifth of it inside. */
      #journal:not([data-lit]) :global(.journal-glow-field) {
        visibility: hidden;
      }
      /* Lit: the glow field still reaches the bar, so the only thing behind the
         bar is the glow — the frost has nothing to do and comes off entirely.
         It is never partially applied. A weakened frost both dims the light
         (the step this was meant to remove) and keeps the bar a backdrop root,
         where Chromium returns the composited glow canvas wrong and paints a
