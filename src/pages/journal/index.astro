        background: var(--cat-notebook);
        opacity: 0.45;
      }
      .j-nb[data-marker="rule"] .j-nb-group:first-child::before {
        top: 0.15rem;
      }

      /* C — DOT: one amber dot per note, at Essays parity. .j-note is already
         position:relative (JournalNoteRow), so this anchors to the row. */
      .j-nb[data-marker="dot"] :global(.j-nb-group .j-note::before) {
        content: "";
        position: absolute;
        left: calc(-1 * var(--j-nb-gutter));
