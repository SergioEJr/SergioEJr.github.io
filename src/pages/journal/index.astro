      /* "All" filter: plain text, not a pill (it's the unfiltered view). */
      .j-filter--text {
        border: none;
        background: transparent;
        padding: 0.35rem 0.5rem;
        border-radius: 0;
      }
      .j-filter--text:hover {
        color: var(--f-color);
        background: transparent;
        border-color: transparent;
      }
      .j-filter--text.active {
        color: var(--f-color);
        background: transparent;
        border-color: transparent;
        font-weight: 800;
      }

      /* ---------------- Views ---------------- */
      .j-views {
        transition: opacity 0.16s ease;
      }
      /* Explicit, because the layout rules below set `display` on these sections
         and would otherwise beat the `hidden` attribute's UA style. */
      .j-view[hidden] {
        display: none;
      }

      /* Shelf headers ("Essays 4 … Read all →") — the front page's dividers. */
      .j-shelf + .j-shelf {
        margin-top: 3rem;
      }
      .j-shelf-head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 1rem;
        padding: 0.4rem 0 0.55rem;
        border-bottom: 1px solid var(--color-border);
        transition: border-color 0.3s ease;
      }
      .j-shelf-name {
        font-family: var(--font-sans);
        font-size: 0.78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--color-text-main);
        margin: 0;
        line-height: 1.4;
      }
      /* Suppress the global h2 rule-mark: these are section labels, not article
         headings. */
      .j-shelf-name::after {
        content: none;
      }
      .j-shelf-count {
        font-variant-numeric: tabular-nums;
        color: var(--color-text-muted);
        font-weight: 600;
        margin-left: 0.45rem;
      }
      .j-shelf-link {
        font-family: inherit;
        font-size: 0.8rem;
        color: var(--color-text-muted);
        background: none;
        border: none;
        padding: 0;
        cursor: pointer;
        white-space: nowrap;
        text-decoration: none;
        transition: color 0.2s ease;
      }
      /* Cancel the global `a:hover { opacity: 0.8 }` graying — the color lift is
         the only intended hover cue. */
      .j-shelf-link:hover {
        color: var(--color-accent);
        opacity: 1;
      }

      /* ---------------- ALL: front page ---------------- */
      .j-front {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 280px;
        gap: 3.4rem;
        align-items: start;
      }
      .j-front-main {
        min-width: 0;
      }
      .j-rail {
        /* Sticks below the navbar + filter bar while the main column scrolls. */
        position: sticky;
        top: 9.5rem;
      }
      .j-rail-head {
        border-bottom: none;
        padding-bottom: 0.9rem;
      }
      .j-rail-more {
        margin: 1.1rem 0 0;
      }

      /* ---------------- Timeline spine ----------------
         Shared by the front-page rail and the Updates view. --j-tl-gutter is the
         left inset the entries hang off; --j-tl-spine-x is the spine's center,
         which JournalUpdateEntry reads to place its dot. */
      .j-timeline {
        --j-tl-gutter: 1.15rem;
        --j-tl-spine-x: 4px;
        position: relative;
        padding-left: var(--j-tl-gutter);
      }
      .j-timeline::before {
        content: "";
        position: absolute;
        left: 3px;
        top: 6px;
        bottom: 4px;
        width: 2px;
        background: var(--color-border);
        border-radius: 2px;
        transition: background-color 0.3s ease;
      }
      .j-timeline--big {
        --j-tl-gutter: 1.6rem;
        --j-tl-spine-x: 5px;
      }
      .j-timeline--big::before {
        left: 4px;
      }
      .j-tl-year {
        position: relative;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        color: var(--color-text-muted);
        font-variant-numeric: tabular-nums;
        margin: 1.15rem 0 0.5rem;
      }
      .j-tl-year:first-child {
        margin-top: 0;
      }
      /* A tick crossing the spine, so a year reads as a marker on the line
         rather than a floating label. */
      .j-tl-year::before {
        content: "";
        position: absolute;
        /* Centred on the spine so the tick CROSSES it evenly — it used to start
           at the timeline's left edge, putting its centre 2px to the right. */
        left: calc(var(--j-tl-spine-x) - var(--j-tl-gutter));
        top: 50%;
        transform: translate(-50%, -50%);
        width: 10px;
        height: 2px;
        /* Register colour, because the year is the timeline's section header
           and the entry dots below it are deliberately neutral. Muted grey here
           made the two levels the same weight, so the rail read flat. */
        background: var(--cat-updates);
        opacity: 0.85;
      }
      .j-timeline--big .j-tl-year {
        font-size: 0.95rem;
        color: var(--color-text-main);
        letter-spacing: 0.12em;
        margin: 2rem 0 0.4rem;
      }
      .j-timeline--big .j-tl-year:first-child {
        margin-top: 0;
      }
      /* The year is the section header of the timeline, so it carries the
         register colour and the entry dots stay neutral — same division the
         Notebook view uses (topic header coloured, notes not). Longer and at
         full strength so the structural marks read above the entry ticks
         rather than under them. */
      .j-timeline--big .j-tl-year::before {
        width: 14px;
        height: 2px;
        background: var(--cat-updates);
        opacity: 1;
      }

      /* ---------------- Updates view ---------------- */
      .j-updates {
        max-width: 680px;
      }

      /* Subject strip over the Essays list. Same layout as .j-nb-side; the
         pills themselves are .j-topic, so they inherit that idiom wholesale and
         only the selected colour changes register. */
      .j-es-side {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.45rem;
        margin-bottom: 1.5rem;
      }
      .j-es-side .j-topic:hover {
        color: var(--cat-essays);
        border-color: var(--cat-essays);
      }
      .j-es-side .j-topic.active {
        border-color: var(--cat-essays);
        background: color-mix(in srgb, var(--cat-essays) 14%, transparent);
      }
      @media (max-width: 600px) {
        /* Scrolls sideways rather than stacking, so it never pushes the first
           essay off the fold. Bleeds to the viewport edges so the last pill
           doesn't look clipped mid-gutter. */
        .j-es-side {
          flex-wrap: nowrap;
          overflow-x: auto;
          margin: 0 -1rem 1.25rem;
          padding: 0 1rem 0.25rem;
          scrollbar-width: none;
        }
        .j-es-side::-webkit-scrollbar {
          display: none;
        }
      }

      /* Shown when a register has nothing published — otherwise a confident
         hero sits above blank space and reads as broken rather than empty. The
         register pills stay visible above, so the way out is already on screen
         and this doesn't need to offer one. */
      .j-empty {
        color: var(--color-text-muted);
        font-style: italic;
        margin: 2.25rem 0 3rem;
      }

      /* ---------------- Essays view ---------------- */
      .j-essays {
        max-width: 720px;
      }

      /* ---------------- Notebook view ---------------- */
      .j-nb {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.4rem;
      }
      /* One control at every width — no sidebar branch. See the markup comment
         for why this is a strip rather than a rail. */
      .j-nb-side {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.45rem;
      }
      .j-side-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--color-text-muted);
        margin-right: 0.35rem;
      }
      /* The site's pill recipe (cf. .j-filter here and .proj-filter on Projects),
         one step down: sentence case at 0.85rem/500 against the register pills'
         uppercase 0.8rem/700. The CASE change is what makes it read as
         subordinate, so the topics don't compete with the registers above. */
      .j-topic {
        flex: 0 0 auto;
        /* inline-block, NOT inline-flex. Two reasons, and they're linked:
           1. Flex drops whitespace-only anonymous items, so the space between
              the label and the count vanishes and has to be re-added as `gap`.
           2. The ::after phantom below reserves the pill's bold width from
              attr(data-label) — a single text run. It can only match the real
              content exactly if that content is also one text run with a real
              space in it, not two flex items separated by a gap.
           As a block-level child of an inline-block, the phantom contributes
           its width to the shrink-to-fit box while taking no height. */
        display: inline-block;
        background: transparent;
        border: 1px solid var(--color-border);
        border-radius: 999px;
        padding: 0.3rem 0.85rem;
        font-family: inherit;
        font-size: 0.85rem;
        font-weight: 500;
        line-height: 1.4;
        color: var(--color-text-muted);
        cursor: pointer;
        white-space: nowrap;
        text-decoration: none;
        transition:
          color 0.2s ease,
          border-color 0.2s ease,
          background-color 0.2s ease;
      }
      /* Reserves the ACTIVE (600) width at every weight, so selecting a pill
         no longer resizes it. A hidden copy of the same characters at the bold
         weight sets the shrink-to-fit width; the visible text — lighter, so
         narrower — then never exceeds it. height:0 + overflow:hidden keeps it
         off-screen without display:none, which would remove it from layout and
         defeat the whole point. */
      .j-topic::after {
        content: attr(data-label);
        display: block;
        height: 0;
        overflow: hidden;
        visibility: hidden;
        font-weight: 600;
        /* MUST match .j-topic span, or the phantom reserves a PROPORTIONAL
           digit while the real count renders a TABULAR one. In Atkinson the
           two differ most for "1", which measured 2.5px of leftover jitter on
           the single-note topics while "4" and "2" barely moved. */
        font-variant-numeric: tabular-nums;
        pointer-events: none;
      }
      /* The ask pill never activates, so it has no bold state to reserve. */
      .j-topic--ask::after {
        content: none;
      }
      .j-topic span {
        font-variant-numeric: tabular-nums;
        opacity: 0.6;
      }
      .j-topic:hover {
        color: var(--cat-notebook);
        border-color: var(--cat-notebook);
      }
      /* Selected: the register's amber on the BORDER over a faint wash, NOT a
         solid fill. A solid amber pill would read as a second register pill
         40px under the real one, and white on --cat-notebook measures ~3.2:1 at
         this size (under AA). Keeping --color-text-main as the ink puts it near
         14:1 in both themes, and the border still carries the register color.
         color-mix against `transparent` (not --color-bg) so the wash rides over
         whatever is behind it, including the glow field. */
      .j-topic.active {
        border-color: var(--cat-notebook);
        background: color-mix(in srgb, var(--cat-notebook) 14%, transparent);
        color: var(--color-text-main);
        font-weight: 600;
      }
      .j-topic.active span {
        opacity: 0.75;
      }
      /* The topic that doesn't exist yet: dashed where the real topics are
         solid. Cancels the global a:hover opacity fade — the color lift is the
         only intended cue. */
      .j-topic--ask {
        border-style: dashed;
      }
      .j-topic--ask:hover {
        opacity: 1;
        text-decoration: none;
      }
      .j-ask-plus {
        font-weight: 600;
        opacity: 0.75;
      }
      .j-nb-group-head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        /* Topic headers run full-width as section dividers — the entries below
           stay aligned, but the grouping band spans the whole column. */
        padding: 1.5rem 0 0.5rem;
        border-bottom: 1px solid var(--color-border);
        margin-bottom: 0.25rem;
        transition: border-color 0.3s ease;
      }
      .j-nb-group:first-child .j-nb-group-head {
        padding-top: 0;
      }
      .j-nb-group-name {
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--color-text-muted);
        /* Undo the global h2: serif face, 2rem, its own margins and the hot
           rule-mark under it. This is a label that happens to be a heading. */
        font-family: inherit;
        line-height: inherit;
        margin: 0;
      }
      .j-nb-group-name::after {
        content: none;
      }
      .j-nb-group-count {
        font-variant-numeric: tabular-nums;
        font-size: 0.8rem;
        color: var(--color-text-muted);
        opacity: 0.6;
        /* Matches .j-shelf-count so both header kinds space their count the
           same way. Not inheriting the name's letter-spacing, which is set for
           uppercase words and looks loose on a lone digit. */
        margin-left: 0.45rem;
        letter-spacing: 0;
      }
      /* The topic name carries the marker color; the count stays muted. */
      .j-nb[data-marker] .j-nb-group-name .j-nb-group-count {
        color: var(--color-text-muted);
      }

      /* ---------------- Margin markers (VARIANTS — keep one) ----------------
         Essays mark every row (subject dot + eyebrow) and Updates mark every
         entry (dot on a spine); the Notebook marked nothing, so it read flat
         next to them. Each variant below restores a left-margin mark; they are
         switched with data-marker on .j-nb so they can be compared side by
         side. All three also colour the group name, which is the cheapest way
         to get persistent register colour below the fold. */
      /* The gutter lives on the GRID CONTAINER, not on .j-nb-main, so the topic
         strip and the list indent together — putting it on main alone left the
         "Topics" label 19px to the left of the group names it sits above, which
         is the same misalignment the old sidebar had. Markers then hang at
         exactly the column's left edge via calc(-1 * gutter). */
      .j-nb {
        --j-nb-gutter: 0rem;
        padding-left: var(--j-nb-gutter);
      }
      .j-nb[data-marker] {
        --j-nb-gutter: 1.15rem;
      }
      /* Matches .j-views. A topic switch fades this alone (see fadeApply), so
         the strip that triggered it stays put. */
      .j-nb-main {
        transition: opacity 0.16s ease;
      }
      .j-nb[data-marker] .j-nb-group-name {
        color: var(--cat-notebook);
        position: relative;
      }

      /* A — TAB: a tick crossing into the margin at the group label, echoing
         .j-tl-year::before on the Updates timeline. Marks the FILING, which is
         what the Notebook is organised by. */
      .j-nb[data-marker="tab"] .j-nb-group-name::before {
        content: "";
        position: absolute;
        left: calc(-1 * var(--j-nb-gutter));
        top: 50%;
        transform: translateY(-50%);
        width: 8px;
        height: 2px;
        border-radius: 1px;
        background: var(--cat-notebook);
      }

      /* B — RULE: a short amber hairline down each topic group. Reads as a
         tabbed divider, and the per-group segmentation distinguishes it from
         the Updates spine (one continuous blue line, dotted, spanning the
         whole view). */
      .j-nb[data-marker="rule"] .j-nb-group {
        position: relative;
      }
      .j-nb[data-marker="rule"] .j-nb-group::before {
        content: "";
        position: absolute;
        left: calc(-1 * var(--j-nb-gutter));
        top: 1.65rem;
        bottom: 1.05rem;
        width: 2px;
        border-radius: 2px;
        background: var(--cat-notebook);
        opacity: 0.45;
      }
      .j-nb[data-marker="rule"] .j-nb-group:first-child::before {
        top: 0.15rem;
      }

      /* C — DOT: one amber dot per note, at Essays parity. .j-note is already
         position:relative (JournalNoteRow), so this anchors to the row. */
      .j-nb[data-marker="dot"] :global(.j-nb-group .j-note::before) {
        content: "";
        position: absolute;
        left: calc(-1 * var(--j-nb-gutter));
        top: 1.75em;
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--cat-notebook);
      }

      /* ---------------- Responsive ---------------- */
      @media (max-width: 900px) {
        /* The rail stops being a margin and becomes the last band of the front
           page: full width, under the notebook shelf. */
        .j-front {
          grid-template-columns: 1fr;
          gap: 2.6rem;
        }
        .j-rail {
          position: static;
        }
      }
      @media (max-width: 600px) {
        #j-title {
          font-size: 2.2rem;
        }
        /* No separator on mobile, and a tighter gap below the bar. */
        .j-filters-bar {
          margin-bottom: 1.25rem;
        }
        .j-filters-bar::after {
          display: none;
        }
        /* On mobile there isn't room for the full row, so drop the "All" button
           and its divider entirely — users return to All by clicking the active
           register pill again. The three register pills then wrap cleanly. */
        .j-filter--text,
        .j-filter-divider {
          display: none;
        }
        .j-nb {
          gap: 1.25rem;
        }
        /* SMALL screens: the topics row scrolls horizontally instead of wrapping,
           so a long topic list stays a single tidy row. Bleed to the screen edges
           (main's 1rem gutter) for a clear "more to scroll" affordance. */
        /* Bleed the SCROLL CONTAINER to both screen edges while keeping the
           first pill on the list's indent — so the marker gutter doesn't push
           the strip out of alignment or eat into the bleed affordance. */
        .j-nb-side {
          flex-wrap: nowrap;
          overflow-x: auto;
          margin: 0 -1rem 0 calc(-1rem - var(--j-nb-gutter));
          padding: 0 1rem 0.25rem calc(1rem + var(--j-nb-gutter));
          scrollbar-width: none;
        }
        .j-nb-side::-webkit-scrollbar {
          display: none;
        }
        /* Hide the "Topics" label on the narrowest screens to save room. */
        .j-side-label {
          display: none;
        }
      }
    </style>
  </body>
</html>
